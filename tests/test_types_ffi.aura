; P3.16 typed FFI smoke: HASH/LIST/ZSET/TYPE/WRONGTYPE via thin public API
; Style mirrors tests/test_ffi_iter1.aura — avoid user procs after many c-func binds
; (Aura rev: post-c-func closures can go inert). Bind FFI Strings before string=?.
(require "std/ffi" all:)

(define so (let ((e (getenv "AURA_REDIS_CORE_SO")))
             (if (and (string? e) (> (string-length e) 0)) e
                 "native/build/libaura_redis_core.so")))

(define ok 1)
(define lib (c-load so))
(define create (c-func lib "ar_core_create" "() -> Opaque"))
(if (not (procedure? create)) (begin (display "FAIL c-load/c-func create\n") (set! ok 0)) #t)

(define destroy (c-func lib "ar_core_destroy" "(Opaque) -> Void"))
(define aset (c-func lib "ar_set" "(Opaque String String) -> Int"))
(define atype (c-func lib "ar_type" "(Opaque String) -> String"))
(define ahset (c-func lib "ar_hset" "(Opaque String String String Opaque) -> Int"))
(define ahget (c-func lib "ar_hget" "(Opaque String String Opaque) -> String"))
(define ahdel (c-func lib "ar_hdel" "(Opaque String String Opaque) -> Int"))
(define ahexists (c-func lib "ar_hexists" "(Opaque String String Opaque) -> Int"))
(define ahlen (c-func lib "ar_hlen" "(Opaque String Opaque) -> Int"))
(define ahincrby (c-func lib "ar_hincrby" "(Opaque String String Int Opaque Opaque) -> Int"))
(define alpush (c-func lib "ar_lpush" "(Opaque String String Opaque) -> Int"))
(define arpush (c-func lib "ar_rpush" "(Opaque String String Opaque) -> Int"))
(define alpop (c-func lib "ar_lpop" "(Opaque String Opaque) -> String"))
(define arpop (c-func lib "ar_rpop" "(Opaque String Opaque) -> String"))
(define allen (c-func lib "ar_llen" "(Opaque String Opaque) -> Int"))
(define alindex (c-func lib "ar_lindex" "(Opaque String Int Opaque) -> String"))
(define azadd (c-func lib "ar_zadd" "(Opaque String Int String Opaque) -> Int"))
(define azscore (c-func lib "ar_zscore" "(Opaque String String Opaque Opaque) -> String"))
(define azrem (c-func lib "ar_zrem" "(Opaque String String Opaque) -> Int"))
(define azcard (c-func lib "ar_zcard" "(Opaque String Opaque) -> Int"))

(define core (create))
(if (not (c-opaque? core)) (begin (display "FAIL create\n") (set! ok 0)) #t)

(define wt (c-alloc 8))
(define okf (c-alloc 8))

(define t0 (atype core "missing"))
(if (and (string? t0) (string=? t0 "none")) #t (begin (display "FAIL type-none\n") (set! ok 0)))

(c-struct-set! wt 0 0)
(if (not (= (ahset core "h" "a" "1" wt) 1)) (begin (display "FAIL hset-add\n") (set! ok 0)) #t)
(if (not (= (c-struct-ref wt 0 0) 0)) (begin (display "FAIL hset-wt0\n") (set! ok 0)) #t)
(if (not (= (ahset core "h" "a" "2" wt) 0)) (begin (display "FAIL hset-upd\n") (set! ok 0)) #t)
(define th (atype core "h"))
(if (and (string? th) (string=? th "hash")) #t (begin (display "FAIL type-hash\n") (set! ok 0)))
(define hv (ahget core "h" "a" wt))
(if (and (string? hv) (string=? hv "2")) #t (begin (display "FAIL hget\n") (set! ok 0)))
(if (not (= (ahexists core "h" "a" wt) 1)) (begin (display "FAIL hexists\n") (set! ok 0)) #t)
(if (not (= (ahlen core "h" wt) 1)) (begin (display "FAIL hlen\n") (set! ok 0)) #t)
(c-struct-set! okf 0 0)
(if (not (= (ahincrby core "h" "a" 5 wt okf) 7)) (begin (display "FAIL hincrby\n") (set! ok 0)) #t)
(if (not (= (c-struct-ref okf 0 0) 1)) (begin (display "FAIL hincrby-ok\n") (set! ok 0)) #t)
(if (not (= (ahdel core "h" "a" wt) 1)) (begin (display "FAIL hdel\n") (set! ok 0)) #t)
(define th2 (atype core "h"))
(if (and (string? th2) (string=? th2 "none")) #t (begin (display "FAIL hash-gone\n") (set! ok 0)))

(c-struct-set! wt 0 0)
(if (not (= (alpush core "L" "b" wt) 1)) (begin (display "FAIL lpush\n") (set! ok 0)) #t)
(if (not (= (arpush core "L" "c" wt) 2)) (begin (display "FAIL rpush\n") (set! ok 0)) #t)
(if (not (= (allen core "L" wt) 2)) (begin (display "FAIL llen\n") (set! ok 0)) #t)
(define li (alindex core "L" 0 wt))
(if (and (string? li) (string=? li "b")) #t (begin (display "FAIL lindex\n") (set! ok 0)))
(define tL (atype core "L"))
(if (and (string? tL) (string=? tL "list")) #t (begin (display "FAIL type-list\n") (set! ok 0)))
(define lp (alpop core "L" wt))
(if (and (string? lp) (string=? lp "b")) #t (begin (display "FAIL lpop\n") (set! ok 0)))
(define rp (arpop core "L" wt))
(if (and (string? rp) (string=? rp "c")) #t (begin (display "FAIL rpop\n") (set! ok 0)))

(c-struct-set! wt 0 0)
(if (not (= (azadd core "z" 10 "m1" wt) 1)) (begin (display "FAIL zadd\n") (set! ok 0)) #t)
(if (not (= (azadd core "z" 20 "m2" wt) 1)) (begin (display "FAIL zadd2\n") (set! ok 0)) #t)
(if (not (= (azcard core "z" wt) 2)) (begin (display "FAIL zcard\n") (set! ok 0)) #t)
(define tz (atype core "z"))
(if (and (string? tz) (string=? tz "zset")) #t (begin (display "FAIL type-zset\n") (set! ok 0)))
(c-struct-set! okf 0 0)
(define zs (azscore core "z" "m1" okf wt))
(if (not (= (c-struct-ref okf 0 0) 1)) (begin (display "FAIL zscore-ok\n") (set! ok 0)) #t)
(if (and (string? zs) (string=? zs "10")) #t (begin (display "FAIL zscore\n") (set! ok 0)))
(if (not (= (azrem core "z" "m1" wt) 1)) (begin (display "FAIL zrem\n") (set! ok 0)) #t)
(if (not (= (azcard core "z" wt) 1)) (begin (display "FAIL zcard-after\n") (set! ok 0)) #t)

(if (not (= (aset core "s" "x") 1)) (begin (display "FAIL set-str\n") (set! ok 0)) #t)
(define ts (atype core "s"))
(if (and (string? ts) (string=? ts "string")) #t (begin (display "FAIL type-string\n") (set! ok 0)))
(c-struct-set! wt 0 0)
(if (not (= (ahset core "s" "f" "v" wt) -1)) (begin (display "FAIL hset-wrongtype-ret\n") (set! ok 0)) #t)
(if (not (= (c-struct-ref wt 0 0) 1)) (begin (display "FAIL hset-wrongtype-flag\n") (set! ok 0)) #t)
(c-struct-set! wt 0 0)
(define bad (ahget core "s" "f" wt))
(if (not (= (c-struct-ref wt 0 0) 1)) (begin (display "FAIL hget-wrongtype\n") (set! ok 0)) #t)
(c-struct-set! wt 0 0)
(if (not (= (alpush core "s" "x" wt) -1)) (begin (display "FAIL lpush-wrongtype\n") (set! ok 0)) #t)
(if (not (= (c-struct-ref wt 0 0) 1)) (begin (display "FAIL lpush-wrongtype-flag\n") (set! ok 0)) #t)
(c-struct-set! wt 0 0)
(if (not (= (azadd core "s" 1 "m" wt) -1)) (begin (display "FAIL zadd-wrongtype\n") (set! ok 0)) #t)
(if (not (= (c-struct-ref wt 0 0) 1)) (begin (display "FAIL zadd-wrongtype-flag\n") (set! ok 0)) #t)

(c-free wt)
(c-free okf)
(destroy core)

(if (= ok 1)
  (display "test_types_ffi: OK\n")
  (display "test_types_ffi: FAILED\n"))
