; server.aura — aura-redis TCP server entry (RESP2 over loopback)
;
; Usage (from repo root, after building Aura):
;   AURA_SANDBOX=off AURA_PIPELINE_STRICT=0 AURA_PATH=.deps/aura/lib \
;     AURA_REDIS_PORT=6379 ./.deps/aura/build/aura src/redis/server.aura
;
; Port comes from AURA_REDIS_PORT (Aura CLI treats bare args as program files).
; Set AURA_REDIS_SYNC=1 to force sequential accept→serve (no fiber:spawn).
;
; Limitations (v0):
;   - tcp-listen binds 127.0.0.1 only (Aura std/socket)
;   - in-memory store is shared across clients (no mutex; fine for demo)
;   - no AUTH / persistence / pubsub / cluster

(require "std/socket" all:)
(require "src/redis/resp" all:)
(require "src/redis/commands" all:)

(define (default-port)
  (let ((env (getenv "AURA_REDIS_PORT")))
    (if (and (string? env) (number? (string->number env)))
      (string->number env)
      6379)))

(define (sync-clients?)
  (let ((env (getenv "AURA_REDIS_SYNC")))
    (and (string? env)
         (or (string=? env "1")
             (string=? env "true")
             (string=? env "yes")))))

(define (buf-append a b)
  (string-append a b))

; Join list of strings (iterative).
(define (join-strs xs)
  (let ((out "")
        (cur xs))
    (while (lambda () (pair? cur))
      (lambda ()
        (set! out (string-append out (car cur)))
        (set! cur (cdr cur))))
    out))

; Process as many complete RESP messages as possible from buffer.
; Uses an index walk (no per-command substring of the remainder) and
; accumulates replies for ONE tcp-send per recv burst.
; Returns (list remaining-buffer should-quit)
(define (process-buffer sock buf)
  (let ((done #f)
        (quit #f)
        (pos 0)
        (n (string-length buf))
        (reply-parts (list)))
    (while (lambda () (not done))
      (lambda ()
        (if (>= pos n)
          (set! done #t)
          (let ((r (resp-try-parse buf pos)))
            (if (not r)
              (set! done #t)
              (let ((next (car r))
                    (val (car (cdr r)))
                    (args (list))
                    (reply ""))
                (set! args (resp-cmd-args val))
                (set! reply (cmd-dispatch args))
                (set! reply-parts (cons reply reply-parts))
                (set! pos next)
                (if (and (pair? args)
                         (string=? (ascii-upcase (car args)) "QUIT"))
                  (begin (set! quit #t) (set! done #t)))))))))
    (if (pair? reply-parts)
      (tcp-send sock (join-strs (reverse reply-parts))))
    (list (if (>= pos n) "" (substring buf pos n)) quit)))

(define (serve-client sock)
  (let ((buf "")
        (alive #t))
    (while (lambda () alive)
      (lambda ()
        (let ((chunk (tcp-recv sock 65536)))
          (cond
            ((not (string? chunk))
             (set! alive #f))
            ((= (string-length chunk) 0)
             (set! alive #f))
            (else
             (set! buf (buf-append buf chunk))
             (let ((r (process-buffer sock buf)))
               (set! buf (car r))
               (if (car (cdr r))
                 (set! alive #f))))))))
    (tcp-close sock)
    #t))

; Fire-and-forget client fiber; fall back to sync if spawn fails.
(define (dispatch-client sock)
  (if (sync-clients?)
    (serve-client sock)
    (let ((fid (fiber:spawn (lambda () (serve-client sock)))))
      (if (and (integer? fid) (> fid 0))
        #t
        (begin
          (display "aura-redis: fiber:spawn failed; serving sync (set AURA_REDIS_SYNC=1 to silence)\n")
          (serve-client sock))))))

(define (server-loop port)
  (let ((L (tcp-listen port))
        (mode (if (sync-clients?) "sequential" "fiber-per-client")))
    (if (not (integer? L))
      (begin
        (display "aura-redis: tcp-listen failed (need AURA_SANDBOX=off?)\n")
        1)
      (begin
        (display "aura-redis listening on 127.0.0.1:")
        (display (tcp-local-port L))
        (display " (loopback only; ")
        (display mode)
        (display ")\n")
        (let ((running #t))
          (while (lambda () running)
            (lambda ()
              (let ((c (tcp-accept L)))
                (if (integer? c)
                  (dispatch-client c)
                  (begin
                    (display "aura-redis: accept failed\n")
                    (set! running #f))))))
          (tcp-close L)
          0)))))

(define *exit* (server-loop (default-port)))
(display "aura-redis exit=")
(display *exit*)
(newline)
