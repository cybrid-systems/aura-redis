; choose_conservative — higher thresholds; layout stays flat unless pressure; M10 soft
(export *policy-choose-conservative*)

(define *policy-choose-conservative*
  "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl)
     (let ((ops (+ dgets dsets)))
       (if (< ops 120)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0))
               (miss-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dmisses) (+ dhits dmisses))
                           0))
               (erate (if (> ops 0)
                        (quotient (* 100 devicted) ops)
                        0)))
           (cond
             ((>= erate 25)
              (if (and (> keys_ttl 0) (< avg_ttl 8000))
                \"ttl_aware|flat|soft\"
                \"lru|flat|soft\"))
             ((and (> keys_ttl 30) (< avg_ttl 5000) (> devicted 0))
              \"ttl_aware|flat\")
             ((and (> dsets (* dgets 3)) (> miss-pct 55)) \"lfu|hot_cold\")
             ((> dsets (* dgets 3)) \"lfu\")
             ((and (> dgets (* dsets 8)) (>= hit-pct 75)) \"lru\")
             ((and (> devicted 20) (> nkeys 100)) \"lfu|hot_cold\")
             (else \"\"))))))")
