; choose_inverted — swap target for demo (write→lru, read→lfu); joint-capable
(export *policy-choose-inverted*)

(define *policy-choose-inverted*
  "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl)
     (let ((ops (+ dgets dsets)))
       (if (< ops 40)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0)))
           (cond
             ((> dsets (* dgets 2)) \"lru|flat\")
             ((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lfu|hot_cold\")
             (else \"\"))))))")
