; choose_defensive — A19 poison/unique-SET storm body: LFU-oriented + refuse pin + soft
; Keep* scoreboard under unique-SET flood: frequency protects seeded keep keys;
; LRU would favor poison SETs (recency) and wipe keep*. Soft = no |pin aggression.
(export *policy-choose-defensive*)

(define *policy-choose-defensive*
  "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl)
     (let ((ops (+ dgets dsets)))
       (if (< ops 20)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dhits) (+ dhits dmisses))
                           0)))
           ; A read-heavy working set is not a unique-SET flood. Recency
           ; (LRU, no pin) keeps the keys just written and then read, so
           ; phase_marathon ws_shift can leave LFU. Write-only floods stay
           ; on LFU + soft and never emit |pin.
           (if (and (>= dgets 40) (> dgets dsets) (>= hit-pct 45))
             \"lru|flat\"
             \"lfu|flat|soft\")))))
")
