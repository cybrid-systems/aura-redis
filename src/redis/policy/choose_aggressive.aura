; choose_aggressive — faster flips, pin sooner on miss spikes (MVP M1); M9 TTL; M10 soft
(export *policy-choose-aggressive*)

(define *policy-choose-aggressive*
  "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl)
     (let ((ops (+ dgets dsets)))
       (if (< ops 25)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0))
               (miss-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dmisses) (+ dhits dmisses))
                           0))
               (ttl-share (if (> nkeys 0)
                            (quotient (* 100 keys_ttl) nkeys)
                            0))
               (erate (if (> ops 0)
                        (quotient (* 100 devicted) ops)
                        0)))
           (cond
             ; M10 soft-goal (aggressive: budget 18 / extreme 45)
             ((>= erate 18)
              (if (and (> keys_ttl 0) (< avg_ttl 12000))
                \"ttl_aware|flat|soft\"
                \"lru|flat|soft\"))
             ((and (> keys_ttl 0) (< avg_ttl 12000)
                   (or (>= ttl-share 15) (> keys_ttl 10)))
              \"ttl_aware|flat\")
             ((or (and (>= dsets dgets) (> miss-pct 20))
                  (and (> miss-pct 25) (> nkeys 0)))
              (if (or (> miss-pct 28) (> devicted 2))
                \"lfu|flat|pin\"
                \"lfu|flat\"))
             ((> dsets (* dgets 1)) \"lfu|flat\")
             ((and (> dgets (* dsets 2)) (>= hit-pct 45)) \"lru|flat\")
             ((and (> dgets dsets) (< hit-pct 50) (> miss-pct 20))
              \"lru|flat\")
             ((> nkeys 0) \"\")
             (else \"\"))))))")
