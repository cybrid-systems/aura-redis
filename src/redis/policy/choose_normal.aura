; choose_normal — multi-signal joint EVICT+LAYOUT choose-fn body (MVP M1/M2)
; Contract: (lambda (dgets dsets dhits dmisses devicted nkeys) …)
;   → "" | "lfu" | "lru" | "lfu|hot_cold" | "lru|flat" | "…|pin"
(export *policy-choose-normal*)

(define *policy-choose-normal*
  "(lambda (dgets dsets dhits dmisses devicted nkeys)
     (let ((ops (+ dgets dsets)))
       (if (< ops 80)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0))
               (miss-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dmisses) (+ dhits dmisses))
                           0)))
           (cond
             ((and (> dsets (* dgets 2)) (> miss-pct 40) (> nkeys 0))
              \"lfu|hot_cold|pin\")
             ((> dsets (* dgets 2)) \"lfu|hot_cold\")
             ((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lru|flat\")
             ((and (> devicted 0) (> miss-pct 50)) \"lfu|hot_cold\")
             (else \"\"))))))")
