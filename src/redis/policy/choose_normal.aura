; choose_normal — multi-signal joint EVICT+LAYOUT choose-fn body (MVP M1/M2)
; Contract: (lambda (dgets dsets dhits dmisses devicted nkeys) …)
;   → "" | "lfu" | "lru" | "lfu|flat" | "lru|flat" | "lfu|flat|pin" | …
; Faster phase detect (min-ops 40). Cold-flood/miss spike → lfu+pin on flat
; (avoid layout migrate during pin-protect). WS shift → lru|flat (controller UNPINs).
(export *policy-choose-normal*)

(define *policy-choose-normal*
  "(lambda (dgets dsets dhits dmisses devicted nkeys)
     (let ((ops (+ dgets dsets)))
       (if (< ops 40)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0))
               (miss-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dmisses) (+ dhits dmisses))
                           0)))
           (cond
             ; cold-flood / miss spike while write-ish → lfu + pin (flat: no migrate hurt)
             ((and (>= dsets dgets) (> miss-pct 30) (> nkeys 0))
              \"lfu|flat|pin\")
             ; classic write-heavy → lfu (+ hot_cold when not pinning)
             ((> dsets (* dgets 2)) \"lfu|flat\")
             ; eviction pressure + miss spike → protect with lfu+pin
             ((and (> devicted 0) (> miss-pct 40)) \"lfu|flat|pin\")
             ; WS shift: read-heavy → lru fast (unpin stale via controller)
             ((and (> dgets (* dsets 3)) (>= hit-pct 50)) \"lru|flat\")
             ; read-ish + hit drop under pressure → flip to lru
             ((and (> dgets (* dsets 2)) (< hit-pct 55) (> miss-pct 15))
              \"lru|flat\")
             ((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lru|flat\")
             (else \"\"))))))")
