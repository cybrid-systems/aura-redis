; choose_normal — multi-signal joint EVICT+LAYOUT choose-fn body (MVP M1/M2 + M9 + M10)
; Contract: (lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) …)
;   → "" | "lfu" | "lru" | "ttl_aware" | "noop" | "lfu|flat|pin" | "ttl_aware|flat" | …
; Signals (M9 TTL):
;   dexpired  — delta INFO expired (lazy expire activity)
;   avg_ttl   — INFO avg_ttl_ms (remaining TTL proxy among keys with expire)
;   keys_ttl  — INFO keys_with_ttl
; Soft-goal (M10) — maximize hit% subject to eviction CPU budget:
;   evict_rate_pct = (devicted * 100) / ops   (proxy for eviction CPU / thrash)
;   Soft budget SOFT_BUDGET=20: if rate ≥ 20, refuse expensive lfu|+pin thrash.
;   Prefer ttl_aware when TTL pressure, else lru|flat; if rate ≥ 50 → noop|flat
;   (stop eviction burn under maxmemory thrash). Soft gate is FIRST after min-ops.
(export *policy-choose-normal*)

(define *policy-choose-normal*
  "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl)
     (let ((ops (+ dgets dsets)))
       (if (< ops 40)
         \"\"
         (let ((hit-pct (if (> (+ dhits dmisses) 0)
                          (quotient (* 100 dhits) (+ dhits dmisses))
                          0))
               (miss-pct (if (> (+ dhits dmisses) 0)
                           (quotient (* 100 dmisses) (+ dhits dmisses))
                           0))
               (ttl-share (if (> nkeys 0)
                            (quotient (* 100 keys_ttl) nkeys)
                            0))
               (erate (if (> ops 0)
                        (quotient (* 100 devicted) ops)
                        0)))
           (cond
             ; M10 soft-goal: refuse expensive kernels over eviction budget
             ((>= erate 20)
              (if (and (> keys_ttl 0) (< avg_ttl 12000))
                \"ttl_aware|flat|soft\"
                \"lru|flat|soft\"))
             ((and (> keys_ttl 0)
                   (< avg_ttl 12000)
                   (or (>= ttl-share 20) (> keys_ttl 15)))
              \"ttl_aware|flat\")
             ((and (>= dsets dgets) (> miss-pct 30) (> nkeys 0))
              \"lfu|flat|pin\")
             ((> dsets (* dgets 2)) \"lfu|flat\")
             ((and (> devicted 0) (> miss-pct 40)) \"lfu|flat|pin\")
             ((and (> dgets (* dsets 3)) (>= hit-pct 50)) \"lru|flat\")
             ((and (> dgets (* dsets 2)) (< hit-pct 55) (> miss-pct 15))
              \"lru|flat\")
             ((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lru|flat\")
             (else \"\"))))))")
