; store.aura — in-memory Redis-like store for aura-redis v0
; (require "src/redis/store" all:)
;
; Entry shape (hash):
;   "t"  → "string" | "list" | "hash"
;   "v"  → string | nested hash (list elements are not stored in "v")
;   list: "L" left spine (car is the left end), "R" right spine (car is the
;         right end), "n" element count. Logical order is L ++ reverse(R).
;         A push is one cons. A pop on an empty spine reverses the other
;         spine once; it does not reverse twice. LLEN reads "n".
;   "ex" → expire deadline ms (0 = none)
;
; TTL is lazy per-key: hot-path ops call store-touch! (drop that key only
; if expired). store-purge! remains for KEYS / DBSIZE / FLUSH-adjacent use.

(export store-new
        store-alive?
        store-touch!
        store-purge!
        store-get
        store-set-string!
        store-del!
        store-exists?
        store-keys
        store-dbsize
        store-flush!
        store-type
        store-ttl
        store-expire!
        store-incr!
        store-append!
        store-strlen
        store-getset!
        store-rename!
        store-list-push!
        store-list-pop!
        store-list-len
        store-hash-set!
        store-hash-get
        store-hash-del!
        store-hash-getall)

(define (store-new)
  (hash))

(define (store-alive? entry now)
  (let ((ex (hash-ref entry "ex" 0)))
    (or (= ex 0) (> ex now))))

; Drop key if expired; return live entry or #f. O(1) hot path.
; If ex==0 (no TTL), skip current-time-ms entirely.
(define (store-touch! db key)
  (let ((e (hash-ref db key #f)))
    (if (not e)
      #f
      (let ((ex (hash-ref e "ex" 0)))
        (if (= ex 0)
          e
          (if (> ex (current-time-ms))
            e
            (begin
              (hash-remove! db key)
              #f)))))))

; Full scan — use for KEYS / DBSIZE / periodic maintenance, not hot path.
(define (store-purge! db)
  (let ((now (current-time-ms))
        (ks (hash-keys db)))
    (while (lambda () (pair? ks))
      (lambda ()
        (let ((k (car ks))
              (e (hash-ref db k #f)))
          (if (and e (not (store-alive? e now)))
            (hash-remove! db k))
          (set! ks (cdr ks)))))
    db))

(define (store-get db key)
  (store-touch! db key))

; Mutate in place when key already has a string entry (avoid alloc every SET).
(define (store-set-string! db key val ex-ms)
  (let ((ex (if (and (number? ex-ms) (> ex-ms 0)) ex-ms 0))
        (e (hash-ref db key #f)))
    (if (and e (string=? (hash-ref e "t" "") "string"))
      (begin
        (hash-set! e "v" val)
        (hash-set! e "ex" ex)
        #t)
      (let ((entry (hash)))
        (hash-set! entry "t" "string")
        (hash-set! entry "v" val)
        (hash-set! entry "ex" ex)
        (hash-set! db key entry)
        #t))))

(define (store-del! db keys)
  (let ((n 0)
        (ks keys))
    (while (lambda () (pair? ks))
      (lambda ()
        ; Touch so expired keys count as absent (Redis: DEL on expired = 0)
        (if (store-touch! db (car ks))
          (begin
            (hash-remove! db (car ks))
            (set! n (+ n 1))))
        (set! ks (cdr ks))))
    n))

(define (store-exists? db keys)
  (let ((n 0)
        (ks keys))
    (while (lambda () (pair? ks))
      (lambda ()
        (if (store-touch! db (car ks))
          (set! n (+ n 1)))
        (set! ks (cdr ks))))
    n))

(define (store-keys db)
  (store-purge! db)
  (hash-keys db))

(define (store-dbsize db)
  (store-purge! db)
  (hash-length db))

(define (store-flush! db)
  (let ((ks (hash-keys db)))
    (while (lambda () (pair? ks))
      (lambda ()
        (hash-remove! db (car ks))
        (set! ks (cdr ks))))
    #t))

(define (store-type db key)
  (let ((e (store-get db key)))
    (if (not e)
      "none"
      (hash-ref e "t" "none"))))

(define (store-ttl db key)
  (let ((e (store-get db key)))
    (if (not e)
      -2
      (let ((ex (hash-ref e "ex" 0)))
        (if (= ex 0)
          -1
          (let ((left (quotient (- ex (current-time-ms)) 1000)))
            (if (< left 0) -2 left)))))))

(define (store-expire! db key seconds)
  (let ((e (store-get db key)))
    (if (not e)
      0
      (begin
        (hash-set! e "ex" (+ (current-time-ms) (* seconds 1000)))
        (hash-set! db key e)
        1))))

(define (store-incr! db key delta)
  (let ((e (store-touch! db key)))
    (if (not e)
      (begin
        (store-set-string! db key (number->string delta) 0)
        delta)
      (if (not (string=? (hash-ref e "t" "") "string"))
        #f
        (let ((cur (string->number (hash-ref e "v" "0"))))
          (if (not (number? cur))
            #f
            (let ((n (+ cur delta)))
              (hash-set! e "v" (number->string n))
              (hash-set! db key e)
              n)))))))

(define (store-append! db key val)
  (let ((e (store-touch! db key)))
    (if (not e)
      (begin
        (store-set-string! db key val 0)
        (string-length val))
      (if (not (string=? (hash-ref e "t" "") "string"))
        #f
        (let ((nv (string-append (hash-ref e "v" "") val)))
          (hash-set! e "v" nv)
          (hash-set! db key e)
          (string-length nv))))))

(define (store-strlen db key)
  (let ((e (store-touch! db key)))
    (cond
      ((not e) 0)
      ((not (string=? (hash-ref e "t" "") "string")) #f)
      (else (string-length (hash-ref e "v" ""))))))

; Returns (list ok old-or-null) — ok=#f means WRONGTYPE; old is string or #f
(define (store-getset! db key val)
  (let ((e (store-touch! db key)))
    (cond
      ((not e)
       (store-set-string! db key val 0)
       (list #t #f))
      ((not (string=? (hash-ref e "t" "") "string"))
       (list #f #f))
      (else
       (let ((old (hash-ref e "v" "")))
         (hash-set! e "v" val)
         ; keep existing expire
         (hash-set! db key e)
         (list #t old))))))

; Returns: "ok" | "missing" | "busy" (RENAMENX dst exists) | "same"
(define (store-rename! db src dst nx?)
  (if (string=? src dst)
    "same"
    (let ((e (store-touch! db src)))
      (if (not e)
        "missing"
        (begin
          (store-touch! db dst)
          (if (and nx? (hash-has-key? db dst))
            "busy"
            (begin
              (hash-set! db dst e)
              (hash-remove! db src)
              "ok")))))))

(define (store-ensure-list! db key)
  (let ((e (hash-ref db key #f)))
    (cond
      ((not e)
       (let ((entry (hash)))
         (hash-set! entry "t" "list")
         (hash-set! entry "L" (list))
         (hash-set! entry "R" (list))
         (hash-set! entry "n" 0)
         (hash-set! entry "ex" 0)
         (hash-set! db key entry)
         entry))
      ((string=? (hash-ref e "t" "") "list") e)
      (else #f))))

; One reverse, and only when the side we are about to pop is empty.
(define (list-move-to-left! e)
  (let ((r (hash-ref e "R" (list))))
    (if (null? r)
      #f
      (begin
        (hash-set! e "L" (reverse r))
        (hash-set! e "R" (list))
        #t))))

(define (list-move-to-right! e)
  (let ((l (hash-ref e "L" (list))))
    (if (null? l)
      #f
      (begin
        (hash-set! e "R" (reverse l))
        (hash-set! e "L" (list))
        #t))))

(define (store-list-push! db key val left?)
  (store-touch! db key)
  (let ((e (store-ensure-list! db key)))
    (if (not e)
      #f
      (begin
        (if left?
          (hash-set! e "L" (cons val (hash-ref e "L" (list))))
          (hash-set! e "R" (cons val (hash-ref e "R" (list)))))
        (hash-set! e "n" (+ (hash-ref e "n" 0) 1))
        (hash-set! db key e)
        (hash-ref e "n" 0)))))

(define (store-list-pop! db key left?)
  (let ((e (store-touch! db key)))
    (if (or (not e) (not (string=? (hash-ref e "t" "") "list")))
      #f
      (let ((n (hash-ref e "n" 0)))
        (if (<= n 0)
          #f
          (begin
            (if left?
              (if (null? (hash-ref e "L" (list)))
                (list-move-to-left! e))
              (if (null? (hash-ref e "R" (list)))
                (list-move-to-right! e)))
            (let ((side (if left? "L" "R"))
                  (xs (hash-ref e (if left? "L" "R") (list))))
              (if (null? xs)
                #f
                (let ((v (car xs))
                      (leftn (- n 1)))
                  (hash-set! e side (cdr xs))
                  (hash-set! e "n" leftn)
                  (if (<= leftn 0)
                    (hash-remove! db key)
                    (hash-set! db key e))
                  v)))))))))

(define (store-list-len db key)
  (let ((e (store-get db key)))
    (if (or (not e) (not (string=? (hash-ref e "t" "") "list")))
      0
      (hash-ref e "n" 0))))

(define (store-ensure-hash! db key)
  (let ((e (hash-ref db key #f)))
    (cond
      ((not e)
       (let ((entry (hash)))
         (hash-set! entry "t" "hash")
         (hash-set! entry "v" (hash))
         (hash-set! entry "ex" 0)
         (hash-set! db key entry)
         entry))
      ((string=? (hash-ref e "t" "") "hash") e)
      (else #f))))

(define (store-hash-set! db key field val)
  (store-touch! db key)
  (let ((e (store-ensure-hash! db key)))
    (if (not e)
      #f
      (let ((h (hash-ref e "v"))
            (created 0))
        (set! created (if (hash-has-key? h field) 0 1))
        (hash-set! h field val)
        (hash-set! e "v" h)
        (hash-set! db key e)
        created))))

(define (store-hash-get db key field)
  (let ((e (store-get db key)))
    (if (or (not e) (not (string=? (hash-ref e "t" "") "hash")))
      #f
      (hash-ref (hash-ref e "v") field #f))))

(define (store-hash-del! db key fields)
  (let ((e (store-get db key)))
    (if (or (not e) (not (string=? (hash-ref e "t" "") "hash")))
      0
      (let ((h (hash-ref e "v"))
            (n 0)
            (fs fields))
        (while (lambda () (pair? fs))
          (lambda ()
            (if (hash-has-key? h (car fs))
              (begin
                (hash-remove! h (car fs))
                (set! n (+ n 1))))
            (set! fs (cdr fs))))
        (hash-set! e "v" h)
        (if (= (hash-length h) 0)
          (hash-remove! db key)
          (hash-set! db key e))
        n))))

(define (store-hash-getall db key)
  (let ((e (store-get db key)))
    (if (or (not e) (not (string=? (hash-ref e "t" "") "hash")))
      (list)
      (let ((h (hash-ref e "v"))
            (ks (hash-keys (hash-ref e "v")))
            (out (list)))
        (while (lambda () (pair? ks))
          (lambda ()
            (set! out (cons (hash-ref h (car ks) "") out))
            (set! out (cons (car ks) out))
            (set! ks (cdr ks))))
        (reverse out)))))
