; ── tiny string helpers ──
(define (find-substr s pat start)
  (let ((n (string-length s))
        (m (string-length pat))
        (i start)
        (found -1))
    (while (and (< i n) (< found 0))
      (begin
        (if (and (<= (+ i m) n)
                 (string=? (substring s i (+ i m)) pat))
          (set! found i)
          (set! i (+ i 1)))))
    found))

(define (info-get text key)
  (let ((pat (string-append key ":"))
        (pos (find-substr text (string-append key ":") 0)))
    (if (< pos 0)
      ""
      (let ((start (+ pos (string-length pat)))
            (end (find-substr text "\n" (+ pos (string-length pat)))))
        (if (< end 0)
          (substring text start (string-length text))
          (substring text start end))))))

(define (info-num text key)
  (let ((v (string->number (info-get text key))))
    (if (number? v) v 0)))

(define (busy-wait-ms ms)
  (let ((t0 (monotonic-ms)))
    (while (< (- (monotonic-ms) t0) ms) 0)
    #t))

;; M12: parse "a:=session;b:=zipf" (prefix=profile) from INFO
(define (parse-policy-hints! hints)
  (set! *policy-hints* (if (string? hints) hints ""))
  (set! *pfx0* "")
  (set! *pfx1* "")
  (set! *prof0* "")
  (set! *prof1* "")
  (set! *prefix-policy-on* #f)
  (if (or (not (string? hints)) (= (string-length hints) 0))
    #f
    (let ((slot 0)
          (start 0)
          (n (string-length hints))
          (i 0))
      (while (<= i n)
        (if (or (= i n)
                (and (< i n) (string=? (substring hints i (+ i 1)) ";")))
          (begin
            (if (> i start)
              (let ((piece (substring hints start i)))
                (let ((peq (find-substr piece "=" 0)))
                  (if (>= peq 0)
                    (let ((px (substring piece 0 peq))
                          (pr (substring piece (+ peq 1) (string-length piece))))
                      (if (= slot 0)
                        (begin (set! *pfx0* px) (set! *prof0* pr))
                        (if (= slot 1)
                          (begin (set! *pfx1* px) (set! *prof1* pr))
                          #t))
                      (set! slot (+ slot 1))
                      (set! *prefix-policy-on* #t))
                    #t)))
              #t)
            (set! start (+ i 1))
            (set! i (+ i 1)))
          (set! i (+ i 1))))
      *prefix-policy-on*)))

(define (prefix-has-session?)
  (or (>= (find-substr *prof0* "session" 0) 0)
      (>= (find-substr *prof0* "ttl" 0) 0)
      (>= (find-substr *prof1* "session" 0) 0)
      (>= (find-substr *prof1* "ttl" 0) 0)))

(define (prefix-has-zipf?)
  (or (>= (find-substr *prof0* "zipf" 0) 0)
      (>= (find-substr *prof0* "hot" 0) 0)
      (>= (find-substr *prof1* "zipf" 0) 0)
      (>= (find-substr *prof1* "hot" 0) 0)))


; ── RESP client (encode array of bulk strings; parse simple/bulk/err) ──
(define (resp-encode-bulk s)
  (string-append "$" (number->string (string-length s)) "\r\n" s "\r\n"))

(define (resp-encode-cmd args)
  (let ((out (string-append "*" (number->string (length args)) "\r\n"))
        (xs args))
    (while (pair? xs)
      (begin
        (set! out (string-append out (resp-encode-bulk (car xs))))
        (set! xs (cdr xs))))
    out))

(define (resp-parse-one buf)
  ; returns (list consumed value) or #f if incomplete; value may be string / "OK" / error string prefixed ERR
  (if (or (not (string? buf)) (= (string-length buf) 0))
    #f
    (let ((t (substring buf 0 1)))
      (cond
        ((or (string=? t "+") (string=? t "-") (string=? t ":"))
         (let ((cr (find-substr buf "\r\n" 0)))
           (if (< cr 0)
             #f
             (list (+ cr 2)
                   (if (string=? t "-")
                     (string-append "ERR " (substring buf 1 cr))
                     (substring buf 1 cr))))))
        ((string=? t "$")
         (let ((cr (find-substr buf "\r\n" 0)))
           (if (< cr 0)
             #f
             (let ((n (string->number (substring buf 1 cr))))
               (if (not (number? n))
                 #f
                 (if (< n 0)
                   (list (+ cr 2) "")
                   (let ((start (+ cr 2))
                         (end (+ (+ cr 2) n)))
                     (if (< (string-length buf) (+ end 2))
                       #f
                       (list (+ end 2) (substring buf start end))))))))))
        (else #f)))))

(define (redis-call! sock . args)
  (let ((wire (resp-encode-cmd args))
        (sent (tcp-send sock wire)))
    (if (or (not (number? sent)) (< sent 0))
      (begin
        (set! *conn-alive* #f)
        "ERR closed")
      (let ((buf "")
            (done #f)
            (result ""))
        (while (not done)
          (begin
            (let ((chunk (tcp-recv sock 65536)))
              (if (or (not (string? chunk)) (= (string-length chunk) 0))
                (begin
                  (set! *conn-alive* #f)
                  (set! done #t)
                  (set! result "ERR closed"))
                (begin
                  (set! buf (string-append buf chunk))
                  (let ((parsed (resp-parse-one buf)))
                    (if parsed
                      (begin
                        (set! result (cadr parsed))
                        (set! done #t))
                      #t)))))))
        result))))


; ── pin helpers (best-effort; PIN list is RESP array - agent may not parse it) ──
(define (pad4 n)
  (cond
    ((< n 10) (string-append "000" (number->string n)))
    ((< n 100) (string-append "00" (number->string n)))
    ((< n 1000) (string-append "0" (number->string n)))
    (else (number->string n))))

(define (pin-prefix-set! sock prefix n)
  (let ((i 0))
    (while (< i n)
      (begin
        ; ignore missing-key errors - redis-call! returns ERR string
        (redis-call! sock "PIN" (string-append prefix (pad4 i)))
        (set! i (+ i 1))))
    #t))

(define (unpin-prefix-set! sock prefix n)
  (let ((i 0))
    (while (< i n)
      (begin
        (redis-call! sock "UNPIN" (string-append prefix (pad4 i)))
        (set! i (+ i 1))))
    #t))

;; ── profile file → hot-strategy:swap! (product path for demo-mvp invert/heal) ──
(define (trim-ws s)
  (let ((n (string-length s))
        (i 0)
        (j 0))
    (set! j n)
    (while (and (< i n)
                (let ((c (substring s i (+ i 1))))
                  (or (string=? c " ") (string=? c "\n")
                      (string=? c "\r") (string=? c "\t"))))
      (set! i (+ i 1)))
    (while (and (> j i)
                (let ((c (substring s (- j 1) j)))
                  (or (string=? c " ") (string=? c "\n")
                      (string=? c "\r") (string=? c "\t"))))
      (set! j (- j 1)))
    (if (>= i j) "" (substring s i j))))

(define (body-for-profile name)
  (cond
    ((string=? name "aggressive") *policy-choose-aggressive*)
    ((string=? name "conservative") *policy-choose-conservative*)
    ((string=? name "inverted") *policy-choose-inverted*)
    ((string=? name "broken") *policy-choose-broken*)
    ((string=? name "nosoft") *policy-choose-nosoft*)
    (else *policy-choose-normal*)))

;; M7 - mutate numeric thresholds inside choose-fn body string (Aura-native)
(define (build-threshold-body min-ops miss-pin)
  (string-append
    "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) "
    "(let ((ops (+ dgets dsets))) "
    "(if (< ops " (number->string min-ops) ") \"\" "
    "(let ((hit-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dhits) (+ dhits dmisses)) 0)) "
    "(miss-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dmisses) (+ dhits dmisses)) 0)) "
    "(ttl-share (if (> nkeys 0) (quotient (* 100 keys_ttl) nkeys) 0)) "
    "(erate (if (> ops 0) (quotient (* 100 devicted) ops) 0))) "
    "(cond "
    ""
    "((>= erate 20) (if (and (> keys_ttl 0) (< avg_ttl 12000)) "
    "\"ttl_aware|flat\" \"lru|flat\")) "
    "((and (> keys_ttl 0) (< avg_ttl 12000) (or (>= ttl-share 20) (> keys_ttl 15))) "
    "\"ttl_aware|flat\") "
    "((and (>= dsets dgets) (> miss-pct " (number->string miss-pin) ") (> nkeys 0)) "
    "\"lfu|flat|pin\") "
    "((> dsets (* dgets 2)) \"lfu|flat\") "
    "((and (> devicted 0) (> miss-pct " (number->string (+ miss-pin 10)) ")) "
    "\"lfu|flat|pin\") "
    "((and (> dgets (* dsets 3)) (>= hit-pct 50)) \"lru|flat\") "
    "((and (> dgets (* dsets 2)) (< hit-pct 55) (> miss-pct 15)) \"lru|flat\") "
    "((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lru|flat\") "
    "(else \"\"))))))"))

(define (do-fitness-threshold-mutate! reason)
  (let ((old-min *thresh-min-ops*)
        (old-miss *thresh-miss-pin*)
        (new-min (if (> *thresh-min-ops* 18) (- *thresh-min-ops* 12) *thresh-min-ops*))
        (new-miss (if (> *thresh-miss-pin* 16) (- *thresh-miss-pin* 8) *thresh-miss-pin*)))
    (if (and (= new-min old-min) (= new-miss old-miss))
      #f
      (if (not (mutate:boundary-safe?))
        (begin
          (display "policy_agent: skip threshold-mutate (boundary not safe)\n")
          #f)
        (begin
          (mutate:safety-snapshot)
          (set! *thresh-min-ops* new-min)
          (set! *thresh-miss-pin* new-miss)
          (let ((body (build-threshold-body new-min new-miss))
                (r #f))
            (set! r (hot-strategy:swap! "choose-fn" body "fitness-thresholds"))
            (display "policy_agent: fitness-threshold-mutate min-ops=")
            (display old-min)
            (display "→")
            (display new-min)
            (display " miss-pin=")
            (display old-miss)
            (display "→")
            (display new-miss)
            (display " reason=")
            (display reason)
            (display " result=")
            (display r)
            (newline)
            (set! *threshold-mutates* (+ *threshold-mutates* 1))
            (set! *swaps* (+ *swaps* 1))
            (set! *fitness-swaps* (+ *fitness-swaps* 1))
            (set! *ticks-since-fitness* 0)
            (set! *profile-name* "thresholded")
            #t))))))

;; M11 - evolve body: threshold literals only (no soft-goal; flood erate must
;; not refuse LFU+pin while protecting hot set). Distinct from M7 one-shot.
(define (build-evolve-body min-ops miss-pin)
  ; No read-heavy→lru rule: once LFU+pin lands, stay pinned across GET measure.
  (string-append
    "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) "
    "(let ((ops (+ dgets dsets))) "
    "(if (< ops " (number->string min-ops) ") \"\" "
    "(let ((miss-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dmisses) (+ dhits dmisses)) 0))) "
    "(cond "
    "((and (>= dsets dgets) (> miss-pct " (number->string miss-pin) ") (> nkeys 0)) "
    "\"lfu|flat|pin\") "
    "((> dsets (* dgets 2)) \"lfu|flat\") "
    "((and (> devicted 0) (> miss-pct " (number->string (+ miss-pin 10)) ")) "
    "\"lfu|flat|pin\") "
    "(else \"\"))))))"))

(define (evolve-apply-body! min-ops miss-pin tag)
  ; A2: mutate:rebind only (avoid hot-strategy:swap! → eval-current stall).
  ; When thresholds are fireable, inline LFU+PIN like A1 fitness-swap.
  (if (not (mutate:boundary-safe?))
    (begin
      (display "policy_agent: skip evolve-apply (boundary not safe)\n")
      #f)
    (begin
      (mutate:safety-snapshot)
      (let ((body (build-evolve-body min-ops miss-pin))
            (ok #f))
        (set! ok
          (try
            (begin
              (mutate:rebind "choose-fn" body tag)
              #t)
            (catch (e) #f)))
        (display "policy_agent: evolve-apply ")
        (display tag)
        (display " min-ops=")
        (display min-ops)
        (display " miss-pin=")
        (display miss-pin)
        (display " ok=")
        (display ok)
        (newline)
        (if ok
          (begin
            (set! *thresh-min-ops* min-ops)
            (set! *thresh-miss-pin* miss-pin)
            (set! *profile-name* "evolved")
            (set! *swaps* (+ *swaps* 1))
            (if (and (<= min-ops 80) (number? *sock*))
              (begin
                (display "policy_agent: EVICT (evolve-apply inline) -> lfu\n")
                (redis-call! *sock* "EVICT" "lfu")
                (set! *last-evict* "lfu")
                (redis-call! *sock* "LAYOUT" "flat")
                (set! *last-layout* "flat")
                (display "policy_agent: PIN hot set (evolve-apply inline)\n")
                (redis-call! *sock* "EVICT" "samples" "64")
                (pin-prefix-set! *sock* "hot" 40)
                (pin-prefix-set! *sock* "z" 24)
                (set! *applies* (+ *applies* 3))
                #t)
              #t)
            #t)
          #f)))))

(define (evolve-propose-next)
  ; A2: aggressive step-down (halve min-ops, floor 24) so 2-3 gens reach
  ; fireable thresholds under short evolve_gain windows (was -140 → stuck >600).
  (let ((nm (if (> *champ-min* 24)
              (let ((h (quotient *champ-min* 2)))
                (if (< h 24) 24 h))
              *champ-min*))
        (ns (if (> *champ-miss* 12)
              (let ((h (quotient *champ-miss* 2)))
                (if (< h 12) 12 h))
              *champ-miss*)))
    (if (and (= nm *champ-min*) (= ns *champ-miss*))
      #f
      (begin
        (set! *trial-min* nm)
        (set! *trial-miss* ns)
        #t))))

(define (evolve-log! action fit)
  (display "policy_agent: evolve gen=")
  (display *evolve-gen*)
  (display " fitness=")
  (display fit)
  (display " champ_fit=")
  (display *champ-fit*)
  (display " action=")
  (display action)
  (display " min-ops=")
  (display *thresh-min-ops*)
  (display " miss-pin=")
  (display *thresh-miss-pin*)
  (display " trial=")
  (display *trial-min*)
  (display "/")
  (display *trial-miss*)
  (display " champ=")
  (display *champ-min*)
  (display "/")
  (display *champ-miss*)
  (newline)
  (set! *evolve-logs* (+ *evolve-logs* 1))
  #t)

;; Slow online evolve: window fitness → keep if better else revert (heal path).
(define (maybe-evolve!)
  (if (or (not *evolve-on*) (string=? *evolve-mode* "done"))
    #f
    (begin
      (set! *evolve-ticks* (+ *evolve-ticks* 1))
      (set! *evolve-fit-sum* (+ *evolve-fit-sum* *hit-ewma*))
      (set! *evolve-fit-n* (+ *evolve-fit-n* 1))
      (if (< *evolve-ticks* *evolve-window*)
        #f
        (let ((fit (if (> *evolve-fit-n* 0)
                     (quotient *evolve-fit-sum* *evolve-fit-n*)
                     0)))
          (set! *evolve-ticks* 0)
          (set! *evolve-fit-sum* 0)
          (set! *evolve-fit-n* 0)
          (cond
            ((string=? *evolve-mode* "baseline")
             (begin
               (set! *champ-fit* fit)
               (set! *champ-min* *thresh-min-ops*)
               (set! *champ-miss* *thresh-miss-pin*)
               (evolve-log! "baseline" fit)
               (if (evolve-propose-next)
                 (begin
                   (evolve-apply-body! *trial-min* *trial-miss* "evolve-trial")
                   (set! *evolve-mode* "trial")
                   (evolve-log! "propose" fit))
                 (begin
                   (set! *evolve-mode* "done")
                   (evolve-log! "done-no-move" fit)))
               #t))
            ((string=? *evolve-mode* "trial")
             (begin
               (if (>= fit *champ-fit*)
                 (begin
                   (set! *champ-fit* fit)
                   (set! *champ-min* *trial-min*)
                   (set! *champ-miss* *trial-miss*)
                   (set! *evolve-keeps* (+ *evolve-keeps* 1))
                   (audit-append! "evolve-keep"
                                  (number->string *champ-min*)
                                  (number->string *trial-min*)
                                  "evolve_keep")
                   (evolve-log! "keep" fit))
                 (begin
                   ; revert / heal to champion thresholds
                   (evolve-apply-body! *champ-min* *champ-miss* "evolve-revert")
                   (set! *heals* (+ *heals* 1))
                   (set! *evolve-reverts* (+ *evolve-reverts* 1))
                   (evolve-log! "revert" fit)))
               (set! *evolve-gen* (+ *evolve-gen* 1))
               (if (>= *evolve-gen* *evolve-max-gens*)
                 (begin
                   (set! *evolve-mode* "done")
                   (evolve-log! "done" fit))
                 (if (evolve-propose-next)
                   (begin
                     (evolve-apply-body! *trial-min* *trial-miss* "evolve-trial")
                     (set! *evolve-mode* "trial")
                     (evolve-log! "propose" fit))
                   (begin
                     (set! *evolve-mode* "done")
                     (evolve-log! "done-floor" fit))))
               #t))
            (else #f)))))))

(define (phase-hint-of dgets dsets dhits dmisses)
  (cond
    ((and (>= dsets dgets) (> dmisses dhits)) "miss_spike")
    ((> dsets (* dgets 2)) "write_heavy")
    ((> dgets (* dsets 3)) "read_heavy")
    ((> dmisses (* dhits 2)) "miss_spike")
    (else "mixed")))

(define (fitness-target-profile)
  (cond
    ((or (string=? *profile-name* "inverted")
         (string=? *profile-name* "broken")
         (string=? *profile-name* "conservative"))
     "aggressive")
    ((string=? *profile-name* "normal") "aggressive")
    ((string=? *profile-name* "aggressive") "normal")
    (else "normal")))

(define (do-fitness-swap! to-name reason)
  ; A4: when canary enabled and idle, trial via canary-start! instead of
  ; immediate commit. During an active canary trial, skip further swaps.
  (if (canary-active?)
    (begin
      (display "policy_agent: skip fitness-swap (canary trial active)\n")
      #f)
    (if (and *canary-on* (not (canary-active?)))
      (canary-start! to-name reason)
      (do-fitness-swap-commit! to-name reason))))

(define (do-fitness-swap-commit! to-name reason)
  ; A1: use mutate:rebind ONLY - hot-strategy:swap! also eval-current, which
  ; re-enters this file and stalls/resets the live tick loop (mutate≈frozen).
  ; denseness still via mutate:rebind of choose-fn body string.
  (if (not (mutate:boundary-safe?))
    (begin
      (display "policy_agent: skip fitness-swap (boundary not safe)\n")
      #f)
    (begin
      (mutate:safety-snapshot)
      (let ((from *profile-name*)
            (body (body-for-profile to-name))
            (ok #f))
        (set! ok
          (try
            (begin
              (mutate:rebind "choose-fn" body (string-append "fitness-" to-name))
              #t)
            (catch (e) #f)))
        (display "policy_agent: fitness-swap ")
        (display from)
        (display "→")
        (display to-name)
        (display " reason=")
        (display reason)
        (display " result=")
        (display ok)
        (newline)
        (if ok
          (begin
            (set! *profile-name* to-name)
            (set! *swaps* (+ *swaps* 1))
            (set! *fitness-swaps* (+ *fitness-swaps* 1))
            (set! *ticks-since-fitness* 0)
            (set! *post-swap-bad* 0)
            (set! *force-rechoose* #t)
            (audit-append! "fitness-swap" from to-name reason)
            ; A1: apply LFU+PIN immediately in THIS stack frame. mutate:rebind
            ; re-evals the file (nested); waiting for a later tick is unreliable.
            (if (and (string=? to-name "aggressive") (number? *sock*))
              (begin
                (display "policy_agent: EVICT (fitness-swap inline) -> lfu\n")
                (redis-call! *sock* "EVICT" "lfu")
                (set! *last-evict* "lfu")
                (redis-call! *sock* "LAYOUT" "flat")
                (set! *last-layout* "flat")
                (display "policy_agent: PIN hot set (fitness-swap inline)\n")
                (redis-call! *sock* "EVICT" "samples" "64")
                (pin-prefix-set! *sock* "hot" 40)
                (pin-prefix-set! *sock* "z" 24)
                (set! *applies* (+ *applies* 3))
                #t)
              #t)
            #t)
          #f)))))

(define (do-fitness-heal! reason)
  (if (canary-active?)
    (begin
      (display "policy_agent: fitness-heal deferred to canary\n")
      (canary-heal! reason))
    (do-fitness-heal-inner! reason)))

(define (do-fitness-heal-inner! reason)
  (display "policy_agent: fitness-heal! reason=")
  (display reason)
  (display " from=")
  (display *profile-name*)
  (newline)
  (display "policy_agent: hot-strategy:heal!\n")
  (hot-strategy:heal!)
  (set! *heals* (+ *heals* 1))
  (set! *fitness-heals* (+ *fitness-heals* 1))
  (set! *profile-name* *last-good-profile*)
  (set! *ticks-since-fitness* 0)
  (set! *post-swap-bad* 0)
  (set! *ticks-bad* 0)
  #t)

;; Fitness-driven mutation: hit-EWMA drop / miss spike / stuck →
;; hot-strategy:swap! profile; if still bad → heal! to last-good.
(define (maybe-fitness-mutate! dgets dsets dhits dmisses devicted)
  (set! *ticks-since-fitness* (+ *ticks-since-fitness* 1))
  (if (not *fitness-on*)
    #f
    (let ((ops (+ dgets dsets))
          (win (+ dhits dmisses))
          (miss-pct (if (> (+ dhits dmisses) 0)
                      (quotient (* 100 dmisses) (+ dhits dmisses))
                      0)))
      (set! *phase-hint* (phase-hint-of dgets dsets dhits dmisses))
      (if (and (>= *hit-ewma* 70) (>= ops 20)
               (not (string=? *profile-name* "inverted"))
               (not (string=? *profile-name* "broken")))
        (begin
          (set! *last-good-profile* *profile-name*)
          (set! *ticks-bad* 0)
          (set! *post-swap-bad* 0)
          #t)
        #t)
      (if (and (> win 15) (or (< *hit-ewma* 55) (> miss-pct 40)))
        (set! *ticks-bad* (+ *ticks-bad* 1))
        (if (and (> win 15) (>= *hit-ewma* 65))
          (set! *ticks-bad* 0)
          #t))
      (let ((ewma-drop (and (> *prev-ewma* 0)
                            (>= (- *prev-ewma* *hit-ewma*) 15)))
            (miss-spike (and (> win 10) (> miss-pct 35) (> ops 15)))
            (evict-pressure (and (> devicted 0) (> miss-pct 35) (> ops 25)))
            (poisoned (or (string=? *profile-name* "inverted")
                          (string=? *profile-name* "broken")))
            (stuck (and (>= *ticks-bad* 5) (> ops 10))))
        (set! *prev-ewma* *hit-ewma*)
        (if (and (>= *ticks-since-fitness* 6)
                 (< *ticks-since-fitness* 999)
                 (or (< *hit-ewma* 50) poisoned)
                 (> win 15))
          (set! *post-swap-bad* (+ *post-swap-bad* 1))
          #t)
        (cond
          ((and (>= *post-swap-bad* 5) (>= *ticks-since-fitness* 6))
           (do-fitness-heal! "still_bad_after_swap"))
          ((and poisoned (or miss-spike stuck (< *hit-ewma* 60) (>= *ticks-bad* 3)))
           (if (>= *ticks-since-fitness* 1)
             (do-fitness-heal! "poison_profile")
             #f))
          ((and (>= *ticks-since-fitness* 4)
                (or (and ewma-drop (or miss-spike evict-pressure))
                    miss-spike
                    stuck
                    (and (string=? *profile-name* "conservative")
                         (or miss-spike stuck (>= *ticks-bad* 6)))))
           (let ((to (fitness-target-profile))
                 (reason (cond
                           (miss-spike "miss_spike")
                           (ewma-drop "ewma_drop")
                           (stuck "stuck")
                           (evict-pressure "evict_pressure")
                           (else "fitness"))))
             (if (string=? to *profile-name*)
               (do-fitness-heal! reason)
               ; A1/SN1: from conservative (or miss_spike / M9 TTL) always
               ; profile-swap → aggressive so choose emits lfu|flat|pin.
               ; Threshold-mutate-first left min-ops too high for per-tick
               ; deltas → never PIN before flash (mutate≈frozen).
               (if (or miss-spike
                       (string=? *profile-name* "conservative")
                       (and *ttl-pressure*
                            (or (string=? *profile-name* "normal")
                                (string=? *profile-name* "thresholded"))))
                 (do-fitness-swap! "aggressive"
                                   (if (or miss-spike
                                           (string=? *profile-name* "conservative"))
                                       reason
                                       (string-append reason "-ttl")))
                 (if (or (string=? *profile-name* "normal")
                         (string=? *profile-name* "thresholded"))
                   (if (do-fitness-threshold-mutate! reason)
                     #t
                     (do-fitness-swap! to reason))
                   (do-fitness-swap! to reason)))))
          (else #f)))))))

(define (maybe-reload-profile!)
  (if (or (not (string? *profile-file*)) (= (string-length *profile-file*) 0))
    #f
    (let ((raw (read-file *profile-file*)))
      (if (not (string? raw))
        #f
        (let ((name (trim-ws raw)))
          (if (or (= (string-length name) 0) (string=? name *profile-name*))
            #f
            (begin
              (display "policy_agent: profile file -> ")
              (display name)
              (newline)
              (if (mutate:boundary-safe?)
                (begin
                  (mutate:safety-snapshot)
                  (let ((r (hot-strategy:swap! "choose-fn" (body-for-profile name)
                                               (string-append "profile-" name))))
                    (display "policy_agent: hot-strategy:swap! profile=")
                    (display name)
                    (display " result=")
                    (display r)
                    (newline)
                    (set! *profile-name* name)
                    (set! *swaps* (+ *swaps* 1))
                    (if (string=? name "broken")
                      (begin
                        (let ((probe (try (choose-fn 100 10 90 10 0 100 0 0 0)
                                          (catch (e) "FAIL"))))
                          (if (or (not (car r))
                                  (not (string? probe))
                                  (string=? probe "FAIL"))
                            (begin
                              (display "policy_agent: hot-strategy:heal!\n")
                              (hot-strategy:heal!)
                              (set! *heals* (+ *heals* 1))
                              (set! *profile-name* "normal"))
                            #t)))
                      #t)
                    #t))
                (begin
                  (display "policy_agent: skip profile swap (boundary not safe)\n")
                  #f)))))))))

; ── seed choose-fn in workspace for hot-strategy ──
; boot-guard write (early re-entry already exited if flag present)
(if (and (string? *boot-guard-file*) (> (string-length *boot-guard-file*) 0))
  (begin
    (write-file *boot-guard-file* "booted\n")
    (display "policy_agent: boot-guard wrote ")
    (display *boot-guard-file*)
    (newline))
  #t)
(display "policy_agent: seeding choose-fn (hot-strategy)\n")
(set-code "(define (choose-fn dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) \"\")")
(eval-current)

(define *safety* (mutate:safety-snapshot))
(display "policy_agent: mutate:safety-snapshot ok boundary-safe? probe\n")
(display "policy_agent: mutate:boundary-safe?=")
(display (mutate:boundary-safe?))
(newline)

(hot-strategy:register! "choose-fn" *policy-choose-normal*)
(let ((r (hot-strategy:swap! "choose-fn" *policy-choose-normal* "seed-normal")))
  (display "policy_agent: register/swap normal → ")
  (display r)
  (newline))
; last-good = normal; optional non-normal seed (poison/conservative benches)
(set! *last-good-profile* "normal")
(set! *profile-name* "normal")
(display "policy_agent: fitness-mutate=")
(display (if *fitness-on* "on" "off"))
(display " seed=")
(display *seed-profile*)
(newline)
(if (and (string? *seed-profile*)
         (> (string-length *seed-profile*) 0)
         (not (string=? *seed-profile* "normal")))
  (begin
    (mutate:safety-snapshot)
    (let ((r (hot-strategy:swap! "choose-fn" (body-for-profile *seed-profile*)
                                 (string-append "seed-" *seed-profile*))))
      (display "policy_agent: seed-profile → ")
      (display *seed-profile*)
      (display " result=")
      (display r)
      (newline)
      (set! *profile-name* *seed-profile*)
      (set! *swaps* (+ *swaps* 1))
      (if (or (string=? *seed-profile* "inverted")
              (string=? *seed-profile* "broken"))
        #t
        (set! *last-good-profile* *seed-profile*))))
  #t)

; M11: seed thresholded evolve body (bad high thresholds lose until evolved)
(set! *champ-min* *thresh-min-ops*)
(set! *champ-miss* *thresh-miss-pin*)
(if (or *evolve-on*
        (not (and (= *thresh-min-ops* 40) (= *thresh-miss-pin* 30))))
  (begin
    (display "policy_agent: evolve=")
    (display (if *evolve-on* "on" "off"))
    (display " seed-thresholds min-ops=")
    (display *thresh-min-ops*)
    (display " miss-pin=")
    (display *thresh-miss-pin*)
    (display " max-gens=")
    (display *evolve-max-gens*)
    (display " window=")
    (display *evolve-window*)
    (newline)
    (mutate:safety-snapshot)
    ; Prefer evolve-body (no soft-goal) whenever custom thresholds set -
    ; M11 frozen vs evolve A/B must share the same body family.
    (let ((body (build-evolve-body *thresh-min-ops* *thresh-miss-pin*))
          (tag (if *evolve-on* "evolve-seed" "thresh-seed-frozen")))
      (let ((r (hot-strategy:swap! "choose-fn" body tag)))
        (display "policy_agent: threshold-seed → ")
        (display tag)
        (display " result=")
        (display r)
        (newline)
        (set! *profile-name* (if *evolve-on* "evolved" "thresholded"))
        (set! *swaps* (+ *swaps* 1))
        (set! *evolve-mode* (if *evolve-on* "baseline" "done"))
        #t)))
  #t)

;
; ── P1.9 HA helpers ──
(define (err-closed? s)
  (and (string? s)
       (>= (string-length s) 3)
       (string=? (substring s 0 3) "ERR")))

(define (close-sock!)
  (if (number? *sock*)
    (begin
      (tcp-close *sock*)
      (set! *sock* #f)
      (set! *conn-alive* #f))
    (set! *conn-alive* #f)))

(define (log-policy-pin! tag)
  (set! *policy-version* (hot-strategy:version))
  (display "policy_agent: policy-pin tag=")
  (display tag)
  (display " profile=")
  (display *profile-name*)
  (display " version=")
  (display *policy-version*)
  (display " last-evict=")
  (display *last-evict*)
  (display " last-layout=")
  (display *last-layout*)
  (display " reconnects=")
  (display *reconnects*)
  (newline)
  #t)


;; A3 — durable audit ring + explain schema
;; Line schema: ts=<ms> op=<fitness-swap|evolve-keep|evict|heal|...> from=<a> to=<b> reason=<r> version=<n>
;; Prefer native (query:last-mutation-provenance) when available; always write structured file.
(define (audit-native-note)
  (try
    (let ((p (query:last-mutation-provenance)))
      (if (string? p) p ""))
    (catch (e) "")))

(define (audit-append! op from to reason)
  (set! *last-audit-ts* (monotonic-ms))
  (set! *last-audit-op* op)
  (set! *last-audit-from* from)
  (set! *last-audit-to* to)
  (set! *last-audit-reason* reason)
  (set! *last-audit-version* (try (hot-strategy:version) (catch (e) *last-audit-version*)))
  (set! *audit-count* (+ *audit-count* 1))
  (set! *last-explain*
    (string-append op ":" reason ":" from "->" to))
  (let ((native (audit-native-note))
        (line (string-append
                "ts=" (number->string *last-audit-ts*)
                " op=" op
                " from=" from
                " to=" to
                " reason=" reason
                " version=" (number->string *last-audit-version*)
                (if (and (string? native) (> (string-length native) 0))
                  (string-append " native=" native)
                  "")
                "\n")))
    (display "policy_agent: audit ")
    (display line)
    (if (and (string? *audit-file*) (> (string-length *audit-file*) 0))
      (begin
        ; append-best-effort: read existing (cap ring) then rewrite
        (let ((prev (try (read-file *audit-file*) (catch (e) "")))
              (keep ""))
          (if (and (string? prev) (> (string-length prev) 0))
            (set! keep prev)
            #t)
          (let ((merged (string-append keep line)))
            ; crude ring: if too long, keep tail ~8k
            (if (> (string-length merged) 8192)
              (set! merged
                (substring merged (- (string-length merged) 6144)
                           (string-length merged)))
              #t)
            (write-file *audit-file* merged)
            (display "policy_agent: audit-file wrote path=")
            (display *audit-file*)
            (newline)))
        #t)
      #t)
  ; A3: heartbeat refresh even if mutate:rebind re-entry skips later ticks
  (write-heartbeat!)
  #t))

(define (write-heartbeat!)
  (if (or (not (string? *heartbeat-file*)) (= (string-length *heartbeat-file*) 0))
    #f
    (begin
      (set! *policy-version* (hot-strategy:version))
      (let ((payload (string-append
                       "ts_ms=" (number->string (monotonic-ms)) "\n"
                       "profile=" *profile-name* "\n"
                       "version=" (number->string *policy-version*) "\n"
                       "last_evict=" *last-evict* "\n"
                       "last_layout=" *last-layout* "\n"
                       "reconnects=" (number->string *reconnects*) "\n"
                       "applies=" (number->string *applies*) "\n"
                       "audit_count=" (number->string *audit-count*) "\n"
                       "last_audit_op=" *last-audit-op* "\n"
                       "last_audit_from=" *last-audit-from* "\n"
                       "last_audit_to=" *last-audit-to* "\n"
                       "last_audit_reason=" *last-audit-reason* "\n"
                       "last_audit_version=" (number->string *last-audit-version*) "\n"
                       "last_explain=" *last-explain* "\n"
                       "canary_mode=" *canary-mode* "\n"
                       "canary_ticks=" (number->string *canary-ticks*) "\n"
                       "canary_commits=" (number->string *canary-commits*) "\n"
                       "canary_heals=" (number->string *canary-heals*) "\n")))
        (write-file *heartbeat-file* payload)
        (display "policy_agent: heartbeat wrote path=")
        (display *heartbeat-file*)
        (display " bytes=")
        (display (string-length payload))
        (newline)
        #t))))

;; A4 — canary choose-fn: trial body N ticks → commit or heal!
;; Native-safe: mutate:boundary-safe? + mutate:safety-snapshot before trial;
;; audit reasons: canary_start / canary_commit / canary_heal.
(define (canary-active?)
  (string=? *canary-mode* "trial"))

(define (canary-heal! detail)
  (display "policy_agent: canary-heal! from=")
  (display *canary-to*)
  (display " back=")
  (display *canary-from*)
  (display " detail=")
  (display detail)
  (newline)
  (display "policy_agent: hot-strategy:heal! (canary)\n")
  (hot-strategy:heal!)
  (set! *heals* (+ *heals* 1))
  (set! *canary-heals* (+ *canary-heals* 1))
  (set! *profile-name* *canary-from*)
  (if (and (string? *canary-from*) (> (string-length *canary-from*) 0))
    (set! *last-good-profile* *canary-from*)
    #t)
  (audit-append! "canary-heal" *canary-to* *canary-from* "canary_heal")
  (set! *canary-mode* "idle")
  (set! *canary-ticks* 0)
  (set! *canary-fit-sum* 0)
  (set! *canary-fit-n* 0)
  (set! *ticks-since-fitness* 0)
  (set! *post-swap-bad* 0)
  (set! *ticks-bad* 0)
  #t)

(define (canary-commit!)
  (display "policy_agent: canary-commit! profile=")
  (display *canary-to*)
  (display " ticks=")
  (display *canary-ticks*)
  (newline)
  (set! *canary-commits* (+ *canary-commits* 1))
  (set! *last-good-profile* *canary-to*)
  (set! *profile-name* *canary-to*)
  (audit-append! "canary-commit" *canary-from* *canary-to* "canary_commit")
  ; Refresh safety snapshot so future heal! lands on committed body
  (if (mutate:boundary-safe?)
    (mutate:safety-snapshot)
    #t)
  (set! *canary-mode* "idle")
  (set! *canary-ticks* 0)
  (set! *canary-fit-sum* 0)
  (set! *canary-fit-n* 0)
  (set! *ticks-since-fitness* 0)
  #t)

(define (canary-start! to-name reason)
  (if (canary-active?)
    (begin
      (display "policy_agent: canary-start skipped (already in trial)\n")
      #f)
    (if (not (mutate:boundary-safe?))
      (begin
        (display "policy_agent: skip canary-start (boundary not safe)\n")
        #f)
      (begin
        (mutate:safety-snapshot)
        (let ((from *profile-name*)
              (body (body-for-profile to-name))
              (ok #f))
          (set! ok
            (try
              (begin
                (mutate:rebind "choose-fn" body (string-append "canary-" to-name))
                #t)
              (catch (e) #f)))
          (display "policy_agent: canary-start ")
          (display from)
          (display "→")
          (display to-name)
          (display " reason=")
          (display reason)
          (display " result=")
          (display ok)
          (newline)
          (if ok
            (begin
              (set! *canary-from* from)
              (set! *canary-to* to-name)
              (set! *canary-mode* "trial")
              (set! *canary-ticks* 0)
              (set! *canary-baseline-ewma* *hit-ewma*)
              (set! *canary-fit-sum* 0)
              (set! *canary-fit-n* 0)
              (set! *profile-name* to-name)
              (set! *swaps* (+ *swaps* 1))
              (set! *force-rechoose* #t)
              (audit-append! "canary-start" from to-name "canary_start")
              ; Immediate probe: broken body → heal without waiting full window
              (let ((probe (try (choose-fn 20 10 5 15 0 30 0 0 0)
                                (catch (e) "FAIL"))))
                (if (or (not (string? probe)) (string=? probe "FAIL")
                        (= (string-length probe) 0))
                  (begin
                    (display "policy_agent: canary probe fail → heal\n")
                    (canary-heal! "probe_fail"))
                  #t))
              #t)
            #f))))))

(define (canary-tick! dhits dmisses)
  (if (not (canary-active?))
    #f
    (begin
      (set! *canary-ticks* (+ *canary-ticks* 1))
      (let ((win (+ dhits dmisses))
            (poisoned (or (string=? *canary-to* "inverted")
                          (string=? *canary-to* "broken")))
            (inst 0)
            (avg 0)
            (drop 0))
        (if (> win 0)
          (begin
            (set! inst (quotient (* 100 dhits) win))
            (set! *canary-fit-sum* (+ *canary-fit-sum* inst))
            (set! *canary-fit-n* (+ *canary-fit-n* 1)))
          #t)
        (set! avg (if (> *canary-fit-n* 0)
                    (quotient *canary-fit-sum* *canary-fit-n*)
                    *hit-ewma*))
        (set! drop (if (> *canary-baseline-ewma* 0)
                     (- *canary-baseline-ewma* *hit-ewma*)
                     0))
        (display "policy_agent: canary-tick n=")
        (display *canary-ticks*)
        (display "/")
        (display *canary-ticks-n*)
        (display " ewma=")
        (display *hit-ewma*)
        (display " avg=")
        (display avg)
        (display " drop=")
        (display drop)
        (display " to=")
        (display *canary-to*)
        (newline)
        (cond
          ; poison profiles: heal quickly (within T)
          ((and poisoned (>= *canary-ticks* 1))
           (canary-heal! "poison_profile"))
          ; fitness drop vs baseline
          ((and (>= *canary-fit-n* 2)
                (>= drop *canary-drop-pp*)
                (or (< *hit-ewma* 55) (< avg 50)))
           (canary-heal! "fitness_drop"))
          ; window complete
          ((>= *canary-ticks* *canary-ticks-n*)
           (if (or poisoned (< avg 45) (and (> *canary-baseline-ewma* 60)
                                            (< avg (- *canary-baseline-ewma* *canary-drop-pp*))))
             (canary-heal! "window_reject")
             (canary-commit!)))
          (else #t))))))

(define (maybe-canary-inject!)
  (if (or *canary-inject-done*
          (not (string? *canary-inject*))
          (= (string-length *canary-inject*) 0)
          (canary-active?))
    #f
    (if (>= *tick-count* *canary-warm-ticks*)
      (begin
        (set! *canary-inject-done* #t)
        (display "policy_agent: canary-inject firing profile=")
        (display *canary-inject*)
        (newline)
        (canary-start! *canary-inject* "inject"))
      #f)))

(define (reapply-last-policy!)
  ; After reconnect: INFO then re-assert last chosen EVICT/LAYOUT if known.
  ; Fail-safe: if agent memory empty, C server already keeps last kernel.
  (let ((info (redis-call! *sock* "INFO")))
    (if (or (not (string? info)) (err-closed? info))
      (begin
        (display "policy_agent: reapply INFO failed\n")
        (set! *conn-alive* #f)
        #f)
      (let ((cur (info-get info "evict"))
            (cur-layout (info-get info "layout")))
        (display "policy_agent: reapply check server evict=")
        (display cur)
        (display " layout=")
        (display cur-layout)
        (display " want-evict=")
        (display *last-evict*)
        (display " want-layout=")
        (display *last-layout*)
        (newline)
        (if (> (string-length *last-evict*) 0)
          (begin
            (display "policy_agent: re-apply EVICT ")
            (display *last-evict*)
            (display (if (string=? *last-evict* cur) " (in-sync)" " (delta)"))
            (newline)
            (redis-call! *sock* "EVICT" *last-evict*)
            (set! *applies* (+ *applies* 1)))
          #t)
        (if (> (string-length *last-layout*) 0)
          (begin
            (display "policy_agent: re-apply LAYOUT ")
            (display *last-layout*)
            (display (if (string=? *last-layout* cur-layout) " (in-sync)" " (delta)"))
            (newline)
            (redis-call! *sock* "LAYOUT" *last-layout*)
            (set! *applies* (+ *applies* 1)))
          #t)
        (set! *have-prev* #f)
        (log-policy-pin! "reapply")
        #t))))

(define (ensure-connected!)
  (if (and *conn-alive* (number? *sock*))
    #t
    (let ((ok #f)
          (delay *backoff-ms*)
          (attempt 0))
      (close-sock!)
      (while (and (not ok) *running*)
        (begin
          (set! attempt (+ attempt 1))
          (display "policy_agent: connect attempt=")
          (display attempt)
          (display " backoff_ms=")
          (display delay)
          (display " ")
          (display *host*)
          (display ":")
          (display *port*)
          (newline)
          (set! *sock* (tcp-connect *host* *port*))
          (cond
            ((not (number? *sock*))
             (begin
               (display "policy_agent: tcp-connect failed; sleep ")
               (display delay)
               (newline)
               (busy-wait-ms delay)
               (set! delay (if (< (* delay 2) *backoff-cap*) (* delay 2) *backoff-cap*))))
            (else
             (begin
               (set! *conn-alive* #t)
               (if (> (string-length *password*) 0)
                 (begin
                   (display "policy_agent: AUTH\n")
                   (let ((ar (redis-call! *sock* "AUTH" *password*)))
                     (display "policy_agent: AUTH → ")
                     (display ar)
                     (newline)
                     (if (err-closed? ar)
                       (set! *conn-alive* #f)
                       #t)))
                 #t)
               (if (not *conn-alive*)
                 (begin
                   (close-sock!)
                   (busy-wait-ms delay)
                   (set! delay (if (< (* delay 2) *backoff-cap*) (* delay 2) *backoff-cap*)))
                 (let ((pong (redis-call! *sock* "PING")))
                   (display "policy_agent: PING → ")
                   (display pong)
                   (newline)
                   (if (or (not (string? pong))
                           (err-closed? pong)
                           (and (>= (string-length pong) 3)
                                (string=? (substring pong 0 3) "ERR")))
                     (begin
                       (close-sock!)
                       (busy-wait-ms delay)
                       (set! delay (if (< (* delay 2) *backoff-cap*)
                                     (* delay 2) *backoff-cap*)))
                     (begin
                       (if *ever-connected*
                         (begin
                           (set! *reconnects* (+ *reconnects* 1))
                           (display "policy_agent: reconnected reconnects=")
                           (display *reconnects*)
                           (newline)
                           (reapply-last-policy!)
                           (log-policy-pin! "reconnect"))
                         (begin
                           (set! *ever-connected* #t)
                           (log-policy-pin! "connect")
                           (set! *have-prev* #f)))
                       (set! *backoff-ms* 50)
                       (set! ok #t)
                       (write-heartbeat!))))))))))
      ok)))

; ── connect to C data plane (P1.9: reconnect + backoff) ──
(display "policy_agent: connect ")
(display *host*)
(display ":")
(display *port*)
(newline)

(if (not (ensure-connected!))
  (begin
    (display "policy_agent: initial connect failed\n")
    (set! *fatal* #t))
  #t)

(if (and (not *fatal*) *demo*)
  (begin
    (display "policy_agent: DEMO mode (normal → invert swap → heal)\n")
    (set! *t0* (monotonic-ms)))
  #t)

(if (not *fatal*)
  (while *running*
    (begin
      (busy-wait-ms *tick-ms*)
      (set! *tick-count* (+ *tick-count* 1))
      ; HA test hook: force one TCP drop after N ticks
      (if (and (not *forced-reconnect-done*)
               (> *force-reconnect-after* 0)
               (>= *tick-count* *force-reconnect-after*)
               *conn-alive*)
        (begin
          (display "policy_agent: HA force-reconnect after ticks=")
          (display *tick-count*)
          (newline)
          (close-sock!)
          (set! *forced-reconnect-done* #t))
        #t)
      (if (not (ensure-connected!))
        (begin
          (display "policy_agent: give up reconnect\n")
          (set! *running* #f)
          (set! *fatal* #t))
        (begin
      (maybe-reload-profile!)
      (write-heartbeat!)
      ; HA test: after forced reconnect succeeds, exit cleanly (non-demo)
      (if (and *forced-reconnect-done*
               (>= *reconnects* 1)
               (not *demo*)
               (>= *tick-count* (+ *force-reconnect-after* 2)))
        (begin
          (display "policy_agent: HA reconnect test PASS reconnects=")
          (display *reconnects*)
          (display " last-evict=")
          (display *last-evict*)
          (newline)
          (set! *running* #f)
          (set! *exit* 0)
          (set! *fatal* #f))
        #t)
      ; safety before any swap in demo phases
      (let ((info (redis-call! *sock* "INFO")))
        (if (or (not (string? info)) (err-closed? info))
          (begin
            (display "policy_agent: INFO failed (will reconnect): ")
            (display info)
            (newline)
            (close-sock!))
          (begin
            (let ((g (info-num info "gets"))
                  (s (info-num info "sets"))
                  (h (info-num info "hits"))
                  (m (info-num info "misses"))
                  (ev (info-num info "evicted"))
                  (ex (info-num info "expired"))
                  (nk (info-num info "keys"))
                  (kt (info-num info "keys_with_ttl"))
                  (at (info-num info "avg_ttl_ms"))
                  (cur (info-get info "evict"))
                  (cur-layout (info-get info "layout")))
                (parse-policy-hints! (info-get info "policy_hints"))
              (let ((dgets (if *have-prev* (- g *prev-gets*) 0))
                    (dsets (if *have-prev* (- s *prev-sets*) 0))
                    (dhits (if *have-prev* (- h *prev-hits*) 0))
                    (dmisses (if *have-prev* (- m *prev-misses*) 0))
                    (devicted (if *have-prev* (- ev *prev-evicted*) 0))
                    (dexpired (if *have-prev* (- ex *prev-expired*) 0)))
                (set! *prev-gets* g)
                (set! *prev-sets* s)
                (set! *prev-hits* h)
                (set! *prev-misses* m)
                (set! *prev-evicted* ev)
                (set! *prev-expired* ex)
                (set! *have-prev* #t)
                ; hit% EWMA (agent-side hot concentration proxy)
                (let ((win (+ dhits dmisses)))
                  (if (> win 0)
                    (let ((inst (quotient (* 100 dhits) win)))
                      (set! *hit-ewma*
                        (quotient (+ (* *hit-ewma* 7) (* inst 3)) 10)))
                    #t))
                                (set! *ttl-pressure*
                  (and (> kt 0) (< at 12000)
                       (or (> kt 15) (>= (if (> nk 0) (quotient (* 100 kt) nk) 0) 20))))

                ; Apply choose BEFORE fitness mutate so EVICT lands even if
                ; hot-strategy:swap! → eval-current re-enters the file.
                (set! *last-dgets* dgets)
                (set! *last-dsets* dsets)
                (set! *last-dhits* dhits)
                (set! *last-dmisses* dmisses)
                (set! *last-devicted* devicted)
                (set! *last-nkeys* nk)
                (set! *last-dexpired* dexpired)
                (set! *last-avg-ttl* at)
                (set! *last-keys-ttl* kt)
                (let ((choice (try
                                (choose-fn dgets dsets dhits dmisses devicted nk
                                           dexpired at kt)
                                (catch (e) ""))))
                  ; M12: prefix-scoped override from POLICY hints
                  (if *prefix-policy-on*
                    (begin
                      (cond
                        ((and (prefix-has-session?) *ttl-pressure*)
                         (set! choice "ttl_aware|flat|pin"))
                        ((prefix-has-zipf?)
                         (set! choice "lfu|flat|pin"))
                        ((prefix-has-session?)
                         (set! choice "ttl_aware|flat|pin"))
                        (else #t))
                      (if (and (string? choice) (> (string-length choice) 0)
                               (= *prefix-applies* 0))
                        (begin
                          (display "policy_agent: prefix-policy hints=")
                          (display *policy-hints*)
                          (display " → ")
                          (display choice)
                          (newline)
                          (set! *prefix-applies* 1))
                        #t))
                    #t)
                  (if (and (string? choice) (> (string-length choice) 0))
                    (begin
                      ; parse "evict|layout|pin" (backward compat: bare "lfu")
                      (let ((parts '())
                            (start 0)
                            (i 0)
                            (n (string-length choice)))
                        (while (<= i n)
                          (if (or (= i n)
                                  (and (< i n)
                                       (string=? (substring choice i (+ i 1)) "|")))
                            (begin
                              (set! parts
                                (append parts
                                        (list (substring choice start i))))
                              (set! start (+ i 1))
                              (set! i (+ i 1)))
                            (set! i (+ i 1))))
                        (let ((ev-name (if (pair? parts) (car parts) ""))
                              (ly-name (if (and (pair? parts) (pair? (cdr parts)))
                                        (cadr parts) ""))
                              (want-pin (and (pair? parts)
                                             (pair? (cdr parts))
                                             (pair? (cddr parts))
                                             (string=? (caddr parts) "pin")))
                              (want-soft (and (pair? parts)
                                              (or (string=? (car parts) "soft")
                                                  (and (pair? (cdr parts))
                                                       (string=? (cadr parts) "soft"))
                                                  (and (pair? (cdr parts))
                                                       (pair? (cddr parts))
                                                       (string=? (caddr parts) "soft"))))))
                          (if (and (> (string-length ev-name) 0)
                                   (not (string=? ev-name cur)))
                            (begin
                              (let ((erate (if (> (+ dgets dsets) 0)
                                             (quotient (* 100 devicted)
                                                       (+ dgets dsets))
                                             0)))
                                (if want-soft
                                  (begin
                                    (set! *soft-fires* (+ *soft-fires* 1))
                                    (display "policy_agent: soft-goal refuse expensive (erate=")
                                    (display erate)
                                    (display " devicted=")
                                    (display devicted)
                                    (display " ops=")
                                    (display (+ dgets dsets))
                                    (display ")\n"))
                                  #t)
                                (display "policy_agent: EVICT ")
                                (display cur)
                                (display " → ")
                                (display ev-name)
                                (display " (dgets=")
                                (display dgets)
                                (display " dsets=")
                                (display dsets)
                                (display " ewma=")
                                (display *hit-ewma*)
                                (display " dexpired=")
                                (display dexpired)
                                (display " avg_ttl=")
                                (display at)
                                (display " keys_ttl=")
                                (display kt)
                                (display " devicted=")
                                (display devicted)
                                (display " erate=")
                                (display erate)
                                (display ")\n")
                                (redis-call! *sock* "EVICT" ev-name)
                                (set! *last-evict* ev-name)
                                (set! *applies* (+ *applies* 1))
                                (set! *swaps* (+ *swaps* 1))
                                (audit-append! "evict" cur ev-name
                                               (if (string? *phase-hint*) *phase-hint* "choose")))))
                            #t)
                          (if (and (> (string-length ly-name) 0)
                                   (not (string=? ly-name cur-layout)))
                            (begin
                              (display "policy_agent: LAYOUT ")
                              (display cur-layout)
                              (display " → ")
                              (display ly-name)
                              (newline)
                              (redis-call! *sock* "LAYOUT" ly-name)
                              (set! *last-layout* ly-name)
                              (set! *applies* (+ *applies* 1)))
                            #t)
                          ; On LRU swap-in: drop stale pins so WS shift is not glued to set A
                          (if (and (string=? ev-name "lru")
                                   (not (string=? cur "lru"))
                                   (not *prefix-policy-on*))
                            (begin
                              (display "policy_agent: UNPIN stale hot/z prefixes\n")
                              (unpin-prefix-set! *sock* "hot" 40)
                              (unpin-prefix-set! *sock* "z" 24)
                              #t)
                            #t)
                          (if want-pin
                            (begin
                              (redis-call! *sock* "EVICT" "samples" "64")
                              (if (not (string=? cur-layout "flat"))
                                (redis-call! *sock* "LAYOUT" "flat")
                                #t)
                              (if *prefix-policy-on*
                                (begin
                                  (display "policy_agent: PIN prefix-policy ")
                                  (display *pfx0*)
                                  (display "/")
                                  (display *pfx1*)
                                  (newline)
                                  (if (> (string-length *pfx0*) 0)
                                    (pin-prefix-set! *sock* *pfx0* 32)
                                    #t)
                                  (if (> (string-length *pfx1*) 0)
                                    (pin-prefix-set! *sock* *pfx1* 32)
                                    #t))
                                (begin
                                  (display "policy_agent: PIN hot set + samples=64\n")
                                  (pin-prefix-set! *sock* "hot" 40)
                                  (pin-prefix-set! *sock* "z" 24)))
                              (set! *applies* (+ *applies* 1))
                              #t)
                            #t))))
                    #t))
                (maybe-canary-inject!)
                (if (canary-active?)
                  (canary-tick! dhits dmisses)
                  (maybe-fitness-mutate! dgets dsets dhits dmisses devicted))
                (if *force-rechoose*
                  (begin
                    (set! *force-rechoose* #f)
                    ; A1: use miss-spike-shaped deltas so aggressive choose emits
                    ; lfu|flat|pin even if last tick was idle (sleep between bursts).
                    (let ((choice2 (try
                                     (choose-fn 20 40 5 35 3
                                                (if (> *last-nkeys* 0) *last-nkeys* 30)
                                                0 0 0)
                                     (catch (e) ""))))
                      (if (and (string? choice2) (> (string-length choice2) 0))
                        (begin
                          (display "policy_agent: post-swap re-choose → ")
                          (display choice2)
                          (newline)
                          ; reuse apply path by injecting into choice via a mini apply
                          (let ((parts2 '())
                                (start2 0)
                                (i2 0)
                                (n2 (string-length choice2)))
                            (while (<= i2 n2)
                              (if (or (= i2 n2)
                                      (and (< i2 n2)
                                           (string=? (substring choice2 i2 (+ i2 1)) "|")))
                                (begin
                                  (set! parts2 (append parts2 (list (substring choice2 start2 i2))))
                                  (set! start2 (+ i2 1))
                                  (set! i2 (+ i2 1)))
                                (set! i2 (+ i2 1))))
                            (let ((ev2 (if (pair? parts2) (car parts2) ""))
                                  (ly2 (if (and (pair? parts2) (pair? (cdr parts2))) (cadr parts2) ""))
                                  (pin2 (and (pair? parts2) (pair? (cdr parts2)) (pair? (cddr parts2))
                                             (string=? (caddr parts2) "pin"))))
                              (if (and (> (string-length ev2) 0) (not (string=? ev2 *last-evict*)))
                                (begin
                                  (display "policy_agent: EVICT (post-swap) → ")
                                  (display ev2)
                                  (newline)
                                  (redis-call! *sock* "EVICT" ev2)
                                  (set! *last-evict* ev2)
                                  (set! *applies* (+ *applies* 1)))
                                #t)
                              (if (and (> (string-length ly2) 0) (not (string=? ly2 *last-layout*)))
                                (begin
                                  (redis-call! *sock* "LAYOUT" ly2)
                                  (set! *last-layout* ly2)
                                  (set! *applies* (+ *applies* 1)))
                                #t)
                              (if pin2
                                (begin
                                  (display "policy_agent: PIN hot set (post-swap)\n")
                                  (redis-call! *sock* "EVICT" "samples" "64")
                                  (pin-prefix-set! *sock* "hot" 40)
                                  (pin-prefix-set! *sock* "z" 24)
                                  (set! *applies* (+ *applies* 1)))
                                #t))))
                        #t)))
                  #t)
                (maybe-evolve!)
                #t)))))
      ; demo phase machine
      (if *demo*
        (let ((elapsed (- (monotonic-ms) *t0*)))
          (if (and (not *did-invert*) (>= elapsed 3000))
            (begin
              (display "policy_agent: hot-strategy:swap! → inverted (demo)\n")
              (if (mutate:boundary-safe?)
                (begin
                  (mutate:safety-snapshot)
                  (let ((r (hot-strategy:swap! "choose-fn" *policy-choose-inverted* "demo-invert")))
                    (display "policy_agent: swap inverted result=")
                    (display r)
                    (newline)
                    (set! *did-invert* #t)
                    (set! *swaps* (+ *swaps* 1))))
                (display "policy_agent: skip invert (boundary not safe)\n")))
            #t)
          (if (and *did-invert* (not *did-heal*) (>= elapsed 6500))
            (begin
              (display "policy_agent: attempting broken body (expect heal)\n")
              (mutate:safety-snapshot)
              (let ((r (hot-strategy:swap! "choose-fn" *policy-choose-broken* "demo-broken")))
                (display "policy_agent: broken swap result=")
                (display r)
                (newline)
                ; Even if swap "succeeds" at rebind, call may fail - force heal path
                (let ((probe (try (choose-fn 100 10 90 10 0 100 0 0 0) (catch (e) "FAIL"))))
                  (display "policy_agent: probe after broken=")
                  (display probe)
                  (newline)
                  (if (or (not (car r)) (string=? (if (string? probe) probe "") "FAIL")
                          (not (string? probe)))
                    (begin
                      (display "policy_agent: hot-strategy:heal!\n")
                      (hot-strategy:heal!)
                      (set! *heals* (+ *heals* 1))
                      (display "policy_agent: healed body active; version=")
                      (display (hot-strategy:version))
                      (newline))
                    (begin
                      ; swap reported ok but we still heal to exercise path
                      (display "policy_agent: force heal! (smoke)\n")
                      (hot-strategy:heal!)
                      (set! *heals* (+ *heals* 1)))))
                (set! *did-heal* #t)))
            #t)
          (if (>= elapsed 10000)
            (begin
              (display "policy_agent: demo done applies=")
              (display *applies*)
              (display " swaps=")
              (display *swaps*)
              (display " heals=")
              (display *heals*)
              (newline)
              (display "policy_agent: mutate:summary=")
              (display (mutate:summary))
              (newline)
              (set! *running* #f)
              (set! *exit* 0))
            #t))
        #t)))
        )) ; end ensure-connected begin / while body
  #t)

(if (number? *sock*)
  (tcp-close *sock*)
  #t)

(display "policy_agent: exit applies=")
(display *applies*)
(display " reconnects=")
(display *reconnects*)
(display " last-evict=")
(display *last-evict*)
(display " profile=")
(display *profile-name*)
(display " version=")
(display (hot-strategy:version))
(display " heals=")
(display *heals*)
(display " fitness-swaps=")
(display *fitness-swaps*)
(display " fitness-heals=")
(display *fitness-heals*)
(display " threshold-mutates=")
(display *threshold-mutates*)
(display " soft-fires=")
(display *soft-fires*)
(display " evolve-gens=")
(display *evolve-gen*)
(display " evolve-keeps=")
(display *evolve-keeps*)
(display " evolve-reverts=")
(display *evolve-reverts*)
(display " evolve-logs=")
(display *evolve-logs*)
(display " prefix-applies=")
(display *prefix-applies*)
(display " canary-commits=")
(display *canary-commits*)
(display " canary-heals=")
(display *canary-heals*)
(display " canary-mode=")
(display *canary-mode*)
(display " profile=")
(display *profile-name*)
(newline)
(if *fatal* (set! *exit* 1) #t)
) ; end A1 early-guard if/begin
