; policy_agent.aura - Aura-native control plane (no FFI soup)
;
; Split architecture (see docs/aura-native-control.md):
;   C aura_redis_server  = data plane (GET/SET + EVICT/LAYOUT/INFO kernels)
;   this process         = policy workspace: hot-strategy mutate choose-fn,
;                          apply via RESP EVICT / LAYOUT
;
; Why separate process: on this Aura rev, many top-level c-func binds make
; user closures inert - so hot-strategy must live in a fresh workspace.
;
; Env:
;   AURA_REDIS_PORT          target C server (default 6379)
;   AURA_REDIS_HOST          default 127.0.0.1
;   AURA_REDIS_POLICY_DEMO=1 timed swap+heal demo then exit
;   AURA_REDIS_POLICY_MS     tick period (default 200)
;   AURA_REDIS_POLICY_PROFILE_FILE  path whose contents name a choose body
;                                   (normal|aggressive|conservative|inverted|broken);
;                                   on change, hot-strategy:swap! (demo-mvp invert/heal)
;   AURA_REDIS_FITNESS_MUTATE=0|1   fitness-driven hot-strategy profile swap/heal
;                                   (default 1). Set 0 or AURA_REDIS_FROZEN=1 to freeze
;                                   choose-fn after seed (adaptive_frozen bench).
;   AURA_REDIS_SEED_PROFILE         initial body after register (default normal)
;   AURA_REDIS_EVOLVE=0|1           M11 slow online evolve loop (multi-gen threshold
;                                   mutate + fitness window + keep/revert). Distinct
;                                   from M7 one-shot fitness-threshold-mutate.
;   AURA_REDIS_THRESH_MIN_OPS       seed min-ops literal (default 40; evolve uses 180)
;   AURA_REDIS_THRESH_MISS_PIN      seed miss-pin literal (default 30; evolve uses 75)
;   AURA_REDIS_EVOLVE_MAX_GENS      max generations (default 6)
;   AURA_REDIS_EVOLVE_WINDOW        ticks per fitness window (default 8)
;   AURA_REDIS_EVOLVE_BACKEND       A15: hand|pso|fss|grid (default hand; swarm propose)
;   AURA_REDIS_WEIGHT_EVOLVE=0|1    A13: mutate signal weights with thresholds (default 1 if evolve)
;   AURA_REDIS_W_MISS / W_WRITE / W_EVICT  seed signal weights (defaults 10/2/10 = identity)
;   AURA_REDIS_FIBER_SHADOW=0|1     A16: fiber dual-body score without applying loser (default 0)
;   AURA_REDIS_SHADOW_AB=0|1         A10: dual choose dry-run + C sample; never EVICT loser
;   AURA_REDIS_SHADOW_PROFILE        challenger choose body (default inverted)
;   AURA_REDIS_SHADOW_SAMPLE_PCT     C GET sample % for shadow_* INFO (default 10)
;   AURA_REDIS_PREFER_SLRU=0|1       A12: zipf/miss_spike prefer slru over lfu
;   AURA_REDIS_PASSWORD / REQUIREPASS  AUTH to C server when requirepass set
;   AURA_REDIS_POLICY_HEARTBEAT     optional file rewritten each tick (HA probe)
;   AURA_REDIS_POLICY_PIN          durable pin (profile/version/hash) for HA resume
;   AURA_REDIS_AUTO_FREEZE=0|1       A8: meta-freeze when EWMA stable (default 0)
;   AURA_REDIS_AUTO_FREEZE_STABLE_TICKS  ticks of high EWMA before freeze (default 12)
;   AURA_REDIS_AUTO_FREEZE_EWMA_MIN hit-EWMA floor for "stable" (default 80)
;   AURA_REDIS_AUTO_FREEZE_TICK_MS  tick ms while meta-frozen (default 5× POLICY_MS)
;   AURA_REDIS_AUTO_UNFREEZE_MISS_PP  window miss% to unfreeze (default 35)
;   AURA_REDIS_POLICY_FORCE_RECONNECT_AFTER  test hook: drop TCP after N ticks
;   AURA_REDIS_POLICY_BACKOFF_CAP_MS  reconnect backoff cap (default 4000)
;   AURA_REDIS_CANARY=0|1            A4: trial choose-fn N ticks then commit/heal
;   AURA_REDIS_CANARY_TICKS          trial window ticks (default 5)
;   AURA_REDIS_CANARY_INJECT         start one canary trial of named profile
;                                   (broken|inverted|aggressive|…) after warm-up
;   AURA_REDIS_CANARY_DROP_PP        EWMA drop vs baseline to heal (default 12)

(require "std/mutate" all:)
(require "std/hot-strategy" all:)
(require "std/socket" all:)
(require "src/redis/policy/choose_normal" all:)
(require "src/redis/policy/choose_aggressive" all:)
(require "src/redis/policy/choose_conservative" all:)
(require "src/redis/policy/choose_inverted" all:)
(require "src/redis/policy/choose_broken" all:)
(require "src/redis/policy/choose_nosoft" all:)

(display "policy_agent: A1-FILE-LOAD\n")
; A1 early re-entry gate - BEFORE heavy defines / getenv. mutate:rebind may
; re-eval this file; if boot-guard exists, skip the rest of the module so the
; outer tick can continue (post-swap re-choose / PIN).
(define *a1-boot-path*
  (string-append "/work/.ar-agent-booted-"
                 (let ((e (getenv "AURA_REDIS_PORT")))
                   (if (and (string? e) (> (string-length e) 0)) e "6379"))
                 ".flag"))
(define *a1-boot-content*
  (try (read-file *a1-boot-path*) (catch (e) (string-append "ERR:" (if (string? e) e "?")))))
(display "policy_agent: early-guard path=")
(display *a1-boot-path*)
(display " content=")
(display *a1-boot-content*)
(newline)
(define *a1-reentry*
  (and (string? *a1-boot-content*) (> (string-length *a1-boot-content*) 0)))
(display "policy_agent: early-guard reentry?=")
(display *a1-reentry*)
(newline)
(if *a1-reentry*
  (begin
    (display "policy_agent: eval-current re-entry - skip reboot (early-guard)\n")
    #t)
  (begin
(define *host* "127.0.0.1")
(define *port* 6379)
(define *tick-ms* 200)
; A1: eval-current after hot-strategy:swap! re-enters this file. A boot-guard
; file lets re-entry skip reconnect/seed/while so the outer tick can post-swap
; re-choose (PIN) instead of wiping seed back to conservative.
(define *boot-guard-file* "")

(define *demo* #f)
(define *fatal* #f)
(define *sock* #f)
(define *running* #t)
(define *exit* 1)
(define *swaps* 0)
(define *applies* 0)
(define *heals* 0)
(define *profile-file* "")
(define *profile-name* "normal")
(define *seed-profile* "normal")
(define *fitness-on* #t)
(define *last-good-profile* "normal")
(define *prev-ewma* 0)
(define *ticks-bad* 0)
(define *ticks-since-fitness* 999)
(define *post-swap-bad* 0)
(define *fitness-swaps* 0)
; A1: last tick deltas - re-apply choose immediately after fitness-swap
(define *last-dgets* 0)
(define *last-dsets* 0)
(define *last-dhits* 0)
(define *last-dmisses* 0)
(define *last-devicted* 0)
(define *last-nkeys* 0)
(define *last-dexpired* 0)
(define *last-avg-ttl* 0)
(define *last-keys-ttl* 0)
(define *force-rechoose* #f)
(define *fitness-heals* 0)
(define *thresh-min-ops* 40)
(define *thresh-miss-pin* 30)
(define *threshold-mutates* 0)
(define *phase-hint* "unknown")
(define *ttl-pressure* #f) ; M9: short-TTL churn this tick
(define *soft-fires* 0) ; M10: soft-goal choose overrode expensive kernel
; M11 - slow online evolve loop (multi-generation threshold fitness)
(define *evolve-on* #f)
(define *evolve-max-gens* 6)
(define *evolve-window* 8)
(define *evolve-gen* 0)
(define *evolve-ticks* 0)
(define *evolve-mode* "baseline") ; baseline | trial | done
(define *evolve-fit-sum* 0)
(define *evolve-fit-n* 0)
(define *champ-min* 40)
(define *champ-miss* 30)
(define *champ-fit* 0)
(define *trial-min* 40)
(define *trial-miss* 30)
(define *evolve-keeps* 0)
(define *evolve-reverts* 0)
(define *evolve-logs* 0)
; A13 - signal weights (identity 10/2/10 matches pre-A13 evolve body)
(define *weight-evolve* #t)
(define *w-miss* 10)
(define *w-write* 2)
(define *w-evict* 10)
(define *champ-w-miss* 10)
(define *champ-w-write* 2)
(define *champ-w-evict* 10)
(define *trial-w-miss* 10)
(define *trial-w-write* 2)
(define *trial-w-evict* 10)
(define *weight-keeps* 0)
; A15 - swarm/PSO/FSS evolve propose backend (lazy require)
(define *evolve-backend* "hand") ; hand | pso | fss | grid
(define *swarm-ready* #f)
(define *swarm-propose-logs* 0)
; A16 - fiber shadow dual-score (no apply of loser)
(define *fiber-shadow* #f)
(define *shadow-scores* 0)
(define *shadow-wins* 0)
; A10 — shadow A/B sample (C hook + agent dual dry-run; never apply loser)
(define *shadow-ab* #f)
(define *shadow-profile* "aggressive")
(define *shadow-sample-pct* 10)
(define *shadow-ab-ticks* 0)
(define *shadow-ab-diverges* 0)
(define *shadow-ab-blocked* 0)
(define *shadow-c-ready* #f)
(define *prefer-slru* #f)
; M12/A5 - per-prefix policy hints + param bags from INFO policy_hints
(define *policy-hints* "")
(define *prefix-policy-on* #f)
(define *prefix-deep* #f) ; A5: conflicting lfu+pin vs ttl_aware (nopin)
(define *pfx0* "")
(define *pfx1* "")
(define *prof0* "")
(define *prof1* "")
(define *bag0* "") ; per-prefix choose/param bag (e.g. lfu|flat|pin)
(define *bag1* "")
(define *prefix-applies* 0)
(define *prefix-bag-version* 0)

(define *prev-gets* 0)
(define *prev-sets* 0)
(define *prev-hits* 0)
(define *prev-misses* 0)
(define *prev-evicted* 0)
(define *prev-expired* 0)
(define *have-prev* #f)
(define *hit-ewma* 0) ; simple hit% EWMA (0..100), agent-side concentration proxy

(define *t0* 0)
(define *phase* 0)
(define *did-invert* #f)
(define *did-heal* #f)

; P1.9 - HA: last applied kernels, reconnect/backoff, heartbeat
(define *last-evict* "")
(define *last-layout* "")
(define *reconnects* 0)
(define *backoff-ms* 50)
(define *backoff-cap* 4000)
(define *conn-alive* #f)
(define *heartbeat-file* "")
(define *pin-file* "") ; A6: durable policy pin across agent restart / promote
(define *profile-hash* "")
(define *pin-from-version* 0) ; prior process version recorded in pin
(define *pin-resumed* #f)
(define *pin-bootstrapped* #f)
(define *pin-last-payload* "")
; A8: auto-freeze meta-policy (cost gate) — still heal-able / unfreeze on miss spike
(define *auto-freeze-enabled* #f)
(define *meta-frozen* #f)
(define *tick-ms-base* 200)
(define *auto-freeze-stable-ticks* 12)
(define *auto-freeze-ewma-min* 80)
(define *auto-freeze-tick-ms* 0) ; 0 → 5× base
(define *auto-unfreeze-miss-pp* 35)
(define *stable-ticks* 0)
(define *info-polls* 0)
(define *freeze-count* 0)
(define *unfreeze-count* 0)
(define *fitness-before-freeze* #t)
(define *tick-wall0-ms* 0) ; for applies/sec in heartbeat
; A3: durable mutation audit ring (file) + last explain fields for heartbeat/INFO
(define *audit-file* "")
(define *audit-ring-max* 64)
(define *audit-count* 0)
(define *last-audit-op* "")
(define *last-audit-from* "")
(define *last-audit-to* "")
(define *last-audit-reason* "")
(define *last-audit-version* 0)
(define *last-audit-ts* 0)
(define *last-explain* "")
; A4: canary choose-fn trial window (commit or heal!)
(define *canary-on* #f)
(define *canary-ticks-n* 5)
(define *canary-mode* "idle") ; idle | trial
(define *canary-ticks* 0)
(define *canary-from* "")
(define *canary-to* "")
(define *canary-baseline-ewma* 0)
(define *canary-fit-sum* 0)
(define *canary-fit-n* 0)
(define *canary-commits* 0)
(define *canary-heals* 0)
(define *canary-inject* "")
(define *canary-inject-done* #f)
(define *canary-drop-pp* 12)
(define *canary-warm-ticks* 3)
(define *password* "")
(define *force-reconnect-after* 0)
(define *tick-count* 0)
(define *forced-reconnect-done* #f)
(define *policy-version* 0)
(define *ever-connected* #f)

; ── env ──
(let ((e (getenv "AURA_REDIS_HOST")))
  (if (and (string? e) (> (string-length e) 0)) (set! *host* e) #t))
(let ((e (getenv "AURA_REDIS_PORT")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *port* (string->number e))
    #t))
(set! *boot-guard-file*
  (string-append "/work/.ar-agent-booted-" (number->string *port*) ".flag"))

(let ((e (getenv "AURA_REDIS_POLICY_MS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *tick-ms* (string->number e))
    #t))
(set! *tick-ms-base* *tick-ms*)
(set! *auto-freeze-tick-ms* (* *tick-ms-base* 5))
(let ((e (getenv "AURA_REDIS_POLICY_DEMO")))
  (set! *demo*
    (and (string? e)
         (or (string=? e "1") (string=? e "true") (string=? e "yes")))))
(let ((e (getenv "AURA_REDIS_POLICY_PROFILE_FILE")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *profile-file* e)
    #t))
(let ((e (getenv "AURA_REDIS_SEED_PROFILE")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *seed-profile* e)
    #t))
(let ((e (getenv "AURA_REDIS_FROZEN")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")))
    (set! *fitness-on* #f)
    #t))
(let ((e (getenv "AURA_REDIS_AUTO_FREEZE")))
  (set! *auto-freeze-enabled*
    (and (string? e)
         (or (string=? e "1") (string=? e "true") (string=? e "yes")))))
(let ((e (getenv "AURA_REDIS_AUTO_FREEZE_STABLE_TICKS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *auto-freeze-stable-ticks* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_AUTO_FREEZE_EWMA_MIN")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *auto-freeze-ewma-min* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_AUTO_FREEZE_TICK_MS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *auto-freeze-tick-ms* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_AUTO_UNFREEZE_MISS_PP")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *auto-unfreeze-miss-pp* (string->number e))
    #t))
(if *auto-freeze-enabled*
  (begin
    (display "policy_agent: auto-freeze enabled stable_ticks=")
    (display *auto-freeze-stable-ticks*)
    (display " ewma_min=")
    (display *auto-freeze-ewma-min*)
    (display " freeze_tick_ms=")
    (display *auto-freeze-tick-ms*)
    (newline))
  (begin
    (display "policy_agent: auto-freeze off")
    (newline)))
(let ((e (getenv "AURA_REDIS_FITNESS_MUTATE")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *fitness-on*
      (not (or (string=? e "0") (string=? e "false") (string=? e "no")
               (string=? e "off"))))
    #t))
(let ((e (getenv "AURA_REDIS_EVOLVE")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")
               (string=? e "on")))
    (set! *evolve-on* #t)
    #t))
(let ((e (getenv "AURA_REDIS_THRESH_MIN_OPS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *thresh-min-ops* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_THRESH_MISS_PIN")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *thresh-miss-pin* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_EVOLVE_MAX_GENS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *evolve-max-gens* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_EVOLVE_WINDOW")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *evolve-window* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_EVOLVE_BACKEND")))
  (if (and (string? e) (> (string-length e) 0))
    (begin
      (set! *evolve-backend*
        (cond
          ((or (string=? e "swarm") (string=? e "pso")) "pso")
          ((string=? e "fss") "fss")
          ((string=? e "grid") "grid")
          (else "hand")))
      (display "policy_agent: evolve-backend=")
      (display *evolve-backend*)
      (newline))
    #t))
(let ((e (getenv "AURA_REDIS_WEIGHT_EVOLVE")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *weight-evolve*
      (not (or (string=? e "0") (string=? e "false") (string=? e "no")
               (string=? e "off"))))
    #t))
(let ((e (getenv "AURA_REDIS_W_MISS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *w-miss* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_W_WRITE")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *w-write* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_W_EVICT")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *w-evict* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_FIBER_SHADOW")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")
               (string=? e "on")))
    (begin
      (set! *fiber-shadow* #t)
      (display "policy_agent: fiber-shadow on (A16)\n"))
    #t))
(let ((e (getenv "AURA_REDIS_SHADOW_AB")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")
               (string=? e "on")))
    (begin
      (set! *shadow-ab* #t)
      (display "policy_agent: shadow-ab on (A10)\n"))
    #t))
(let ((e (getenv "AURA_REDIS_SHADOW_PROFILE")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *shadow-profile* e)
    #t))
(let ((e (getenv "AURA_REDIS_SHADOW_SAMPLE_PCT")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *shadow-sample-pct* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_PREFER_SLRU")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")
               (string=? e "on")))
    (begin
      (set! *prefer-slru* #t)
      (display "policy_agent: prefer-slru on (A12)\n"))
    #t))
(let ((e (getenv "AURA_REDIS_PASSWORD")))
  (if (and (string? e) (> (string-length e) 0))
    (set! *password* e)
    (let ((e2 (getenv "AURA_REDIS_REQUIREPASS")))
      (if (and (string? e2) (> (string-length e2) 0))
        (set! *password* e2)
        #t))))
(let ((e (getenv "AURA_REDIS_POLICY_HEARTBEAT")))
  (if (and (string? e) (> (string-length e) 0))
    (begin
      (set! *heartbeat-file* e)
      (display "policy_agent: heartbeat-file=")
      (display *heartbeat-file*)
      (newline))
    (begin
      (display "policy_agent: heartbeat-file=(none)")
      (newline))))
(let ((e (getenv "AURA_REDIS_POLICY_PIN")))
  (if (and (string? e) (> (string-length e) 0))
    (begin
      (set! *pin-file* e)
      (display "policy_agent: pin-file=")
      (display *pin-file*)
      (newline))
    (begin
      ; default beside heartbeat or under /work
      (set! *pin-file*
        (if (and (string? *heartbeat-file*) (> (string-length *heartbeat-file*) 0))
          (string-append *heartbeat-file* ".pin")
          (string-append "/work/.ar-policy-pin-" (number->string *port*) ".pin")))
      (display "policy_agent: pin-file=")
      (display *pin-file*)
      (newline))))
(let ((e (getenv "AURA_REDIS_POLICY_AUDIT")))
  (if (and (string? e) (> (string-length e) 0))
    (begin
      (set! *audit-file* e)
      (display "policy_agent: audit-file=")
      (display *audit-file*)
      (newline))
    (begin
      ; default under /work so host tests can read it
      (set! *audit-file*
        (string-append "/work/.ar-policy-audit-" (number->string *port*) ".log"))
      (display "policy_agent: audit-file=")
      (display *audit-file*)
      (newline))))
(let ((e (getenv "AURA_REDIS_CANARY")))
  (if (and (string? e)
           (or (string=? e "1") (string=? e "true") (string=? e "yes")
               (string=? e "on")))
    (set! *canary-on* #t)
    #t))
(let ((e (getenv "AURA_REDIS_CANARY_TICKS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *canary-ticks-n* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_CANARY_INJECT")))
  (if (and (string? e) (> (string-length e) 0))
    (begin
      (set! *canary-inject* e)
      (set! *canary-on* #t)
      (display "policy_agent: canary-inject=")
      (display *canary-inject*)
      (newline))
    #t))
(let ((e (getenv "AURA_REDIS_CANARY_DROP_PP")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *canary-drop-pp* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_POLICY_FORCE_RECONNECT_AFTER")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *force-reconnect-after* (string->number e))
    #t))
(let ((e (getenv "AURA_REDIS_POLICY_BACKOFF_CAP_MS")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (set! *backoff-cap* (string->number e))
    #t))

; Evolve owns threshold mutation - disable M6/M7 fitness profile swap path
(if *evolve-on*
  (set! *fitness-on* #f)
  #t)

; A11: when running Restricted (AURA_SANDBOX unset) or TRY_RESTRICTED_GRANTS,
; attempt explicit Network+Mutate grants (no Ffi). On this Aura pin without
; Tenant Admin, grant-effect! returns #f — agent then needs AURA_SANDBOX=off.
(let ((try-g (getenv "AURA_REDIS_TRY_RESTRICTED_GRANTS"))
      (sb (getenv "AURA_SANDBOX")))
  (if (or (and (string? try-g)
               (or (string=? try-g "1") (string=? try-g "true") (string=? try-g "yes")))
          (not (and (string? sb) (> (string-length sb) 0))))
    (begin
      (display "policy_agent: A11 try grant-effect network/mutate (no ffi)\n")
      (let ((gn (try (security:grant-effect! "network" 16) (catch (e) #f)))
            (gm (try (security:grant-effect! "mutate" 8) (catch (e) #f))))
        (display "policy_agent: grant-effect network=")
        (display gn)
        (display " mutate=")
        (display gm)
        (newline)
        (if (not gn)
          (display "policy_agent: A11 PARTIAL — network grant refused (need Tenant Admin or AURA_SANDBOX=off)\n")
          #t)
        #t))
    (begin
      (display "policy_agent: A11 sandbox profile Soft/off (grants implicit)\n")
      #t)))

; ── tiny string helpers ──
(define (find-substr s pat start)
  (let ((n (string-length s))
        (m (string-length pat))
        (i start)
        (found -1))
    (while (and (< i n) (< found 0))
      (begin
        (if (and (<= (+ i m) n)
                 (string=? (substring s i (+ i m)) pat))
          (set! found i)
          (set! i (+ i 1)))))
    found))

(define (info-get text key)
  (let ((pat (string-append key ":"))
        (pos (find-substr text (string-append key ":") 0)))
    (if (< pos 0)
      ""
      (let ((start (+ pos (string-length pat)))
            (end (find-substr text "\n" (+ pos (string-length pat)))))
        (if (< end 0)
          (substring text start (string-length text))
          (substring text start end))))))

(define (info-num text key)
  (let ((v (string->number (info-get text key))))
    (if (number? v) v 0)))

(define (busy-wait-ms ms)
  (let ((t0 (monotonic-ms)))
    (while (< (- (monotonic-ms) t0) ms) 0)
    #t))

;; M12/A5: parse "a:=session;b:=zipf" or "a:=lfu;b:=ttl_aware" from INFO
;; Profile → param bag (per-prefix namespace):
;;   lfu|zipf|hot → lfu|flat|pin (PIN tenant prefix)
;;   ttl_aware|ttl|session → ttl_aware|flat|pin (tenant durable still PIN'd;
;;     kernel prefers ttl_aware — conflict vs lfu resolved by compose)
;;   ttl_nopin → ttl_aware|flat (noise/session flood prefix — do NOT pin)
(define (prof-is-lfu-family? pr)
  (or (>= (find-substr pr "lfu" 0) 0)
      (>= (find-substr pr "slru" 0) 0)
      (>= (find-substr pr "tinylfu" 0) 0)
      (>= (find-substr pr "zipf" 0) 0)
      (>= (find-substr pr "hot" 0) 0)))

(define (prof-is-ttl-nopin? pr)
  ; only explicit ttl_nopin skips PIN (session *noise* prefix)
  (>= (find-substr pr "ttl_nopin" 0) 0))

(define (prof-is-session? pr)
  (>= (find-substr pr "session" 0) 0))

(define (prof-wants-ttl-kernel? pr)
  (or (prof-is-session? pr)
      (prof-is-ttl-nopin? pr)
      (>= (find-substr pr "ttl" 0) 0)))

(define (bag-for-profile pr)
  (cond
    ((prof-is-ttl-nopin? pr) "ttl_aware|flat")
    ((or (prof-is-session? pr)
         (>= (find-substr pr "ttl_aware" 0) 0)
         (string=? pr "ttl"))
     "ttl_aware|flat|pin")
    ((prof-is-lfu-family? pr)
     (if *prefer-slru* "slru|flat|pin" "lfu|flat|pin"))
    ((and (string? pr) (> (string-length pr) 0))
     (string-append pr "|flat|pin"))
    (else "")))

(define (bag-wants-pin? bag)
  (>= (find-substr bag "pin" 0) 0))

(define (refresh-prefix-bags!)
  (let ((b0 (bag-for-profile *prof0*))
        (b1 (bag-for-profile *prof1*)))
    (if (or (not (string=? b0 *bag0*)) (not (string=? b1 *bag1*)))
      (begin
        (set! *bag0* b0)
        (set! *bag1* b1)
        (if *prefix-policy-on*
          (set! *prefix-bag-version* (+ *prefix-bag-version* 1))
          #t))
      (begin
        (set! *bag0* b0)
        (set! *bag1* b1)))
    ; Deep isolation: conflicting bags — lfu+pin tenant vs ttl_aware tenant
    (set! *prefix-deep*
      (and *prefix-policy-on*
           (or (prof-is-lfu-family? *prof0*) (prof-is-lfu-family? *prof1*))
           (or (prof-wants-ttl-kernel? *prof0*) (prof-wants-ttl-kernel? *prof1*))))
    *prefix-deep*))

(define (parse-policy-hints! hints)
  (set! *policy-hints* (if (string? hints) hints ""))
  (let ((old0 *pfx0*) (old1 *pfx1*) (op0 *prof0*) (op1 *prof1*))
    (set! *pfx0* "")
    (set! *pfx1* "")
    (set! *prof0* "")
    (set! *prof1* "")
    (set! *prefix-policy-on* #f)
    (set! *prefix-deep* #f)
    (if (or (not (string? hints)) (= (string-length hints) 0))
      (begin
        (set! *bag0* "")
        (set! *bag1* "")
        #f)
      (let ((slot 0)
            (start 0)
            (n (string-length hints))
            (i 0))
        (while (<= i n)
          (if (or (= i n)
                  (and (< i n) (string=? (substring hints i (+ i 1)) ";")))
            (begin
              (if (> i start)
                (let ((piece (substring hints start i)))
                  (let ((peq (find-substr piece "=" 0)))
                    (if (>= peq 0)
                      (let ((px (substring piece 0 peq))
                            (pr (substring piece (+ peq 1) (string-length piece))))
                        (if (= slot 0)
                          (begin (set! *pfx0* px) (set! *prof0* pr))
                          (if (= slot 1)
                            (begin (set! *pfx1* px) (set! *prof1* pr))
                            #t))
                        (set! slot (+ slot 1))
                        (set! *prefix-policy-on* #t))
                      #t)))
                #t)
              (set! start (+ i 1))
              (set! i (+ i 1)))
            (set! i (+ i 1))))
        (refresh-prefix-bags!)
        *prefix-policy-on*))))

(define (prefix-has-session?)
  (or (prof-is-session? *prof0*)
      (prof-is-session? *prof1*)
      (prof-wants-ttl-kernel? *prof0*)
      (prof-wants-ttl-kernel? *prof1*)))

(define (prefix-has-zipf?)
  (or (prof-is-lfu-family? *prof0*)
      (prof-is-lfu-family? *prof1*)))

; A5: compose global EVICT|LAYOUT|pin from per-prefix bags (C kernel still one)
(define (compose-prefix-choice)
  (let ((want-ttl (or (prof-wants-ttl-kernel? *prof0*)
                      (prof-wants-ttl-kernel? *prof1*)))
        (want-lfu (or (prof-is-lfu-family? *prof0*)
                      (prof-is-lfu-family? *prof1*)))
        (want-pin (or (bag-wants-pin? *bag0*) (bag-wants-pin? *bag1*))))
    (cond
      ((and want-ttl want-pin) "ttl_aware|flat|pin")
      (want-ttl "ttl_aware|flat")
      ((and want-lfu want-pin)
       (if *prefer-slru* "slru|flat|pin" "lfu|flat|pin"))
      (want-lfu (if *prefer-slru* "slru|flat" "lfu|flat"))
      (want-pin (if *prefer-slru* "slru|flat|pin" "lfu|flat|pin"))
      (else ""))))

; ── RESP client (encode array of bulk strings; parse simple/bulk/err) ──
(define (resp-encode-bulk s)
  (string-append "$" (number->string (string-length s)) "\r\n" s "\r\n"))

(define (resp-encode-cmd args)
  (let ((out (string-append "*" (number->string (length args)) "\r\n"))
        (xs args))
    (while (pair? xs)
      (begin
        (set! out (string-append out (resp-encode-bulk (car xs))))
        (set! xs (cdr xs))))
    out))

(define (resp-parse-one buf)
  ; returns (list consumed value) or #f if incomplete; value may be string / "OK" / error string prefixed ERR
  (if (or (not (string? buf)) (= (string-length buf) 0))
    #f
    (let ((t (substring buf 0 1)))
      (cond
        ((or (string=? t "+") (string=? t "-") (string=? t ":"))
         (let ((cr (find-substr buf "\r\n" 0)))
           (if (< cr 0)
             #f
             (list (+ cr 2)
                   (if (string=? t "-")
                     (string-append "ERR " (substring buf 1 cr))
                     (substring buf 1 cr))))))
        ((string=? t "$")
         (let ((cr (find-substr buf "\r\n" 0)))
           (if (< cr 0)
             #f
             (let ((n (string->number (substring buf 1 cr))))
               (if (not (number? n))
                 #f
                 (if (< n 0)
                   (list (+ cr 2) "")
                   (let ((start (+ cr 2))
                         (end (+ (+ cr 2) n)))
                     (if (< (string-length buf) (+ end 2))
                       #f
                       (list (+ end 2) (substring buf start end))))))))))
        (else #f)))))

(define (redis-call! sock . args)
  (let ((wire (resp-encode-cmd args))
        (sent (tcp-send sock wire)))
    (if (or (not (number? sent)) (< sent 0))
      (begin
        (set! *conn-alive* #f)
        "ERR closed")
      (let ((buf "")
            (done #f)
            (result ""))
        (while (not done)
          (begin
            (let ((chunk (tcp-recv sock 65536)))
              (if (or (not (string? chunk)) (= (string-length chunk) 0))
                (begin
                  (set! *conn-alive* #f)
                  (set! done #t)
                  (set! result "ERR closed"))
                (begin
                  (set! buf (string-append buf chunk))
                  (let ((parsed (resp-parse-one buf)))
                    (if parsed
                      (begin
                        (set! result (cadr parsed))
                        (set! done #t))
                      #t)))))))
        result))))

; ── pin helpers (best-effort; PIN list is RESP array - agent may not parse it) ──
(define (pad4 n)
  (cond
    ((< n 10) (string-append "000" (number->string n)))
    ((< n 100) (string-append "00" (number->string n)))
    ((< n 1000) (string-append "0" (number->string n)))
    (else (number->string n))))

(define (pin-prefix-set! sock prefix n)
  (let ((i 0))
    (while (< i n)
      (begin
        ; ignore missing-key errors - redis-call! returns ERR string
        (redis-call! sock "PIN" (string-append prefix (pad4 i)))
        (set! i (+ i 1))))
    #t))

(define (unpin-prefix-set! sock prefix n)
  (let ((i 0))
    (while (< i n)
      (begin
        (redis-call! sock "UNPIN" (string-append prefix (pad4 i)))
        (set! i (+ i 1))))
    #t))

;; ── profile file → hot-strategy:swap! (product path for demo-mvp invert/heal) ──
(define (trim-ws s)
  (let ((n (string-length s))
        (i 0)
        (j 0))
    (set! j n)
    (while (and (< i n)
                (let ((c (substring s i (+ i 1))))
                  (or (string=? c " ") (string=? c "\n")
                      (string=? c "\r") (string=? c "\t"))))
      (set! i (+ i 1)))
    (while (and (> j i)
                (let ((c (substring s (- j 1) j)))
                  (or (string=? c " ") (string=? c "\n")
                      (string=? c "\r") (string=? c "\t"))))
      (set! j (- j 1)))
    (if (>= i j) "" (substring s i j))))

(define (body-for-profile name)
  (cond
    ((string=? name "aggressive") *policy-choose-aggressive*)
    ((string=? name "conservative") *policy-choose-conservative*)
    ((string=? name "inverted") *policy-choose-inverted*)
    ((string=? name "broken") *policy-choose-broken*)
    ((string=? name "nosoft") *policy-choose-nosoft*)
    (else *policy-choose-normal*)))

;; M7 - mutate numeric thresholds inside choose-fn body string (Aura-native)
(define (build-threshold-body min-ops miss-pin)
  (string-append
    "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) "
    "(let ((ops (+ dgets dsets))) "
    "(if (< ops " (number->string min-ops) ") \"\" "
    "(let ((hit-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dhits) (+ dhits dmisses)) 0)) "
    "(miss-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dmisses) (+ dhits dmisses)) 0)) "
    "(ttl-share (if (> nkeys 0) (quotient (* 100 keys_ttl) nkeys) 0)) "
    "(erate (if (> ops 0) (quotient (* 100 devicted) ops) 0))) "
    "(cond "
    ""
    "((>= erate 20) (if (and (> keys_ttl 0) (< avg_ttl 12000)) "
    "\"ttl_aware|flat\" \"lru|flat\")) "
    "((and (> keys_ttl 0) (< avg_ttl 12000) (or (>= ttl-share 20) (> keys_ttl 15))) "
    "\"ttl_aware|flat\") "
    "((and (>= dsets dgets) (> miss-pct " (number->string miss-pin) ") (> nkeys 0)) "
    "\"lfu|flat|pin\") "
    "((> dsets (* dgets 2)) \"lfu|flat\") "
    "((and (> devicted 0) (> miss-pct " (number->string (+ miss-pin 10)) ")) "
    "\"lfu|flat|pin\") "
    "((and (> dgets (* dsets 3)) (>= hit-pct 50)) \"lru|flat\") "
    "((and (> dgets (* dsets 2)) (< hit-pct 55) (> miss-pct 15)) \"lru|flat\") "
    "((and (> dgets (* dsets 5)) (>= hit-pct 60)) \"lru|flat\") "
    "(else \"\"))))))"))

(define (do-fitness-threshold-mutate! reason)
  (let ((old-min *thresh-min-ops*)
        (old-miss *thresh-miss-pin*)
        (new-min (if (> *thresh-min-ops* 18) (- *thresh-min-ops* 12) *thresh-min-ops*))
        (new-miss (if (> *thresh-miss-pin* 16) (- *thresh-miss-pin* 8) *thresh-miss-pin*)))
    (if (and (= new-min old-min) (= new-miss old-miss))
      #f
      (if (not (mutate:boundary-safe?))
        (begin
          (display "policy_agent: skip threshold-mutate (boundary not safe)\n")
          #f)
        (begin
          (mutate:safety-snapshot)
          (set! *thresh-min-ops* new-min)
          (set! *thresh-miss-pin* new-miss)
          (let ((body (build-threshold-body new-min new-miss))
                (r #f))
            (set! r (hot-strategy:swap! "choose-fn" body "fitness-thresholds"))
            (display "policy_agent: fitness-threshold-mutate min-ops=")
            (display old-min)
            (display "→")
            (display new-min)
            (display " miss-pin=")
            (display old-miss)
            (display "→")
            (display new-miss)
            (display " reason=")
            (display reason)
            (display " result=")
            (display r)
            (newline)
            (set! *threshold-mutates* (+ *threshold-mutates* 1))
            (set! *swaps* (+ *swaps* 1))
            (set! *fitness-swaps* (+ *fitness-swaps* 1))
            (set! *ticks-since-fitness* 0)
            (set! *profile-name* "thresholded")
            #t))))))

;; M11/A13 - evolve body: thresholds + signal weights (not only min-ops).
;; Identity weights w-miss=10 w-write=2 w-evict=10 match pre-A13 semantics.
;; A15: optional swarm/PSO/FSS propose backend (proxy fitness → trial apply).
(define (build-evolve-body min-ops miss-pin w-miss w-write w-evict)
  ; No read-heavy→lru rule: once LFU+pin lands, stay pinned across GET measure.
  (string-append
    "(lambda (dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) "
    "(let ((ops (+ dgets dsets))) "
    "(if (< ops " (number->string min-ops) ") \"\" "
    "(let ((miss-pct (if (> (+ dhits dmisses) 0) "
    "(quotient (* 100 dmisses) (+ dhits dmisses)) 0)) "
    "(w-miss " (number->string w-miss) ") "
    "(w-write " (number->string w-write) ") "
    "(w-evict " (number->string w-evict) ")) "
    "(cond "
    "((and (>= dsets dgets) (> (* miss-pct w-miss) (* "
    (number->string miss-pin) " 10)) (> nkeys 0)) "
    "\"lfu|flat|pin\") "
    "((> dsets (* dgets w-write)) \"lfu|flat\") "
    "((and (> devicted 0) (> (* miss-pct w-evict) (* "
    (number->string (+ miss-pin 10)) " 10))) "
    "\"lfu|flat|pin\") "
    "(else \"\"))))))"))

(define (evolve-clamp-int x lo hi)
  (let ((n (if (number? x)
             (inexact->exact (round x))
             lo)))
    (cond
      ((< n lo) lo)
      ((> n hi) hi)
      (else n))))

(define (evolve-apply-body! min-ops miss-pin w-miss w-write w-evict tag)
  ; A2: mutate:rebind only (avoid hot-strategy:swap! → eval-current stall).
  ; When thresholds are fireable, inline LFU+PIN like A1 fitness-swap.
  (if (not (mutate:boundary-safe?))
    (begin
      (display "policy_agent: skip evolve-apply (boundary not safe)\n")
      #f)
    (begin
      (mutate:safety-snapshot)
      (let ((body (build-evolve-body min-ops miss-pin w-miss w-write w-evict))
            (ok #f))
        (set! ok
          (try
            (begin
              (mutate:rebind "choose-fn" body tag)
              #t)
            (catch (e) #f)))
        (display "policy_agent: evolve-apply ")
        (display tag)
        (display " min-ops=")
        (display min-ops)
        (display " miss-pin=")
        (display miss-pin)
        (display " w-miss=")
        (display w-miss)
        (display " w-write=")
        (display w-write)
        (display " w-evict=")
        (display w-evict)
        (display " ok=")
        (display ok)
        (newline)
        (if ok
          (begin
            (set! *thresh-min-ops* min-ops)
            (set! *thresh-miss-pin* miss-pin)
            (set! *w-miss* w-miss)
            (set! *w-write* w-write)
            (set! *w-evict* w-evict)
            (set! *profile-name* "evolved")
            (set! *swaps* (+ *swaps* 1))
            (if (and (<= min-ops 80) (number? *sock*))
              (begin
                (display "policy_agent: EVICT (evolve-apply inline) -> lfu\n")
                (redis-call! *sock* "EVICT" "lfu")
                (set! *last-evict* "lfu")
                (redis-call! *sock* "LAYOUT" "flat")
                (set! *last-layout* "flat")
                (display "policy_agent: PIN hot set (evolve-apply inline)\n")
                (redis-call! *sock* "EVICT" "samples" "64")
                (pin-prefix-set! *sock* "hot" 40)
                (pin-prefix-set! *sock* "z" 24)
                (set! *applies* (+ *applies* 3))
                #t)
              #t)
            #t)
          #f)))))

(define (evolve-ensure-swarm!)
  ; A15: lazy require std/swarm only when backend ≠ hand (avoid boot cost).
  (if *swarm-ready*
    #t
    (begin
      (require "std/swarm" all:)
      (let ((kind (if (string=? *evolve-backend* "hand") "pso" *evolve-backend*)))
        (swarm:init (hash "kind" kind
                          "dim" 5
                          "pop" 8
                          "bounds" (list
                                     (list 24.0 900.0)
                                     (list 12.0 80.0)
                                     (list 1.0 20.0)
                                     (list 1.0 5.0)
                                     (list 1.0 20.0))
                          "seed" 424242))
        (set! *swarm-ready* #t)
        (display "policy_agent: evolve-backend swarm-init kind=")
        (display (swarm:kind))
        (display " pop=")
        (display 8)
        (newline)
        #t))))

(define (evolve-proxy-fit ind)
  ; Higher better: fireable (low min-ops) + strong miss/evict weights + low write ratio.
  (let ((mn (car ind))
        (ms (car (cdr ind)))
        (wm (car (cdr (cdr ind))))
        (ww (car (cdr (cdr (cdr ind)))))
        (we (car (cdr (cdr (cdr (cdr ind)))))))
    (+ (- 0.0 (/ mn 5.0))
       (- 0.0 ms)
       (* 3.0 wm)
       (- 0.0 (* 8.0 ww))
       (* 2.0 we))))

(define (evolve-propose-swarm)
  (evolve-ensure-swarm!)
  (swarm:step! evolve-proxy-fit)
  (let ((best (swarm:best)))
    (set! *swarm-propose-logs* (+ *swarm-propose-logs* 1))
    (display "policy_agent: evolve swarm-gen=")
    (display (swarm:gen))
    (display " best=")
    (display best)
    (display " export=")
    (display (swarm:export))
    (newline)
    (set! *trial-min* (evolve-clamp-int (car best) 24 900))
    (set! *trial-miss* (evolve-clamp-int (car (cdr best)) 12 80))
    (set! *trial-w-miss* (evolve-clamp-int (car (cdr (cdr best))) 1 20))
    (set! *trial-w-write* (evolve-clamp-int (car (cdr (cdr (cdr best)))) 1 5))
    (set! *trial-w-evict* (evolve-clamp-int (car (cdr (cdr (cdr (cdr best))))) 1 20))
    ; Prefer strictly different from champion so keep/revert has contrast
    (if (and (= *trial-min* *champ-min*)
             (= *trial-miss* *champ-miss*)
             (= *trial-w-miss* *champ-w-miss*)
             (= *trial-w-write* *champ-w-write*)
             (= *trial-w-evict* *champ-w-evict*))
      (begin
        (set! *trial-min* (if (> *champ-min* 24)
                            (let ((h (quotient *champ-min* 2)))
                              (if (< h 24) 24 h))
                            *champ-min*))
        (if *weight-evolve*
          (set! *trial-w-miss* (if (< *champ-w-miss* 20) (+ *champ-w-miss* 2) *champ-w-miss*))
          #t)
        (not (and (= *trial-min* *champ-min*)
                  (= *trial-w-miss* *champ-w-miss*))))
      #t)))

(define (evolve-propose-hand)
  ; A2: aggressive step-down (halve min-ops, floor 24) so 2-3 gens reach
  ; fireable thresholds under short evolve_gain windows (was -140 → stuck >600).
  ; A13: also mutate signal weights toward stronger miss/evict, lower write-ratio.
  (let ((nm (if (> *champ-min* 24)
              (let ((h (quotient *champ-min* 2)))
                (if (< h 24) 24 h))
              *champ-min*))
        (ns (if (> *champ-miss* 12)
              (let ((h (quotient *champ-miss* 2)))
                (if (< h 12) 12 h))
              *champ-miss*))
        (nwm (if (and *weight-evolve* (< *champ-w-miss* 20))
               (+ *champ-w-miss* 2)
               *champ-w-miss*))
        (nww (if (and *weight-evolve* (> *champ-w-write* 1))
               (- *champ-w-write* 1)
               *champ-w-write*))
        (nwe (if (and *weight-evolve* (< *champ-w-evict* 20))
               (+ *champ-w-evict* 2)
               *champ-w-evict*)))
    (if (and (= nm *champ-min*) (= ns *champ-miss*)
             (= nwm *champ-w-miss*) (= nww *champ-w-write*) (= nwe *champ-w-evict*))
      #f
      (begin
        (set! *trial-min* nm)
        (set! *trial-miss* ns)
        (set! *trial-w-miss* nwm)
        (set! *trial-w-write* nww)
        (set! *trial-w-evict* nwe)
        #t))))

(define (evolve-propose-next)
  (if (string=? *evolve-backend* "hand")
    (evolve-propose-hand)
    (try
      (evolve-propose-swarm)
      (catch (e)
        (begin
          (display "policy_agent: evolve swarm-propose failed → hand fallback err=")
          (display e)
          (newline)
          (set! *evolve-backend* "hand")
          (evolve-propose-hand))))))

(define (evolve-log! action fit)
  (display "policy_agent: evolve gen=")
  (display *evolve-gen*)
  (display " fitness=")
  (display fit)
  (display " champ_fit=")
  (display *champ-fit*)
  (display " action=")
  (display action)
  (display " backend=")
  (display *evolve-backend*)
  (display " min-ops=")
  (display *thresh-min-ops*)
  (display " miss-pin=")
  (display *thresh-miss-pin*)
  (display " w-miss=")
  (display *w-miss*)
  (display " w-write=")
  (display *w-write*)
  (display " w-evict=")
  (display *w-evict*)
  (display " trial=")
  (display *trial-min*)
  (display "/")
  (display *trial-miss*)
  (display "/w=")
  (display *trial-w-miss*)
  (display "/")
  (display *trial-w-write*)
  (display "/")
  (display *trial-w-evict*)
  (display " champ=")
  (display *champ-min*)
  (display "/")
  (display *champ-miss*)
  (display "/w=")
  (display *champ-w-miss*)
  (display "/")
  (display *champ-w-write*)
  (display "/")
  (display *champ-w-evict*)
  (newline)
  (set! *evolve-logs* (+ *evolve-logs* 1))
  #t)

;; A10 — shadow A/B dry-run + C sample setup (never apply loser kernels)
(define (shadow-choice-kernel c)
  (if (or (not (string? c)) (= (string-length c) 0))
    ""
    (let ((bar (find-substr c "|" 0)))
      (if (>= bar 0) (substring c 0 bar) c))))

(define (shadow-alt-choice)
  (cond
    ((string=? *shadow-profile* "aggressive") "lfu|flat|pin")
    ((string=? *shadow-profile* "inverted") "lru|flat")
    ((string=? *shadow-profile* "conservative") "lru|flat")
    ((string=? *shadow-profile* "nosoft") "lfu|flat")
    ((string=? *shadow-profile* "slru") "slru|flat|pin")
    (else "lru|flat")))

(define (shadow-c-setup!)
  (if (or (not *shadow-ab*) *shadow-c-ready* (not *sock*))
    #f
    (begin
      (try (redis-call! *sock* "SHADOW" "policy" *shadow-profile*)
           (catch (e) #f))
      (try (redis-call! *sock* "SHADOW" "sample-pct"
                        (number->string *shadow-sample-pct*))
           (catch (e) #f))
      (set! *shadow-c-ready* #t)
      (display "policy_agent: shadow-c setup policy=")
      (display *shadow-profile*)
      (display " sample-pct=")
      (display *shadow-sample-pct*)
      (newline)
      #t)))

(define (shadow-ab-tick! champ-choice)
  (set! *shadow-ab-ticks* (+ *shadow-ab-ticks* 1))
  (let ((alt-choice (shadow-alt-choice))
        (ck (shadow-choice-kernel champ-choice))
        (ak (shadow-choice-kernel (shadow-alt-choice))))
    (if (and (> (string-length ck) 0) (> (string-length ak) 0)
             (not (string=? ck ak)))
      (begin
        (set! *shadow-ab-diverges* (+ *shadow-ab-diverges* 1))
        (try (redis-call! *sock* "SHADOW" "diverge") (catch (e) #f))
        (display "policy_agent: shadow-ab champ=")
        (display champ-choice)
        (display " alt=")
        (display alt-choice)
        (display " (dry-run no EVICT loser)\n")
        (set! *shadow-ab-blocked* (+ *shadow-ab-blocked* 1))
        #t)
      #t)))

;; A16 — fiber parallel trial fitness: score dual param bags in fibers
;; without applying the loser (shadow). Proxy score = fireability heuristic;
;; live window keep/revert still owns apply. No body-string eval (pipeline).
(define (shadow-proxy-score min-ops miss-pin w-miss w-write w-evict)
  (+ (- 0.0 (/ min-ops 5.0))
     (- 0.0 miss-pin)
     (* 3.0 w-miss)
     (- 0.0 (* 8.0 w-write))
     (* 2.0 w-evict)))

(define (fiber-shadow-score! c-min c-miss c-wm c-ww c-we
                             t-min t-miss t-wm t-ww t-we)
  (if (not *fiber-shadow*)
    #f
    (begin
      (set! *shadow-scores* (+ *shadow-scores* 1))
      (let ((fa (fiber:spawn
                  (lambda ()
                    (shadow-proxy-score c-min c-miss c-wm c-ww c-we))))
            (fb (fiber:spawn
                  (lambda ()
                    (shadow-proxy-score t-min t-miss t-wm t-ww t-we)))))
        (let ((sa (fiber:join fa))
              (sb (fiber:join fb)))
          (display "policy_agent: fiber-shadow champ=")
          (display sa)
          (display " trial=")
          (display sb)
          (display " (no apply loser)\n")
          (let ((trial-better (and (number? sb) (number? sa) (> sb sa))))
            (if trial-better
              (set! *shadow-wins* (+ *shadow-wins* 1))
              #t)
            trial-better))))))

;; Slow online evolve: window fitness → keep if better else revert (heal path).
(define (maybe-evolve!)
  (if (or (not *evolve-on*) (string=? *evolve-mode* "done"))
    #f
    (begin
      (set! *evolve-ticks* (+ *evolve-ticks* 1))
      (set! *evolve-fit-sum* (+ *evolve-fit-sum* *hit-ewma*))
      (set! *evolve-fit-n* (+ *evolve-fit-n* 1))
      (if (< *evolve-ticks* *evolve-window*)
        #f
        (let ((fit (if (> *evolve-fit-n* 0)
                     (quotient *evolve-fit-sum* *evolve-fit-n*)
                     0)))
          (set! *evolve-ticks* 0)
          (set! *evolve-fit-sum* 0)
          (set! *evolve-fit-n* 0)
          (cond
            ((string=? *evolve-mode* "baseline")
             (begin
               (set! *champ-fit* fit)
               (set! *champ-min* *thresh-min-ops*)
               (set! *champ-miss* *thresh-miss-pin*)
               (set! *champ-w-miss* *w-miss*)
               (set! *champ-w-write* *w-write*)
               (set! *champ-w-evict* *w-evict*)
               (evolve-log! "baseline" fit)
               (if (evolve-propose-next)
                 (begin
                   ; A16 optional: score trial vs champ bodies before apply
                   (if *fiber-shadow*
                     (fiber-shadow-score!
                       *champ-min* *champ-miss*
                       *champ-w-miss* *champ-w-write* *champ-w-evict*
                       *trial-min* *trial-miss*
                       *trial-w-miss* *trial-w-write* *trial-w-evict*)
                     #t)
                   (evolve-apply-body! *trial-min* *trial-miss*
                                       *trial-w-miss* *trial-w-write* *trial-w-evict*
                                       "evolve-trial")
                   (set! *evolve-mode* "trial")
                   (evolve-log! "propose" fit))
                 (begin
                   (set! *evolve-mode* "done")
                   (evolve-log! "done-no-move" fit)))
               #t))
            ((string=? *evolve-mode* "trial")
             (begin
               (if (>= fit *champ-fit*)
                 (begin
                   (set! *champ-fit* fit)
                   (set! *champ-min* *trial-min*)
                   (set! *champ-miss* *trial-miss*)
                   (set! *champ-w-miss* *trial-w-miss*)
                   (set! *champ-w-write* *trial-w-write*)
                   (set! *champ-w-evict* *trial-w-evict*)
                   (set! *evolve-keeps* (+ *evolve-keeps* 1))
                   (if (or (not (= *trial-w-miss* 10))
                           (not (= *trial-w-write* 2))
                           (not (= *trial-w-evict* 10)))
                     (set! *weight-keeps* (+ *weight-keeps* 1))
                     #t)
                   (audit-append! "evolve-keep"
                                  (number->string *champ-min*)
                                  (number->string *trial-min*)
                                  "evolve_keep")
                   (evolve-log! "keep" fit))
                 (begin
                   ; revert / heal to champion thresholds+weights
                   (evolve-apply-body! *champ-min* *champ-miss*
                                       *champ-w-miss* *champ-w-write* *champ-w-evict*
                                       "evolve-revert")
                   (set! *heals* (+ *heals* 1))
                   (set! *evolve-reverts* (+ *evolve-reverts* 1))
                   (evolve-log! "revert" fit)))
               (set! *evolve-gen* (+ *evolve-gen* 1))
               (if (>= *evolve-gen* *evolve-max-gens*)
                 (begin
                   (set! *evolve-mode* "done")
                   (evolve-log! "done" fit))
                 (if (evolve-propose-next)
                   (begin
                     (evolve-apply-body! *trial-min* *trial-miss*
                                         *trial-w-miss* *trial-w-write* *trial-w-evict*
                                         "evolve-trial")
                     (set! *evolve-mode* "trial")
                     (evolve-log! "propose" fit))
                   (begin
                     (set! *evolve-mode* "done")
                     (evolve-log! "done-floor" fit))))
               #t))
            (else #f)))))))

(define (phase-hint-of dgets dsets dhits dmisses)
  (cond
    ((and (>= dsets dgets) (> dmisses dhits)) "miss_spike")
    ((> dsets (* dgets 2)) "write_heavy")
    ((> dgets (* dsets 3)) "read_heavy")
    ((> dmisses (* dhits 2)) "miss_spike")
    (else "mixed")))

(define (fitness-target-profile)
  (cond
    ((or (string=? *profile-name* "inverted")
         (string=? *profile-name* "broken")
         (string=? *profile-name* "conservative"))
     "aggressive")
    ((string=? *profile-name* "normal") "aggressive")
    ((string=? *profile-name* "aggressive") "normal")
    (else "normal")))

(define (do-fitness-swap! to-name reason)
  ; A4: when canary enabled and idle, trial via canary-start! instead of
  ; immediate commit. During an active canary trial, skip further swaps.
  (if (canary-active?)
    (begin
      (display "policy_agent: skip fitness-swap (canary trial active)\n")
      #f)
    (if (and *canary-on* (not (canary-active?)))
      (canary-start! to-name reason)
      (do-fitness-swap-commit! to-name reason))))

(define (do-fitness-swap-commit! to-name reason)
  ; A1: use mutate:rebind ONLY - hot-strategy:swap! also eval-current, which
  ; re-enters this file and stalls/resets the live tick loop (mutate≈frozen).
  ; denseness still via mutate:rebind of choose-fn body string.
  (if (not (mutate:boundary-safe?))
    (begin
      (display "policy_agent: skip fitness-swap (boundary not safe)\n")
      #f)
    (begin
      (mutate:safety-snapshot)
      (let ((from *profile-name*)
            (body (body-for-profile to-name))
            (ok #f))
        (set! ok
          (try
            (begin
              (mutate:rebind "choose-fn" body (string-append "fitness-" to-name))
              #t)
            (catch (e) #f)))
        (display "policy_agent: fitness-swap ")
        (display from)
        (display "→")
        (display to-name)
        (display " reason=")
        (display reason)
        (display " result=")
        (display ok)
        (newline)
        (if ok
          (begin
            (set! *profile-name* to-name)
            (set! *swaps* (+ *swaps* 1))
            (set! *fitness-swaps* (+ *fitness-swaps* 1))
            (set! *ticks-since-fitness* 0)
            (set! *post-swap-bad* 0)
            (set! *force-rechoose* #t)
            (audit-append! "fitness-swap" from to-name reason)
            ; A1: apply LFU+PIN immediately in THIS stack frame. mutate:rebind
            ; re-evals the file (nested); waiting for a later tick is unreliable.
            (if (and (string=? to-name "aggressive") (number? *sock*))
              (begin
                (display "policy_agent: EVICT (fitness-swap inline) -> lfu\n")
                (redis-call! *sock* "EVICT" "lfu")
                (set! *last-evict* "lfu")
                (redis-call! *sock* "LAYOUT" "flat")
                (set! *last-layout* "flat")
                (display "policy_agent: PIN hot set (fitness-swap inline)\n")
                (redis-call! *sock* "EVICT" "samples" "64")
                (pin-prefix-set! *sock* "hot" 40)
                (pin-prefix-set! *sock* "z" 24)
                (set! *applies* (+ *applies* 3))
                #t)
              #t)
            #t)
          #f)))))

(define (do-fitness-heal! reason)
  (if (canary-active?)
    (begin
      (display "policy_agent: fitness-heal deferred to canary\n")
      (canary-heal! reason))
    (do-fitness-heal-inner! reason)))

(define (do-fitness-heal-inner! reason)
  (display "policy_agent: fitness-heal! reason=")
  (display reason)
  (display " from=")
  (display *profile-name*)
  (newline)
  (display "policy_agent: hot-strategy:heal!\n")
  (hot-strategy:heal!)
  (set! *heals* (+ *heals* 1))
  (set! *fitness-heals* (+ *fitness-heals* 1))
  (set! *profile-name* *last-good-profile*)
  (set! *ticks-since-fitness* 0)
  (set! *post-swap-bad* 0)
  (set! *ticks-bad* 0)
  #t)

;; A8 — auto-freeze meta-policy: when EWMA stable, lengthen tick + fitness-off
;; (still unfreeze / heal-able on miss spike). Cost gate for controller overhead.
(define (enter-auto-freeze! reason)
  ; Meta-freeze without mutate:rebind / eval-current (A1 stall). Tick stretch +
  ; fitness-off is the cost gate; still heal-able / unfreeze on miss spike.
  (if *meta-frozen*
    #f
    (begin
      (set! *meta-frozen* #t)
      (set! *fitness-before-freeze* *fitness-on*)
      (set! *fitness-on* #f)
      (set! *tick-ms* *auto-freeze-tick-ms*)
      (set! *freeze-count* (+ *freeze-count* 1))
      (set! *stable-ticks* 0)
      (display "policy_agent: auto_freeze reason=")
      (display reason)
      (display " tick_ms=")
      (display *tick-ms*)
      (display " ewma=")
      (display *hit-ewma*)
      (display " profile=")
      (display *profile-name*)
      (newline)
      (audit-append! "auto_freeze" "active" "frozen" reason)
      (write-heartbeat!)
      #t)))

(define (exit-auto-freeze! reason)
  (if (not *meta-frozen*)
    #f
    (begin
      (set! *meta-frozen* #f)
      (set! *fitness-on* *fitness-before-freeze*)
      (set! *tick-ms* *tick-ms-base*)
      (set! *unfreeze-count* (+ *unfreeze-count* 1))
      (set! *stable-ticks* 0)
      (display "policy_agent: auto_unfreeze reason=")
      (display reason)
      (display " tick_ms=")
      (display *tick-ms*)
      (display " ewma=")
      (display *hit-ewma*)
      (newline)
      (audit-append! "auto_unfreeze" "frozen" "active" reason)
      (write-heartbeat!)
      #t)))

(define (maybe-auto-freeze! dgets dsets dhits dmisses)
  (if (not *auto-freeze-enabled*)
    #f
    (let ((ops (+ dgets dsets))
          (win (+ dhits dmisses))
          (miss-pct (if (> (+ dhits dmisses) 0)
                      (quotient (* 100 dmisses) (+ dhits dmisses))
                      0)))
      (cond
        (*meta-frozen*
         (if (and (> win 8) (>= miss-pct *auto-unfreeze-miss-pp*))
           (exit-auto-freeze! "miss_spike")
           (if (and (> win 8) (< *hit-ewma* (- *auto-freeze-ewma-min* 25)))
             (exit-auto-freeze! "ewma_drop")
             #f)))
        (else
         (if (and (>= *hit-ewma* *auto-freeze-ewma-min*)
                  (>= ops 5)
                  (< miss-pct 20))
           (set! *stable-ticks* (+ *stable-ticks* 1))
           (set! *stable-ticks* 0))
         (if (>= *stable-ticks* *auto-freeze-stable-ticks*)
           (enter-auto-freeze! "ewma_stable")
           #f))))))

;; Fitness-driven mutation: hit-EWMA drop / miss spike / stuck →
;; hot-strategy:swap! profile; if still bad → heal! to last-good.
(define (maybe-fitness-mutate! dgets dsets dhits dmisses devicted)
  (set! *ticks-since-fitness* (+ *ticks-since-fitness* 1))
  (if (not *fitness-on*)
    #f
    (let ((ops (+ dgets dsets))
          (win (+ dhits dmisses))
          (miss-pct (if (> (+ dhits dmisses) 0)
                      (quotient (* 100 dmisses) (+ dhits dmisses))
                      0)))
      (set! *phase-hint* (phase-hint-of dgets dsets dhits dmisses))
      (if (and (>= *hit-ewma* 70) (>= ops 20)
               (not (string=? *profile-name* "inverted"))
               (not (string=? *profile-name* "broken")))
        (begin
          (set! *last-good-profile* *profile-name*)
          (set! *ticks-bad* 0)
          (set! *post-swap-bad* 0)
          #t)
        #t)
      (if (and (> win 15) (or (< *hit-ewma* 55) (> miss-pct 40)))
        (set! *ticks-bad* (+ *ticks-bad* 1))
        (if (and (> win 15) (>= *hit-ewma* 65))
          (set! *ticks-bad* 0)
          #t))
      (let ((ewma-drop (and (> *prev-ewma* 0)
                            (>= (- *prev-ewma* *hit-ewma*) 15)))
            (miss-spike (and (> win 10) (> miss-pct 35) (> ops 15)))
            (evict-pressure (and (> devicted 0) (> miss-pct 35) (> ops 25)))
            (poisoned (or (string=? *profile-name* "inverted")
                          (string=? *profile-name* "broken")))
            (stuck (and (>= *ticks-bad* 5) (> ops 10))))
        (set! *prev-ewma* *hit-ewma*)
        (if (and (>= *ticks-since-fitness* 6)
                 (< *ticks-since-fitness* 999)
                 (or (< *hit-ewma* 50) poisoned)
                 (> win 15))
          (set! *post-swap-bad* (+ *post-swap-bad* 1))
          #t)
        (cond
          ((and (>= *post-swap-bad* 5) (>= *ticks-since-fitness* 6))
           (do-fitness-heal! "still_bad_after_swap"))
          ((and poisoned (or miss-spike stuck (< *hit-ewma* 60) (>= *ticks-bad* 3)))
           (if (>= *ticks-since-fitness* 1)
             (do-fitness-heal! "poison_profile")
             #f))
          ((and (>= *ticks-since-fitness* 4)
                (or (and ewma-drop (or miss-spike evict-pressure))
                    miss-spike
                    stuck
                    (and (string=? *profile-name* "conservative")
                         (or miss-spike stuck (>= *ticks-bad* 6)))))
           (let ((to (fitness-target-profile))
                 (reason (cond
                           (miss-spike "miss_spike")
                           (ewma-drop "ewma_drop")
                           (stuck "stuck")
                           (evict-pressure "evict_pressure")
                           (else "fitness"))))
             (if (string=? to *profile-name*)
               (do-fitness-heal! reason)
               ; A1/SN1: from conservative (or miss_spike / M9 TTL) always
               ; profile-swap → aggressive so choose emits lfu|flat|pin.
               ; Threshold-mutate-first left min-ops too high for per-tick
               ; deltas → never PIN before flash (mutate≈frozen).
               (if (or miss-spike
                       (string=? *profile-name* "conservative")
                       (and *ttl-pressure*
                            (or (string=? *profile-name* "normal")
                                (string=? *profile-name* "thresholded"))))
                 (do-fitness-swap! "aggressive"
                                   (if (or miss-spike
                                           (string=? *profile-name* "conservative"))
                                       reason
                                       (string-append reason "-ttl")))
                 (if (or (string=? *profile-name* "normal")
                         (string=? *profile-name* "thresholded"))
                   (if (do-fitness-threshold-mutate! reason)
                     #t
                     (do-fitness-swap! to reason))
                   (do-fitness-swap! to reason)))))
          (else #f)))))))

(define (maybe-reload-profile!)
  (if (or (not (string? *profile-file*)) (= (string-length *profile-file*) 0))
    #f
    (let ((raw (read-file *profile-file*)))
      (if (not (string? raw))
        #f
        (let ((name (trim-ws raw)))
          (if (or (= (string-length name) 0) (string=? name *profile-name*))
            #f
            (begin
              (display "policy_agent: profile file -> ")
              (display name)
              (newline)
              (if (mutate:boundary-safe?)
                (begin
                  (mutate:safety-snapshot)
                  (let ((r (hot-strategy:swap! "choose-fn" (body-for-profile name)
                                               (string-append "profile-" name))))
                    (display "policy_agent: hot-strategy:swap! profile=")
                    (display name)
                    (display " result=")
                    (display r)
                    (newline)
                    (set! *profile-name* name)
                    (set! *swaps* (+ *swaps* 1))
                    (if (string=? name "broken")
                      (begin
                        (let ((probe (try (choose-fn 100 10 90 10 0 100 0 0 0)
                                          (catch (e) "FAIL"))))
                          (if (or (not (car r))
                                  (not (string? probe))
                                  (string=? probe "FAIL"))
                            (begin
                              (display "policy_agent: hot-strategy:heal!\n")
                              (hot-strategy:heal!)
                              (set! *heals* (+ *heals* 1))
                              (set! *profile-name* "normal"))
                            #t)))
                      #t)
                    #t))
                (begin
                  (display "policy_agent: skip profile swap (boundary not safe)\n")
                  #f)))))))))

; ── seed choose-fn in workspace for hot-strategy ──
; boot-guard write (early re-entry already exited if flag present)
(if (and (string? *boot-guard-file*) (> (string-length *boot-guard-file*) 0))
  (begin
    (write-file *boot-guard-file* "booted\n")
    (display "policy_agent: boot-guard wrote ")
    (display *boot-guard-file*)
    (newline))
  #t)
(display "policy_agent: seeding choose-fn (hot-strategy)\n")
(set-code "(define (choose-fn dgets dsets dhits dmisses devicted nkeys dexpired avg_ttl keys_ttl) \"\")")
(eval-current)

(define *safety* (mutate:safety-snapshot))
(display "policy_agent: mutate:safety-snapshot ok boundary-safe? probe\n")
(display "policy_agent: mutate:boundary-safe?=")
(display (mutate:boundary-safe?))
(newline)

(hot-strategy:register! "choose-fn" *policy-choose-normal*)
(let ((r (hot-strategy:swap! "choose-fn" *policy-choose-normal* "seed-normal")))
  (display "policy_agent: register/swap normal → ")
  (display r)
  (newline))
; A5: register per-prefix param-bag strategy names (multi-register namespace).
; hot-strategy tracks one active heal target — re-register choose-fn as primary.
(hot-strategy:register! "pfx-bag-0" "lfu|flat|pin")
(hot-strategy:register! "pfx-bag-1" "ttl_aware|flat|pin")
(hot-strategy:register! "choose-fn" *policy-choose-normal*)
(display "policy_agent: prefix param-bag namespace registered (pfx-bag-0/1 + choose-fn)\n")
; last-good = normal; optional non-normal seed (poison/conservative benches)
(set! *last-good-profile* "normal")
(set! *profile-name* "normal")
(display "policy_agent: fitness-mutate=")
(display (if *fitness-on* "on" "off"))
(display " seed=")
(display *seed-profile*)
(newline)
(if (and (string? *seed-profile*)
         (> (string-length *seed-profile*) 0)
         (not (string=? *seed-profile* "normal")))
  (begin
    (mutate:safety-snapshot)
    (let ((r (hot-strategy:swap! "choose-fn" (body-for-profile *seed-profile*)
                                 (string-append "seed-" *seed-profile*))))
      (display "policy_agent: seed-profile → ")
      (display *seed-profile*)
      (display " result=")
      (display r)
      (newline)
      (set! *profile-name* *seed-profile*)
      (set! *swaps* (+ *swaps* 1))
      (if (or (string=? *seed-profile* "inverted")
              (string=? *seed-profile* "broken"))
        #t
        (set! *last-good-profile* *seed-profile*))))
  #t)

; M11: seed thresholded evolve body (bad high thresholds lose until evolved)
(set! *champ-min* *thresh-min-ops*)
(set! *champ-miss* *thresh-miss-pin*)
(set! *champ-w-miss* *w-miss*)
(set! *champ-w-write* *w-write*)
(set! *champ-w-evict* *w-evict*)
(set! *trial-w-miss* *w-miss*)
(set! *trial-w-write* *w-write*)
(set! *trial-w-evict* *w-evict*)
(if (or *evolve-on*
        (not (and (= *thresh-min-ops* 40) (= *thresh-miss-pin* 30))))
  (begin
    (display "policy_agent: evolve=")
    (display (if *evolve-on* "on" "off"))
    (display " backend=")
    (display *evolve-backend*)
    (display " seed-thresholds min-ops=")
    (display *thresh-min-ops*)
    (display " miss-pin=")
    (display *thresh-miss-pin*)
    (display " w-miss=")
    (display *w-miss*)
    (display " w-write=")
    (display *w-write*)
    (display " w-evict=")
    (display *w-evict*)
    (display " weight-evolve=")
    (display (if *weight-evolve* "on" "off"))
    (display " max-gens=")
    (display *evolve-max-gens*)
    (display " window=")
    (display *evolve-window*)
    (newline)
    (mutate:safety-snapshot)
    ; Prefer evolve-body (no soft-goal) whenever custom thresholds set -
    ; M11 frozen vs evolve A/B must share the same body family.
    (let ((body (build-evolve-body *thresh-min-ops* *thresh-miss-pin*
                                   *w-miss* *w-write* *w-evict*))
          (tag (if *evolve-on* "evolve-seed" "thresh-seed-frozen")))
      (let ((r (hot-strategy:swap! "choose-fn" body tag)))
        (display "policy_agent: threshold-seed → ")
        (display tag)
        (display " result=")
        (display r)
        (newline)
        (set! *profile-name* (if *evolve-on* "evolved" "thresholded"))
        (set! *swaps* (+ *swaps* 1))
        (set! *evolve-mode* (if *evolve-on* "baseline" "done"))
        #t)))
  #t)

;
; ── P1.9 HA helpers ──
(define (err-closed? s)
  (and (string? s)
       (>= (string-length s) 3)
       (string=? (substring s 0 3) "ERR")))

(define (close-sock!)
  (if (number? *sock*)
    (begin
      (tcp-close *sock*)
      (set! *sock* #f)
      (set! *conn-alive* #f))
    (set! *conn-alive* #f)))

;; A6 — durable policy pin (version / profile hash across restart)
(define (compute-profile-hash)
  ; Stable weak hash without char ops (profile + kernel names)
  (number->string
    (+ (* 100000 (string-length *profile-name*))
       (* 1000 (string-length *last-evict*))
       (* 10 (string-length *last-layout*))
       (string-length *bag0*)
       (string-length *bag1*))))

(define (pin-get text key)
  (if (or (not (string? text)) (= (string-length text) 0))
    ""
    (let ((pat (string-append key "="))
          (start 0)
          (n (string-length text))
          (i 0)
          (found ""))
      (while (<= i n)
        (if (or (= i n)
                (and (< i n) (string=? (substring text i (+ i 1)) "\n")))
          (begin
            (if (> i start)
              (let ((line (substring text start i)))
                (if (and (>= (string-length line) (string-length pat))
                         (string=? (substring line 0 (string-length pat)) pat))
                  (set! found (substring line (string-length pat)
                                         (string-length line)))
                  #t))
              #t)
            (set! start (+ i 1))
            (set! i (+ i 1)))
          (set! i (+ i 1))))
      found)))

(define (write-policy-pin!)
  (if (or (not (string? *pin-file*)) (= (string-length *pin-file*) 0))
    #f
    (begin
      (set! *policy-version* (try (hot-strategy:version) (catch (e) *policy-version*)))
      (set! *profile-hash* (compute-profile-hash))
      (let ((payload (string-append
                       "profile=" *profile-name* "\n"
                       "version=" (number->string *policy-version*) "\n"
                       "profile_hash=" *profile-hash* "\n"
                       "last_evict=" *last-evict* "\n"
                       "last_layout=" *last-layout* "\n"
                       "from_version=" (number->string *pin-from-version*) "\n"
                       "resumed=" (if *pin-resumed* "1" "0") "\n")))
        (if (string=? payload *pin-last-payload*)
          #f
          (begin
            (set! *pin-last-payload* payload)
            (write-file *pin-file* payload)
            (display "policy_agent: pin wrote path=")
            (display *pin-file*)
            (display " profile=")
            (display *profile-name*)
            (display " version=")
            (display *policy-version*)
            (display " hash=")
            (display *profile-hash*)
            (newline)
            #t))))))

(define (resume-from-pin!)
  (if (or (not (string? *pin-file*)) (= (string-length *pin-file*) 0))
    (begin
      (set! *pin-bootstrapped* #t)
      (log-policy-pin! "bootstrap")
      #f)
    (let ((raw (try (read-file *pin-file*) (catch (e) ""))))
      (if (or (not (string? raw)) (= (string-length raw) 0))
        (begin
          (set! *pin-bootstrapped* #t)
          (display "policy_agent: pin empty → bootstrap\n")
          (log-policy-pin! "bootstrap")
          (write-policy-pin!)
          #f)
        (let ((prof (pin-get raw "profile"))
              (ver-s (pin-get raw "version"))
              (hash (pin-get raw "profile_hash"))
              (ev (pin-get raw "last_evict"))
              (ly (pin-get raw "last_layout")))
          (if (and (string? prof) (> (string-length prof) 0))
            (begin
              (set! *pin-from-version*
                (if (and (string? ver-s) (> (string-length ver-s) 0)
                         (number? (string->number ver-s)))
                  (string->number ver-s)
                  0))
              (if (and (string? ev) (> (string-length ev) 0))
                (set! *last-evict* ev) #t)
              (if (and (string? ly) (> (string-length ly) 0))
                (set! *last-layout* ly) #t)
              (if (not (string=? prof *profile-name*))
                (begin
                  (mutate:safety-snapshot)
                  (let ((body (body-for-profile prof))
                        (tag (string-append "resume-" prof)))
                    (let ((r (hot-strategy:swap! "choose-fn" body tag)))
                      (display "policy_agent: resume-profile → ")
                      (display prof)
                      (display " result=")
                      (display r)
                      (newline)
                      (set! *profile-name* prof)
                      (set! *last-good-profile* prof)
                      (set! *swaps* (+ *swaps* 1)))))
                #t)
              (set! *pin-resumed* #t)
              (set! *policy-version* (try (hot-strategy:version) (catch (e) 0)))
              (set! *profile-hash* (compute-profile-hash))
              (display "policy_agent: policy-pin tag=resume profile=")
              (display *profile-name*)
              (display " from_version=")
              (display *pin-from-version*)
              (display " version=")
              (display *policy-version*)
              (display " profile_hash=")
              (display *profile-hash*)
              (display " prior_hash=")
              (display hash)
              (display " last-evict=")
              (display *last-evict*)
              (newline)
              (audit-append! "policy_pin"
                             (number->string *pin-from-version*)
                             (number->string *policy-version*)
                             "resume")
              (write-policy-pin!)
              #t)
            (begin
              (set! *pin-bootstrapped* #t)
              (display "policy_agent: pin missing profile → bootstrap\n")
              (log-policy-pin! "bootstrap")
              (write-policy-pin!)
              #f)))))))

(define (log-policy-pin! tag)
  (set! *policy-version* (hot-strategy:version))
  (set! *profile-hash* (compute-profile-hash))
  (display "policy_agent: policy-pin tag=")
  (display tag)
  (display " profile=")
  (display *profile-name*)
  (display " version=")
  (display *policy-version*)
  (display " profile_hash=")
  (display *profile-hash*)
  (display " from_version=")
  (display *pin-from-version*)
  (display " last-evict=")
  (display *last-evict*)
  (display " last-layout=")
  (display *last-layout*)
  (display " reconnects=")
  (display *reconnects*)
  (newline)
  (write-policy-pin!)
  #t)

;; A3 — durable audit ring + explain schema
;; Line schema: ts=<ms> op=<fitness-swap|evolve-keep|evict|heal|...> from=<a> to=<b> reason=<r> version=<n>
;; Prefer native (query:last-mutation-provenance) when available; always write structured file.
(define (audit-native-note)
  (try
    (let ((p (query:last-mutation-provenance)))
      (if (string? p) p ""))
    (catch (e) "")))

(define (audit-append! op from to reason)
  (set! *last-audit-ts* (monotonic-ms))
  (set! *last-audit-op* op)
  (set! *last-audit-from* from)
  (set! *last-audit-to* to)
  (set! *last-audit-reason* reason)
  (set! *last-audit-version* (try (hot-strategy:version) (catch (e) *last-audit-version*)))
  (set! *audit-count* (+ *audit-count* 1))
  (set! *last-explain*
    (string-append op ":" reason ":" from "->" to))
  (let ((native (audit-native-note))
        (line (string-append
                "ts=" (number->string *last-audit-ts*)
                " op=" op
                " from=" from
                " to=" to
                " reason=" reason
                " version=" (number->string *last-audit-version*)
                (if (and (string? native) (> (string-length native) 0))
                  (string-append " native=" native)
                  "")
                "\n")))
    (display "policy_agent: audit ")
    (display line)
    (if (and (string? *audit-file*) (> (string-length *audit-file*) 0))
      (begin
        ; append-best-effort: read existing (cap ring) then rewrite
        (let ((prev (try (read-file *audit-file*) (catch (e) "")))
              (keep ""))
          (if (and (string? prev) (> (string-length prev) 0))
            (set! keep prev)
            #t)
          (let ((merged (string-append keep line)))
            ; crude ring: if too long, keep tail ~8k
            (if (> (string-length merged) 8192)
              (set! merged
                (substring merged (- (string-length merged) 6144)
                           (string-length merged)))
              #t)
            (write-file *audit-file* merged)
            (display "policy_agent: audit-file wrote path=")
            (display *audit-file*)
            (newline)))
        #t)
      #t)
  ; A3: heartbeat refresh even if mutate:rebind re-entry skips later ticks
  (write-heartbeat!)
  #t))

(define (write-heartbeat!)
  (if (or (not (string? *heartbeat-file*)) (= (string-length *heartbeat-file*) 0))
    #f
    (begin
      (set! *policy-version* (hot-strategy:version))
      (let ((payload (string-append
                       "ts_ms=" (number->string (monotonic-ms)) "\n"
                       "profile=" *profile-name* "\n"
                       "version=" (number->string *policy-version*) "\n"
                       "last_evict=" *last-evict* "\n"
                       "last_layout=" *last-layout* "\n"
                       "reconnects=" (number->string *reconnects*) "\n"
                       "applies=" (number->string *applies*) "\n"
                       "audit_count=" (number->string *audit-count*) "\n"
                       "last_audit_op=" *last-audit-op* "\n"
                       "last_audit_from=" *last-audit-from* "\n"
                       "last_audit_to=" *last-audit-to* "\n"
                       "last_audit_reason=" *last-audit-reason* "\n"
                       "last_audit_version=" (number->string *last-audit-version*) "\n"
                       "last_explain=" *last-explain* "\n"
                       "canary_mode=" *canary-mode* "\n"
                       "canary_ticks=" (number->string *canary-ticks*) "\n"
                       "canary_commits=" (number->string *canary-commits*) "\n"
                       "canary_heals=" (number->string *canary-heals*) "\n"
                       "prefix_deep=" (if *prefix-deep* "1" "0") "\n"
                       "prefix_bags=" *bag0* ";" *bag1* "\n"
                       "prefix_bag_version=" (number->string *prefix-bag-version*) "\n"
                       "profile_hash=" *profile-hash* "\n"
                       "from_version=" (number->string *pin-from-version*) "\n"
                       "pin_resumed=" (if *pin-resumed* "1" "0") "\n"
                       "meta_frozen=" (if *meta-frozen* "1" "0") "\n"
                       "tick_ms=" (number->string *tick-ms*) "\n"
                       "info_polls=" (number->string *info-polls*) "\n"
                       "freeze_count=" (number->string *freeze-count*) "\n"
                       "unfreeze_count=" (number->string *unfreeze-count*) "\n"
                       "evolve_backend=" *evolve-backend* "\n"
                       "w_miss=" (number->string *w-miss*) "\n"
                       "w_write=" (number->string *w-write*) "\n"
                       "w_evict=" (number->string *w-evict*) "\n"
                       "evolve_gen=" (number->string *evolve-gen*) "\n"
                       "evolve_keeps=" (number->string *evolve-keeps*) "\n"
                       "weight_keeps=" (number->string *weight-keeps*) "\n"
                       "swarm_proposes=" (number->string *swarm-propose-logs*) "\n"
                       "shadow_scores=" (number->string *shadow-scores*) "\n"
                       "shadow_ab_ticks=" (number->string *shadow-ab-ticks*) "\n"
                       "shadow_ab_diverges=" (number->string *shadow-ab-diverges*) "\n"
                       "shadow_ab_blocked=" (number->string *shadow-ab-blocked*) "\n"
                       "hit_ewma=" (number->string *hit-ewma*) "\n"
                       "swaps=" (number->string *swaps*) "\n"
                       "applies_sec=" (number->string
                         (let ((dt (- (monotonic-ms) *tick-wall0-ms*)))
                           (if (> dt 0)
                             (quotient (* *applies* 1000) dt)
                             0))) "\n"
                       "polls_sec=" (number->string
                         (let ((dt (- (monotonic-ms) *tick-wall0-ms*)))
                           (if (> dt 0)
                             (quotient (* *info-polls* 1000) dt)
                             0))) "\n")))
        (write-file *heartbeat-file* payload)
        (display "policy_agent: heartbeat wrote path=")
        (display *heartbeat-file*)
        (display " bytes=")
        (display (string-length payload))
        (newline)
        (write-policy-pin!)
        #t))))

;; A4 — canary choose-fn: trial body N ticks → commit or heal!
;; Native-safe: mutate:boundary-safe? + mutate:safety-snapshot before trial;
;; audit reasons: canary_start / canary_commit / canary_heal.
(define (canary-active?)
  (string=? *canary-mode* "trial"))

(define (canary-heal! detail)
  (display "policy_agent: canary-heal! from=")
  (display *canary-to*)
  (display " back=")
  (display *canary-from*)
  (display " detail=")
  (display detail)
  (newline)
  (display "policy_agent: hot-strategy:heal! (canary)\n")
  (hot-strategy:heal!)
  (set! *heals* (+ *heals* 1))
  (set! *canary-heals* (+ *canary-heals* 1))
  (set! *profile-name* *canary-from*)
  (if (and (string? *canary-from*) (> (string-length *canary-from*) 0))
    (set! *last-good-profile* *canary-from*)
    #t)
  (audit-append! "canary-heal" *canary-to* *canary-from* "canary_heal")
  (set! *canary-mode* "idle")
  (set! *canary-ticks* 0)
  (set! *canary-fit-sum* 0)
  (set! *canary-fit-n* 0)
  (set! *ticks-since-fitness* 0)
  (set! *post-swap-bad* 0)
  (set! *ticks-bad* 0)
  #t)

(define (canary-commit!)
  (display "policy_agent: canary-commit! profile=")
  (display *canary-to*)
  (display " ticks=")
  (display *canary-ticks*)
  (newline)
  (set! *canary-commits* (+ *canary-commits* 1))
  (set! *last-good-profile* *canary-to*)
  (set! *profile-name* *canary-to*)
  (audit-append! "canary-commit" *canary-from* *canary-to* "canary_commit")
  ; Refresh safety snapshot so future heal! lands on committed body
  (if (mutate:boundary-safe?)
    (mutate:safety-snapshot)
    #t)
  (set! *canary-mode* "idle")
  (set! *canary-ticks* 0)
  (set! *canary-fit-sum* 0)
  (set! *canary-fit-n* 0)
  (set! *ticks-since-fitness* 0)
  #t)

(define (canary-start! to-name reason)
  (if (canary-active?)
    (begin
      (display "policy_agent: canary-start skipped (already in trial)\n")
      #f)
    (if (not (mutate:boundary-safe?))
      (begin
        (display "policy_agent: skip canary-start (boundary not safe)\n")
        #f)
      (begin
        (mutate:safety-snapshot)
        (let ((from *profile-name*)
              (body (body-for-profile to-name))
              (ok #f))
          (set! ok
            (try
              (begin
                (mutate:rebind "choose-fn" body (string-append "canary-" to-name))
                #t)
              (catch (e) #f)))
          (display "policy_agent: canary-start ")
          (display from)
          (display "→")
          (display to-name)
          (display " reason=")
          (display reason)
          (display " result=")
          (display ok)
          (newline)
          (if ok
            (begin
              (set! *canary-from* from)
              (set! *canary-to* to-name)
              (set! *canary-mode* "trial")
              (set! *canary-ticks* 0)
              (set! *canary-baseline-ewma* *hit-ewma*)
              (set! *canary-fit-sum* 0)
              (set! *canary-fit-n* 0)
              (set! *profile-name* to-name)
              (set! *swaps* (+ *swaps* 1))
              (set! *force-rechoose* #t)
              (audit-append! "canary-start" from to-name "canary_start")
              ; Immediate probe: broken body → heal without waiting full window
              (let ((probe (try (choose-fn 20 10 5 15 0 30 0 0 0)
                                (catch (e) "FAIL"))))
                (if (or (not (string? probe)) (string=? probe "FAIL")
                        (= (string-length probe) 0))
                  (begin
                    (display "policy_agent: canary probe fail → heal\n")
                    (canary-heal! "probe_fail"))
                  #t))
              #t)
            #f))))))

(define (canary-tick! dhits dmisses)
  (if (not (canary-active?))
    #f
    (begin
      (set! *canary-ticks* (+ *canary-ticks* 1))
      (let ((win (+ dhits dmisses))
            (poisoned (or (string=? *canary-to* "inverted")
                          (string=? *canary-to* "broken")))
            (inst 0)
            (avg 0)
            (drop 0))
        (if (> win 0)
          (begin
            (set! inst (quotient (* 100 dhits) win))
            (set! *canary-fit-sum* (+ *canary-fit-sum* inst))
            (set! *canary-fit-n* (+ *canary-fit-n* 1)))
          #t)
        (set! avg (if (> *canary-fit-n* 0)
                    (quotient *canary-fit-sum* *canary-fit-n*)
                    *hit-ewma*))
        (set! drop (if (> *canary-baseline-ewma* 0)
                     (- *canary-baseline-ewma* *hit-ewma*)
                     0))
        (display "policy_agent: canary-tick n=")
        (display *canary-ticks*)
        (display "/")
        (display *canary-ticks-n*)
        (display " ewma=")
        (display *hit-ewma*)
        (display " avg=")
        (display avg)
        (display " drop=")
        (display drop)
        (display " to=")
        (display *canary-to*)
        (newline)
        (cond
          ; poison profiles: heal quickly (within T)
          ((and poisoned (>= *canary-ticks* 1))
           (canary-heal! "poison_profile"))
          ; fitness drop vs baseline
          ((and (>= *canary-fit-n* 2)
                (>= drop *canary-drop-pp*)
                (or (< *hit-ewma* 55) (< avg 50)))
           (canary-heal! "fitness_drop"))
          ; window complete
          ((>= *canary-ticks* *canary-ticks-n*)
           (if (or poisoned (< avg 45) (and (> *canary-baseline-ewma* 60)
                                            (< avg (- *canary-baseline-ewma* *canary-drop-pp*))))
             (canary-heal! "window_reject")
             (canary-commit!)))
          (else #t))))))

(define (maybe-canary-inject!)
  (if (or *canary-inject-done*
          (not (string? *canary-inject*))
          (= (string-length *canary-inject*) 0)
          (canary-active?))
    #f
    (if (>= *tick-count* *canary-warm-ticks*)
      (begin
        (set! *canary-inject-done* #t)
        (display "policy_agent: canary-inject firing profile=")
        (display *canary-inject*)
        (newline)
        (canary-start! *canary-inject* "inject"))
      #f)))

(define (reapply-last-policy!)
  ; After reconnect: INFO then re-assert last chosen EVICT/LAYOUT if known.
  ; Fail-safe: if agent memory empty, C server already keeps last kernel.
  (let ((info (redis-call! *sock* "INFO")))
    (if (or (not (string? info)) (err-closed? info))
      (begin
        (display "policy_agent: reapply INFO failed\n")
        (set! *conn-alive* #f)
        #f)
      (let ((cur (info-get info "evict"))
            (cur-layout (info-get info "layout")))
        (display "policy_agent: reapply check server evict=")
        (display cur)
        (display " layout=")
        (display cur-layout)
        (display " want-evict=")
        (display *last-evict*)
        (display " want-layout=")
        (display *last-layout*)
        (newline)
        (if (> (string-length *last-evict*) 0)
          (begin
            (display "policy_agent: re-apply EVICT ")
            (display *last-evict*)
            (display (if (string=? *last-evict* cur) " (in-sync)" " (delta)"))
            (newline)
            (redis-call! *sock* "EVICT" *last-evict*)
            (set! *applies* (+ *applies* 1)))
          #t)
        (if (> (string-length *last-layout*) 0)
          (begin
            (display "policy_agent: re-apply LAYOUT ")
            (display *last-layout*)
            (display (if (string=? *last-layout* cur-layout) " (in-sync)" " (delta)"))
            (newline)
            (redis-call! *sock* "LAYOUT" *last-layout*)
            (set! *applies* (+ *applies* 1)))
          #t)
        (set! *have-prev* #f)
        (log-policy-pin! "reapply")
        #t))))

(define (ensure-connected!)
  (if (and *conn-alive* (number? *sock*))
    #t
    (let ((ok #f)
          (delay *backoff-ms*)
          (attempt 0))
      (close-sock!)
      (while (and (not ok) *running*)
        (begin
          (set! attempt (+ attempt 1))
          (display "policy_agent: connect attempt=")
          (display attempt)
          (display " backoff_ms=")
          (display delay)
          (display " ")
          (display *host*)
          (display ":")
          (display *port*)
          (newline)
          (set! *sock* (tcp-connect *host* *port*))
          (cond
            ((not (number? *sock*))
             (begin
               (display "policy_agent: tcp-connect failed; sleep ")
               (display delay)
               (newline)
               (busy-wait-ms delay)
               (set! delay (if (< (* delay 2) *backoff-cap*) (* delay 2) *backoff-cap*))))
            (else
             (begin
               (set! *conn-alive* #t)
               (if (> (string-length *password*) 0)
                 (begin
                   (display "policy_agent: AUTH\n")
                   (let ((ar (redis-call! *sock* "AUTH" *password*)))
                     (display "policy_agent: AUTH → ")
                     (display ar)
                     (newline)
                     (if (err-closed? ar)
                       (set! *conn-alive* #f)
                       #t)))
                 #t)
               (if (not *conn-alive*)
                 (begin
                   (close-sock!)
                   (busy-wait-ms delay)
                   (set! delay (if (< (* delay 2) *backoff-cap*) (* delay 2) *backoff-cap*)))
                 (let ((pong (redis-call! *sock* "PING")))
                   (display "policy_agent: PING → ")
                   (display pong)
                   (newline)
                   (if (or (not (string? pong))
                           (err-closed? pong)
                           (and (>= (string-length pong) 3)
                                (string=? (substring pong 0 3) "ERR")))
                     (begin
                       (close-sock!)
                       (busy-wait-ms delay)
                       (set! delay (if (< (* delay 2) *backoff-cap*)
                                     (* delay 2) *backoff-cap*)))
                     (begin
                       (if *ever-connected*
                         (begin
                           (set! *reconnects* (+ *reconnects* 1))
                           (display "policy_agent: reconnected reconnects=")
                           (display *reconnects*)
                           (newline)
                           (reapply-last-policy!)
                           (log-policy-pin! "reconnect"))
                         (begin
                           (set! *ever-connected* #t)
                           (log-policy-pin! "connect")
                           (set! *have-prev* #f)))
                       (set! *backoff-ms* 50)
                       (set! ok #t)
                       (write-heartbeat!))))))))))
      ok)))

; ── connect to C data plane (P1.9: reconnect + backoff) ──
(display "policy_agent: connect ")
(display *host*)
(display ":")
(display *port*)
(newline)

; A6: resume profile/version pin (or explicit bootstrap) before first connect
(resume-from-pin!)
(set! *tick-wall0-ms* (monotonic-ms))

(if (not (ensure-connected!))
  (begin
    (display "policy_agent: initial connect failed\n")
    (set! *fatal* #t))
  #t)

(if (and (not *fatal*) *demo*)
  (begin
    (display "policy_agent: DEMO mode (normal → invert swap → heal)\n")
    (set! *t0* (monotonic-ms)))
  #t)

(if (not *fatal*)
  (while *running*
    (begin
      (busy-wait-ms *tick-ms*)
      (set! *tick-count* (+ *tick-count* 1))
      ; HA test hook: force one TCP drop after N ticks
      (if (and (not *forced-reconnect-done*)
               (> *force-reconnect-after* 0)
               (>= *tick-count* *force-reconnect-after*)
               *conn-alive*)
        (begin
          (display "policy_agent: HA force-reconnect after ticks=")
          (display *tick-count*)
          (newline)
          (close-sock!)
          (set! *forced-reconnect-done* #t))
        #t)
      (if (not (ensure-connected!))
        (begin
          (display "policy_agent: give up reconnect\n")
          (set! *running* #f)
          (set! *fatal* #t))
        (begin
      (maybe-reload-profile!)
      (write-heartbeat!)
      ; HA test: after forced reconnect succeeds, exit cleanly (non-demo)
      (if (and *forced-reconnect-done*
               (>= *reconnects* 1)
               (not *demo*)
               (>= *tick-count* (+ *force-reconnect-after* 2)))
        (begin
          (display "policy_agent: HA reconnect test PASS reconnects=")
          (display *reconnects*)
          (display " last-evict=")
          (display *last-evict*)
          (newline)
          (set! *running* #f)
          (set! *exit* 0)
          (set! *fatal* #f))
        #t)
      ; safety before any swap in demo phases
      (let ((info (redis-call! *sock* "INFO")))
        (if (or (not (string? info)) (err-closed? info))
          (begin
            (display "policy_agent: INFO failed (will reconnect): ")
            (display info)
            (newline)
            (close-sock!))
          (begin
            (let ((g (info-num info "gets"))
                  (s (info-num info "sets"))
                  (h (info-num info "hits"))
                  (m (info-num info "misses"))
                  (ev (info-num info "evicted"))
                  (ex (info-num info "expired"))
                  (nk (info-num info "keys"))
                  (kt (info-num info "keys_with_ttl"))
                  (at (info-num info "avg_ttl_ms"))
                  (cur (info-get info "evict"))
                  (cur-layout (info-get info "layout")))
                (parse-policy-hints! (info-get info "policy_hints"))
              (let ((dgets (if *have-prev* (- g *prev-gets*) 0))
                    (dsets (if *have-prev* (- s *prev-sets*) 0))
                    (dhits (if *have-prev* (- h *prev-hits*) 0))
                    (dmisses (if *have-prev* (- m *prev-misses*) 0))
                    (devicted (if *have-prev* (- ev *prev-evicted*) 0))
                    (dexpired (if *have-prev* (- ex *prev-expired*) 0)))
                (set! *prev-gets* g)
                (set! *prev-sets* s)
                (set! *prev-hits* h)
                (set! *prev-misses* m)
                (set! *prev-evicted* ev)
                (set! *prev-expired* ex)
                (set! *have-prev* #t)
                ; hit% EWMA (agent-side hot concentration proxy)
                (let ((win (+ dhits dmisses)))
                  (if (> win 0)
                    (let ((inst (quotient (* 100 dhits) win)))
                      (set! *hit-ewma*
                        (quotient (+ (* *hit-ewma* 7) (* inst 3)) 10)))
                    #t))
                                (set! *ttl-pressure*
                  (and (> kt 0) (< at 12000)
                       (or (> kt 15) (>= (if (> nk 0) (quotient (* 100 kt) nk) 0) 20))))

                ; Apply choose BEFORE fitness mutate so EVICT lands even if
                ; hot-strategy:swap! → eval-current re-enters the file.
                (set! *last-dgets* dgets)
                (set! *last-dsets* dsets)
                (set! *last-dhits* dhits)
                (set! *last-dmisses* dmisses)
                (set! *last-devicted* devicted)
                (set! *last-nkeys* nk)
                (set! *last-dexpired* dexpired)
                (set! *last-avg-ttl* at)
                (set! *last-keys-ttl* kt)
                (let ((choice (try
                                (choose-fn dgets dsets dhits dmisses devicted nk
                                           dexpired at kt)
                                (catch (e) ""))))
                  ; M12/A5: prefix-scoped override from POLICY hints / bags
                  (if *prefix-policy-on*
                    (begin
                      (if *prefix-deep*
                        (set! choice (compose-prefix-choice))
                        (cond
                          ((and (prefix-has-session?) *ttl-pressure*)
                           (set! choice "ttl_aware|flat|pin"))
                          ((prefix-has-zipf?)
                           (set! choice (if *prefer-slru* "slru|flat|pin" "lfu|flat|pin")))
                          ((prefix-has-session?)
                           (set! choice "ttl_aware|flat|pin"))
                          (else #t)))
                      (if (and (string? choice) (> (string-length choice) 0)
                               (= *prefix-applies* 0))
                        (begin
                          (display "policy_agent: prefix-policy")
                          (if *prefix-deep* (display "-deep") (display ""))
                          (display " hints=")
                          (display *policy-hints*)
                          (display " bags=")
                          (display *bag0*)
                          (display ";")
                          (display *bag1*)
                          (display " → ")
                          (display choice)
                          (newline)
                          (audit-append! "prefix_policy" *policy-hints* choice
                                         (if *prefix-deep* "prefix_deep" "prefix_policy"))
                          (set! *prefix-applies* 1))
                        #t))
                    #t)
                  ; A12 optional: miss_spike/write_heavy + prefer-slru → slru kernel
                  (if (and *prefer-slru*
                           (string? choice)
                           (> (string-length choice) 0)
                           (>= (find-substr choice "lfu" 0) 0)
                           (or (string=? *phase-hint* "miss_spike")
                               (string=? *phase-hint* "write_heavy")))
                    (begin
                      (set! choice
                        (if (>= (find-substr choice "lfu|flat|pin" 0) 0)
                          "slru|flat|pin"
                          (if (>= (find-substr choice "lfu|flat" 0) 0)
                            "slru|flat"
                            "slru")))
                      (display "policy_agent: prefer-slru rewrite → ")
                      (display choice)
                      (newline))
                    #t)
                  ; A10 shadow A/B dry-run (never EVICT loser)
                  (if *shadow-ab*
                    (begin
                      (shadow-c-setup!)
                      (shadow-ab-tick!
                        (if (and (string? choice) (> (string-length choice) 0))
                          choice
                          (if (> (string-length *last-evict*) 0)
                            *last-evict*
                            "lru"))))
                    #t)
                  (if (and (string? choice) (> (string-length choice) 0))
                    (begin
                      ; parse "evict|layout|pin" (backward compat: bare "lfu")
                      (let ((parts '())
                            (start 0)
                            (i 0)
                            (n (string-length choice)))
                        (while (<= i n)
                          (if (or (= i n)
                                  (and (< i n)
                                       (string=? (substring choice i (+ i 1)) "|")))
                            (begin
                              (set! parts
                                (append parts
                                        (list (substring choice start i))))
                              (set! start (+ i 1))
                              (set! i (+ i 1)))
                            (set! i (+ i 1))))
                        (let ((ev-name (if (pair? parts) (car parts) ""))
                              (ly-name (if (and (pair? parts) (pair? (cdr parts)))
                                        (cadr parts) ""))
                              (want-pin (and (pair? parts)
                                             (pair? (cdr parts))
                                             (pair? (cddr parts))
                                             (string=? (caddr parts) "pin")))
                              (want-soft (and (pair? parts)
                                              (or (string=? (car parts) "soft")
                                                  (and (pair? (cdr parts))
                                                       (string=? (cadr parts) "soft"))
                                                  (and (pair? (cdr parts))
                                                       (pair? (cddr parts))
                                                       (string=? (caddr parts) "soft"))))))
                          (if (and (> (string-length ev-name) 0)
                                   (not (string=? ev-name cur)))
                            (begin
                              (let ((erate (if (> (+ dgets dsets) 0)
                                             (quotient (* 100 devicted)
                                                       (+ dgets dsets))
                                             0)))
                                (if want-soft
                                  (begin
                                    (set! *soft-fires* (+ *soft-fires* 1))
                                    (display "policy_agent: soft-goal refuse expensive (erate=")
                                    (display erate)
                                    (display " devicted=")
                                    (display devicted)
                                    (display " ops=")
                                    (display (+ dgets dsets))
                                    (display ")\n"))
                                  #t)
                                (display "policy_agent: EVICT ")
                                (display cur)
                                (display " → ")
                                (display ev-name)
                                (display " (dgets=")
                                (display dgets)
                                (display " dsets=")
                                (display dsets)
                                (display " ewma=")
                                (display *hit-ewma*)
                                (display " dexpired=")
                                (display dexpired)
                                (display " avg_ttl=")
                                (display at)
                                (display " keys_ttl=")
                                (display kt)
                                (display " devicted=")
                                (display devicted)
                                (display " erate=")
                                (display erate)
                                (display ")\n")
                                (redis-call! *sock* "EVICT" ev-name)
                                (set! *last-evict* ev-name)
                                (set! *applies* (+ *applies* 1))
                                (set! *swaps* (+ *swaps* 1))
                                (audit-append! "evict" cur ev-name
                                               (if (string? *phase-hint*) *phase-hint* "choose")))))
                            #t)
                          (if (and (> (string-length ly-name) 0)
                                   (not (string=? ly-name cur-layout)))
                            (begin
                              (display "policy_agent: LAYOUT ")
                              (display cur-layout)
                              (display " → ")
                              (display ly-name)
                              (newline)
                              (redis-call! *sock* "LAYOUT" ly-name)
                              (set! *last-layout* ly-name)
                              (set! *applies* (+ *applies* 1)))
                            #t)
                          ; On LRU swap-in: drop stale pins so WS shift is not glued to set A
                          (if (and (string=? ev-name "lru")
                                   (not (string=? cur "lru"))
                                   (not *prefix-policy-on*))
                            (begin
                              (display "policy_agent: UNPIN stale hot/z prefixes\n")
                              (unpin-prefix-set! *sock* "hot" 40)
                              (unpin-prefix-set! *sock* "z" 24)
                              #t)
                            #t)
                          (if want-pin
                            (begin
                              (redis-call! *sock* "EVICT" "samples" "64")
                              (if (not (string=? cur-layout "flat"))
                                (redis-call! *sock* "LAYOUT" "flat")
                                #t)
                              (if *prefix-policy-on*
                                (begin
                                  ; A5 deep: PIN only bags that request pin (ttl_aware nopin skips)
                                  (display "policy_agent: PIN prefix-policy")
                                  (if *prefix-deep* (display "-deep") (display ""))
                                  (display " ")
                                  (display *pfx0*)
                                  (display "/")
                                  (display *pfx1*)
                                  (newline)
                                  (if (and (> (string-length *pfx0*) 0)
                                           (or (not *prefix-deep*) (bag-wants-pin? *bag0*)))
                                    (pin-prefix-set! *sock* *pfx0* 32)
                                    #t)
                                  (if (and (> (string-length *pfx1*) 0)
                                           (or (not *prefix-deep*) (bag-wants-pin? *bag1*)))
                                    (pin-prefix-set! *sock* *pfx1* 32)
                                    #t))
                                (begin
                                  (display "policy_agent: PIN hot set + samples=64\n")
                                  (pin-prefix-set! *sock* "hot" 40)
                                  (pin-prefix-set! *sock* "z" 24)))
                              (set! *applies* (+ *applies* 1))
                              #t)
                            #t))))
                    #t))
                (set! *info-polls* (+ *info-polls* 1))
                (maybe-auto-freeze! dgets dsets dhits dmisses)
                (maybe-canary-inject!)
                (if (canary-active?)
                  (canary-tick! dhits dmisses)
                  (if *meta-frozen*
                    #f
                    (maybe-fitness-mutate! dgets dsets dhits dmisses devicted)))
                (if *force-rechoose*
                  (begin
                    (set! *force-rechoose* #f)
                    ; A1: use miss-spike-shaped deltas so aggressive choose emits
                    ; lfu|flat|pin even if last tick was idle (sleep between bursts).
                    (let ((choice2 (try
                                     (choose-fn 20 40 5 35 3
                                                (if (> *last-nkeys* 0) *last-nkeys* 30)
                                                0 0 0)
                                     (catch (e) ""))))
                      (if (and (string? choice2) (> (string-length choice2) 0))
                        (begin
                          (display "policy_agent: post-swap re-choose → ")
                          (display choice2)
                          (newline)
                          ; reuse apply path by injecting into choice via a mini apply
                          (let ((parts2 '())
                                (start2 0)
                                (i2 0)
                                (n2 (string-length choice2)))
                            (while (<= i2 n2)
                              (if (or (= i2 n2)
                                      (and (< i2 n2)
                                           (string=? (substring choice2 i2 (+ i2 1)) "|")))
                                (begin
                                  (set! parts2 (append parts2 (list (substring choice2 start2 i2))))
                                  (set! start2 (+ i2 1))
                                  (set! i2 (+ i2 1)))
                                (set! i2 (+ i2 1))))
                            (let ((ev2 (if (pair? parts2) (car parts2) ""))
                                  (ly2 (if (and (pair? parts2) (pair? (cdr parts2))) (cadr parts2) ""))
                                  (pin2 (and (pair? parts2) (pair? (cdr parts2)) (pair? (cddr parts2))
                                             (string=? (caddr parts2) "pin"))))
                              (if (and (> (string-length ev2) 0) (not (string=? ev2 *last-evict*)))
                                (begin
                                  (display "policy_agent: EVICT (post-swap) → ")
                                  (display ev2)
                                  (newline)
                                  (redis-call! *sock* "EVICT" ev2)
                                  (set! *last-evict* ev2)
                                  (set! *applies* (+ *applies* 1)))
                                #t)
                              (if (and (> (string-length ly2) 0) (not (string=? ly2 *last-layout*)))
                                (begin
                                  (redis-call! *sock* "LAYOUT" ly2)
                                  (set! *last-layout* ly2)
                                  (set! *applies* (+ *applies* 1)))
                                #t)
                              (if pin2
                                (begin
                                  (display "policy_agent: PIN hot set (post-swap)\n")
                                  (redis-call! *sock* "EVICT" "samples" "64")
                                  (pin-prefix-set! *sock* "hot" 40)
                                  (pin-prefix-set! *sock* "z" 24)
                                  (set! *applies* (+ *applies* 1)))
                                #t))))
                        #t)))
                  #t)
                (maybe-evolve!)
                #t)))))
      ; demo phase machine
      (if *demo*
        (let ((elapsed (- (monotonic-ms) *t0*)))
          (if (and (not *did-invert*) (>= elapsed 3000))
            (begin
              (display "policy_agent: hot-strategy:swap! → inverted (demo)\n")
              (if (mutate:boundary-safe?)
                (begin
                  (mutate:safety-snapshot)
                  (let ((r (hot-strategy:swap! "choose-fn" *policy-choose-inverted* "demo-invert")))
                    (display "policy_agent: swap inverted result=")
                    (display r)
                    (newline)
                    (set! *did-invert* #t)
                    (set! *swaps* (+ *swaps* 1))))
                (display "policy_agent: skip invert (boundary not safe)\n")))
            #t)
          (if (and *did-invert* (not *did-heal*) (>= elapsed 6500))
            (begin
              (display "policy_agent: attempting broken body (expect heal)\n")
              (mutate:safety-snapshot)
              (let ((r (hot-strategy:swap! "choose-fn" *policy-choose-broken* "demo-broken")))
                (display "policy_agent: broken swap result=")
                (display r)
                (newline)
                ; Even if swap "succeeds" at rebind, call may fail - force heal path
                (let ((probe (try (choose-fn 100 10 90 10 0 100 0 0 0) (catch (e) "FAIL"))))
                  (display "policy_agent: probe after broken=")
                  (display probe)
                  (newline)
                  (if (or (not (car r)) (string=? (if (string? probe) probe "") "FAIL")
                          (not (string? probe)))
                    (begin
                      (display "policy_agent: hot-strategy:heal!\n")
                      (hot-strategy:heal!)
                      (set! *heals* (+ *heals* 1))
                      (display "policy_agent: healed body active; version=")
                      (display (hot-strategy:version))
                      (newline))
                    (begin
                      ; swap reported ok but we still heal to exercise path
                      (display "policy_agent: force heal! (smoke)\n")
                      (hot-strategy:heal!)
                      (set! *heals* (+ *heals* 1)))))
                (set! *did-heal* #t)))
            #t)
          (if (>= elapsed 10000)
            (begin
              (display "policy_agent: demo done applies=")
              (display *applies*)
              (display " swaps=")
              (display *swaps*)
              (display " heals=")
              (display *heals*)
              (newline)
              (display "policy_agent: mutate:summary=")
              (display (mutate:summary))
              (newline)
              (set! *running* #f)
              (set! *exit* 0))
            #t))
        #t)))
        )) ; end ensure-connected begin / while body
  #t)

(if (number? *sock*)
  (tcp-close *sock*)
  #t)

(display "policy_agent: exit applies=")
(display *applies*)
(display " reconnects=")
(display *reconnects*)
(display " last-evict=")
(display *last-evict*)
(display " profile=")
(display *profile-name*)
(display " version=")
(display (hot-strategy:version))
(display " heals=")
(display *heals*)
(display " fitness-swaps=")
(display *fitness-swaps*)
(display " fitness-heals=")
(display *fitness-heals*)
(display " threshold-mutates=")
(display *threshold-mutates*)
(display " soft-fires=")
(display *soft-fires*)
(display " evolve-gens=")
(display *evolve-gen*)
(display " evolve-keeps=")
(display *evolve-keeps*)
(display " evolve-reverts=")
(display *evolve-reverts*)
(display " evolve-logs=")
(display *evolve-logs*)
(display " evolve-backend=")
(display *evolve-backend*)
(display " w-miss=")
(display *w-miss*)
(display " w-write=")
(display *w-write*)
(display " w-evict=")
(display *w-evict*)
(display " weight-keeps=")
(display *weight-keeps*)
(display " swarm-proposes=")
(display *swarm-propose-logs*)
(display " shadow-scores=")
(display *shadow-scores*)
(display " shadow-wins=")
(display *shadow-wins*)
(display " shadow-ab-diverges=")
(display *shadow-ab-diverges*)
(display " shadow-ab-blocked=")
(display *shadow-ab-blocked*)
(display " prefix-applies=")
(display *prefix-applies*)
(display " canary-commits=")
(display *canary-commits*)
(display " canary-heals=")
(display *canary-heals*)
(display " canary-mode=")
(display *canary-mode*)
(display " profile=")
(display *profile-name*)
(newline)
(if *fatal* (set! *exit* 1) #t)
) ; end A1 early-guard if/begin
