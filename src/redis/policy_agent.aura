(require "src/redis/policy/choose_inverted" all:)
(require "src/redis/policy/choose_broken" all:)
(require "src/redis/policy/choose_nosoft" all:)

(display "policy_agent: A1-FILE-LOAD\n")
; A1 early re-entry gate - BEFORE heavy defines / getenv. mutate:rebind may
; re-eval this file; if boot-guard exists, skip the rest of the module so the
; outer tick can continue (post-swap re-choose / PIN).
(define *a1-boot-path*
  (string-append "/work/.ar-agent-booted-"
                 (let ((e (getenv "AURA_REDIS_PORT")))
                   (if (and (string? e) (> (string-length e) 0)) e "6379"))
                 ".flag"))
(define *a1-boot-content*
  (try (read-file *a1-boot-path*) (catch (e) (string-append "ERR:" (if (string? e) e "?")))))
(display "policy_agent: early-guard path=")
(display *a1-boot-path*)
(display " content=")
(display *a1-boot-content*)
(newline)
(define *a1-reentry*
  (and (string? *a1-boot-content*) (> (string-length *a1-boot-content*) 0)))
(display "policy_agent: early-guard reentry?=")
(display *a1-reentry*)
(newline)
(if *a1-reentry*
  (begin
    (display "policy_agent: eval-current re-entry - skip reboot (early-guard)\n")
    #t)
  (begin
