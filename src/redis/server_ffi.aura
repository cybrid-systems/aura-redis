; server_ffi.aura — Aura control plane + C data plane (Iteration 2+)
;
; Env:
;   AURA_REDIS_PORT / AURA_REDIS_CORE_SO / AURA_REDIS_MAXMEMORY / AURA_REDIS_EVICT
;   AURA_REDIS_ADAPTIVE=1 → serve_ms pump + inlined adaptive supervisor (Iteration 6)
;
; Aura FFI quirks (this rev) — documented so we do not "clean up" into breakage:
;   - Top-level (c-func) binds work for many symbols, but user closures defined
;     around them often become inert (calls return 0 / garbage).
;   - (bind) helper preserves closures but only ~2 c-func binds succeed.
;   - Therefore: all c-func at top-level; adaptive policy inlined (no require/load
;     of adaptive.aura in this file). Rules mirror src/redis/adaptive_body.aura.
;   - Expression-form (while cond body) only; (exit) unbound → *fatal*.

(require "std/ffi" all:)

(define *fatal* #f)
(define *serve-rc* 1)
(define *ad-running* #f)
(define adaptive-on #f)

; ── Adaptive state (scalars only; no user procs called after c-func) ──
(define *ad-min-ops* 80)
(define *ad-votes-need* 2)
(define *ad-cooldown-ms* 400)
(define *ad-window-ms* 200)
(define *ad-prev-gets* 0)
(define *ad-prev-sets* 0)
(define *ad-prev-hits* 0)
(define *ad-prev-misses* 0)
(define *ad-last-eval-ms* 0)
(define *ad-last-swap-ms* 0)
(define *ad-pending* "")
(define *ad-pending-votes* 0)
(define *ad-swaps* 0)
(define *ad-choice* "")
(define *ad-cur* "")
(define *ad-dgets* 0)
(define *ad-dsets* 0)
(define *ad-dhits* 0)
(define *ad-dmisses* 0)
(define *ad-now* 0)
(define *ad-hit-pct* 0)
(define *ad-ops* 0)

(define so-path
  (let ((e (getenv "AURA_REDIS_CORE_SO")))
    (if (and (string? e) (> (string-length e) 0))
      e
      "native/build/libaura_redis_core.so")))

(display "server_ffi: so=") (display so-path) (newline)
(define lib (c-load so-path))
(define create (c-func lib "ar_core_create" "() -> Opaque"))
(if (not (procedure? create))
  (begin
    (display "server_ffi: c-load/c-func failed\n")
    (set! *fatal* #t))
  #t)

(define destroy (c-func lib "ar_core_destroy" "(Opaque) -> Void"))
(define ar-listen (c-func lib "ar_core_listen" "(Opaque Int) -> Int"))
(define ar-serve (c-func lib "ar_core_serve_forever" "(Opaque) -> Int"))
(define ar-serve-ms (c-func lib "ar_core_serve_ms" "(Opaque Int) -> Int"))
(define ar-set-evict (c-func lib "ar_core_set_evict_by_name" "(Opaque String) -> Int"))
(define ar-set-maxmem (c-func lib "ar_core_set_maxmemory" "(Opaque Int) -> Int"))
(define ar-evict-name (c-func lib "ar_core_evict_name" "(Opaque) -> String"))
(define ar-metric-gets (c-func lib "ar_metric_gets" "(Opaque) -> Int"))
(define ar-metric-sets (c-func lib "ar_metric_sets" "(Opaque) -> Int"))
(define ar-metric-hits (c-func lib "ar_metric_hits" "(Opaque) -> Int"))
(define ar-metric-misses (c-func lib "ar_metric_misses" "(Opaque) -> Int"))
(define ar-used-memory (c-func lib "ar_core_used_memory" "(Opaque) -> Int"))

(define core #f)
(if (not *fatal*)
  (begin
    (set! core (create))
    (if (not (c-opaque? core))
      (begin (display "server_ffi: create failed\n") (set! *fatal* #t))
      #t))
  #t)

; Inline port parse (no helper fn after c-func)
(define bind-port 6379)
(let ((e (getenv "AURA_REDIS_PORT")))
  (if (and (string? e) (> (string-length e) 0) (number? (string->number e)))
    (let ((n (string->number e)))
      (if (> n 0) (set! bind-port n) #t))
    #t))

(define lr 0)
(if (not *fatal*)
  (begin
    (let ((ev (getenv "AURA_REDIS_EVICT")))
      (if (and (string? ev) (> (string-length ev) 0))
        (ar-set-evict core ev)
        (ar-set-evict core "noop")))
    (let ((mm (getenv "AURA_REDIS_MAXMEMORY")))
      (if (and (string? mm) (> (string-length mm) 0) (number? (string->number mm)))
        (ar-set-maxmem core (string->number mm))
        #t))
    (display "server_ffi: binding port=")
    (display bind-port)
    (newline)
    (set! lr (ar-listen core bind-port))
    (display "server_ffi: listen rc=")
    (display lr)
    (newline)
    (if (not (= lr 1))
      (begin (display "server_ffi: listen failed\n") (set! *fatal* #t))
      #t)
    (let ((ad (getenv "AURA_REDIS_ADAPTIVE")))
      (set! adaptive-on
        (and (string? ad)
             (or (string=? ad "1") (string=? ad "true") (string=? ad "yes"))))))
  #t)

(if (and (not *fatal*) adaptive-on)
  (begin
    (display "server_ffi: adaptive supervisor ON (inlined serve_ms + tick)\n")
    (display "server_ffi: rules=write-heavy→lfu; read-heavy+hit≥60%→lru; hysteresis\n")
    (set! *ad-last-eval-ms* (monotonic-ms))
    (set! *ad-running* #t)
    (while *ad-running*
      (begin
        (set! *serve-rc* (ar-serve-ms core 50))
        ; ── inlined adaptive-tick! ──
        (set! *ad-now* (monotonic-ms))
        (if (>= (- *ad-now* *ad-last-eval-ms*) *ad-window-ms*)
          (begin
            (set! *ad-dgets* (- (ar-metric-gets core) *ad-prev-gets*))
            (set! *ad-dsets* (- (ar-metric-sets core) *ad-prev-sets*))
            (set! *ad-dhits* (- (ar-metric-hits core) *ad-prev-hits*))
            (set! *ad-dmisses* (- (ar-metric-misses core) *ad-prev-misses*))
            (set! *ad-prev-gets* (ar-metric-gets core))
            (set! *ad-prev-sets* (ar-metric-sets core))
            (set! *ad-prev-hits* (ar-metric-hits core))
            (set! *ad-prev-misses* (ar-metric-misses core))
            (set! *ad-last-eval-ms* *ad-now*)
            (set! *ad-ops* (+ *ad-dgets* *ad-dsets*))
            (set! *ad-choice* "")
            (if (>= *ad-ops* *ad-min-ops*)
              (begin
                (if (> (+ *ad-dhits* *ad-dmisses*) 0)
                  (set! *ad-hit-pct*
                    (quotient (* 100 *ad-dhits*) (+ *ad-dhits* *ad-dmisses*)))
                  (set! *ad-hit-pct* 0))
                (if (> *ad-dsets* (* *ad-dgets* 2))
                  (set! *ad-choice* "lfu")
                  (if (and (> *ad-dgets* (* *ad-dsets* 5)) (>= *ad-hit-pct* 60))
                    (set! *ad-choice* "lru")
                    (set! *ad-choice* ""))))
              #t)
            (set! *ad-cur* (ar-evict-name core))
            (if (or (string=? *ad-choice* "") (string=? *ad-choice* *ad-cur*))
              (begin
                (set! *ad-pending* "")
                (set! *ad-pending-votes* 0))
              (begin
                (if (string=? *ad-choice* *ad-pending*)
                  (set! *ad-pending-votes* (+ *ad-pending-votes* 1))
                  (begin
                    (set! *ad-pending* *ad-choice*)
                    (set! *ad-pending-votes* 1)))
                (if (and (>= *ad-pending-votes* *ad-votes-need*)
                         (>= (- *ad-now* *ad-last-swap-ms*) *ad-cooldown-ms*))
                  (begin
                    (ar-set-evict core *ad-choice*)
                    (set! *ad-swaps* (+ *ad-swaps* 1))
                    (set! *ad-last-swap-ms* *ad-now*)
                    (display "adaptive: swap ")
                    (display *ad-cur*)
                    (display " → ")
                    (display *ad-choice*)
                    (display " (gets=")
                    (display *ad-dgets*)
                    (display " sets=")
                    (display *ad-dsets*)
                    (display " hits=")
                    (display *ad-dhits*)
                    (display " misses=")
                    (display *ad-dmisses*)
                    (display " mem=")
                    (display (ar-used-memory core))
                    (display ")\n")
                    (set! *ad-pending* "")
                    (set! *ad-pending-votes* 0))
                  #t))))
          #t)
        (if (or (= *serve-rc* 1) (= *serve-rc* -1))
          (set! *ad-running* #f)
          #t)))
    (display "server_ffi: adaptive swaps=")
    (display *ad-swaps*)
    (newline))
  #t)

(if (and (not *fatal*) (not adaptive-on))
  (begin
    (display "server_ffi: serve_forever (C data plane)\n")
    (set! *serve-rc* (ar-serve core)))
  #t)

(display "aura-redis-ffi exit=")
(display *serve-rc*)
(newline)
(if (and (not *fatal*) (c-opaque? core))
  (destroy core)
  #t)
(define *exit* *serve-rc*)
