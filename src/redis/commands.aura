; commands.aura — Redis command dispatch for aura-redis v0
; (require "src/redis/commands" all:)

(export cmd-dispatch
        ascii-upcase
        ascii-cmd=?
        cmd-eq?
        *redis-db*
        *server-start-ms*
        *redis-version*)

(require "src/redis/resp" all:)
(require "src/redis/store" all:)

(define *redis-db* (store-new))
(define *server-start-ms* (current-time-ms))
(define *redis-version* "aura-redis-0.2")

; O(n) via char list → list->string (avoids O(n²) string-append per char)
; Keep only for SET options EX/PX/NX where a real upcase string is needed.
(define (ascii-upcase s)
  (let ((n (string-length s))
        (i 0)
        (chars (list)))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (and (>= c 97) (<= c 122))
            (set! chars (cons (- c 32) chars))
            (set! chars (cons c chars)))
          (set! i (+ i 1)))))
    (list->string (reverse chars))))

; Case-insensitive compare of s against uppercase literal lit — no allocation.
; lit must be ASCII uppercase (A-Z / digits / punctuation as in command names).
(define (ascii-cmd=? s lit)
  (let ((n (string-length s))
        (m (string-length lit)))
    (if (not (= n m))
      #f
      (let ((i 0)
            (ok #t))
        (while (lambda () (and ok (< i n)))
          (lambda ()
            (let ((c (string-ref s i))
                  (u (string-ref lit i)))
              ; fold a-z → A-Z for s only
              (if (and (>= c 97) (<= c 122))
                (set! c (- c 32)))
              (if (not (= c u))
                (set! ok #f))
              (set! i (+ i 1)))))
        ok))))

(define (cmd-eq? s lit) (ascii-cmd=? s lit))

(define (arg-at args i)
  (if (>= i (length args))
    #f
    (list-ref args i)))

; cons + reverse (not append) — O(n) not O(n²)
(define (args-from args i)
  (let ((n (length args))
        (k i)
        (out (list)))
    (while (lambda () (< k n))
      (lambda ()
        (set! out (cons (list-ref args k) out))
        (set! k (+ k 1))))
    (reverse out)))

(define (wire-bulk-or-null s)
  (if s (list "bulk" s) (list "null")))

; KEYS glob: "*" all; "foo*" prefix; otherwise exact
(define (key-match? pattern key)
  (let ((plen (string-length pattern)))
    (cond
      ((string=? pattern "*") #t)
      ((and (> plen 0) (= (string-ref pattern (- plen 1)) 42))
       (let ((pre (substring pattern 0 (- plen 1)))
             (prelen (- plen 1)))
         (and (>= (string-length key) prelen)
              (string=? (substring key 0 prelen) pre))))
      (else (string=? pattern key)))))

(define (parse-set-opts args)
  ; Returns (list value expire-at-ms nx xx) — expire-at 0 means none; nx/xx are #t/#f
  ; args = (SET key value [EX sec|PX ms] [NX|XX] ...)
  (let ((val (arg-at args 2))
        (ex-ms 0)
        (nx #f)
        (xx #f)
        (i 3)
        (n (length args))
        (ok #t))
    (while (lambda () (and ok (< i n)))
      (lambda ()
        (let ((o (ascii-upcase (list-ref args i))))
          (cond
            ((string=? o "EX")
             (let ((sec (string->number (arg-at args (+ i 1)))))
               (if (number? sec)
                 (begin (set! ex-ms (* sec 1000)) (set! i (+ i 2)))
                 (set! ok #f))))
            ((string=? o "PX")
             (let ((ms (string->number (arg-at args (+ i 1)))))
               (if (number? ms)
                 (begin (set! ex-ms ms) (set! i (+ i 2)))
                 (set! ok #f))))
            ((string=? o "NX")
             (set! nx #t) (set! i (+ i 1)))
            ((string=? o "XX")
             (set! xx #t) (set! i (+ i 1)))
            (else (set! ok #f))))))
    (if (and ok (string? val))
      (list val
            (if (> ex-ms 0) (+ (current-time-ms) ex-ms) 0)
            nx xx)
      #f)))

(define (info-bulk)
  (let ((keys (store-dbsize *redis-db*))
        (uptime (quotient (- (current-time-ms) *server-start-ms*) 1000)))
    (string-append
     "# Server\r\n"
     "redis_version:" *redis-version* "\r\n"
     "aura_redis_version:" *redis-version* "\r\n"
     "tcp_port:loopback\r\n"
     "# Keyspace\r\n"
     "db0:keys=" keys "\r\n"
     "# Stats\r\n"
     "uptime_in_seconds:" uptime "\r\n")))

(define (cmd-dispatch args)
  (if (or (not (pair? args)) (= (length args) 0))
    (resp-encode-error "ERR empty command")
    (let ((cmd (car args))
          (nargs (length args)))
      (cond
        ; --- memtier hot path: GET (2 args) ---
        ((and (cmd-eq? cmd "GET") (= nargs 2))
         (let ((e (store-get *redis-db* (arg-at args 1))))
           (if (not e)
             *RESP-NULL*
             (if (string=? (hash-ref e "t" "") "string")
               (resp-encode-bulk (hash-ref e "v" ""))
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ; --- memtier hot path: SET (exactly 3 args, no opts) ---
        ((and (cmd-eq? cmd "SET") (= nargs 3))
         (store-set-string! *redis-db* (arg-at args 1) (arg-at args 2) 0)
         *RESP-OK*)

        ((cmd-eq? cmd "PING")
         (if (>= nargs 2)
           (resp-encode-bulk (arg-at args 1))
           *RESP-PONG*))

        ((cmd-eq? cmd "ECHO")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'echo'")
           (resp-encode-bulk (arg-at args 1))))

        ((cmd-eq? cmd "QUIT")
         *RESP-OK*)

        ((cmd-eq? cmd "SET")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'set'")
           (let ((opts (parse-set-opts args)))
             (if (not opts)
               (resp-encode-error "ERR syntax error")
               (let ((val (list-ref opts 0))
                     (ex (list-ref opts 1))
                     (nx (list-ref opts 2))
                     (xx (list-ref opts 3))
                     (key (arg-at args 1)))
                 (let ((exists (if (store-touch! *redis-db* key) #t #f)))
                   (cond
                     ((and nx exists) *RESP-NULL*)
                     ((and xx (not exists)) *RESP-NULL*)
                     (else
                      (store-set-string! *redis-db* key val ex)
                      *RESP-OK*))))))))

        ((cmd-eq? cmd "SETEX")
         (if (< nargs 4)
           (resp-encode-error "ERR wrong number of arguments for 'setex'")
           (let ((sec (string->number (arg-at args 2)))
                 (val (arg-at args 3))
                 (key (arg-at args 1)))
             (if (not (number? sec))
               (resp-encode-error "ERR value is not an integer or out of range")
               (begin
                 (store-set-string! *redis-db* key val (+ (current-time-ms) (* sec 1000)))
                 *RESP-OK*)))))

        ((cmd-eq? cmd "PSETEX")
         (if (< nargs 4)
           (resp-encode-error "ERR wrong number of arguments for 'psetex'")
           (let ((ms (string->number (arg-at args 2)))
                 (val (arg-at args 3))
                 (key (arg-at args 1)))
             (if (not (number? ms))
               (resp-encode-error "ERR value is not an integer or out of range")
               (begin
                 (store-set-string! *redis-db* key val (+ (current-time-ms) ms))
                 *RESP-OK*)))))

        ((cmd-eq? cmd "GET")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'get'")
           (let ((e (store-get *redis-db* (arg-at args 1))))
             (if (not e)
               *RESP-NULL*
               (if (string=? (hash-ref e "t" "") "string")
                 (resp-encode-bulk (hash-ref e "v" ""))
                 (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value"))))))

        ((cmd-eq? cmd "MGET")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'mget'")
           (let ((ks (args-from args 1))
                 (items (list)))
             (while (lambda () (pair? ks))
               (lambda ()
                 (let ((e (store-get *redis-db* (car ks))))
                   (if (and e (string=? (hash-ref e "t" "") "string"))
                     (set! items (cons (list "bulk" (hash-ref e "v" "")) items))
                     (set! items (cons (list "null") items))))
                 (set! ks (cdr ks))))
             (resp-encode-array (reverse items)))))

        ((cmd-eq? cmd "MSET")
         (if (or (< nargs 3) (= (modulo (- nargs 1) 2) 1))
           (resp-encode-error "ERR wrong number of arguments for 'mset'")
           (let ((i 1)
                 (n nargs))
             (while (lambda () (< i n))
               (lambda ()
                 (store-set-string! *redis-db* (list-ref args i) (list-ref args (+ i 1)) 0)
                 (set! i (+ i 2))))
             *RESP-OK*)))

        ((cmd-eq? cmd "APPEND")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'append'")
           (let ((n (store-append! *redis-db* (arg-at args 1) (arg-at args 2))))
             (if (number? n) (resp-encode-int n)
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ((cmd-eq? cmd "STRLEN")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'strlen'")
           (let ((n (store-strlen *redis-db* (arg-at args 1))))
             (if (number? n) (resp-encode-int n)
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ((cmd-eq? cmd "GETSET")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'getset'")
           (let ((r (store-getset! *redis-db* (arg-at args 1) (arg-at args 2))))
             (if (not (car r))
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")
               (resp-encode (wire-bulk-or-null (car (cdr r))))))))

        ((or (cmd-eq? cmd "DEL") (cmd-eq? cmd "UNLINK"))
         (if (< nargs 2)
           (resp-encode-error (string-append "ERR wrong number of arguments for '" (car args) "'"))
           (resp-encode-int (store-del! *redis-db* (args-from args 1)))))

        ((cmd-eq? cmd "EXISTS")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'exists'")
           (resp-encode-int (store-exists? *redis-db* (args-from args 1)))))

        ((cmd-eq? cmd "INCR")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'incr'")
           (let ((n (store-incr! *redis-db* (arg-at args 1) 1)))
             (if (number? n)
               (resp-encode-int n)
               (resp-encode-error "ERR value is not an integer or out of range")))))

        ((cmd-eq? cmd "DECR")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'decr'")
           (let ((n (store-incr! *redis-db* (arg-at args 1) -1)))
             (if (number? n)
               (resp-encode-int n)
               (resp-encode-error "ERR value is not an integer or out of range")))))

        ((cmd-eq? cmd "KEYS")
         (let ((pat (if (>= nargs 2) (arg-at args 1) "*"))
               (ks (store-keys *redis-db*))
               (items (list)))
           (while (lambda () (pair? ks))
             (lambda ()
               (if (key-match? pat (car ks))
                 (set! items (cons (list "bulk" (car ks)) items)))
               (set! ks (cdr ks))))
           (resp-encode-array (reverse items))))

        ((cmd-eq? cmd "DBSIZE")
         (resp-encode-int (store-dbsize *redis-db*)))

        ((cmd-eq? cmd "INFO")
         (resp-encode-bulk (info-bulk)))

        ((cmd-eq? cmd "RENAME")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'rename'")
           (let ((r (store-rename! *redis-db* (arg-at args 1) (arg-at args 2) #f)))
             (cond
               ((string=? r "missing")
                (resp-encode-error "ERR no such key"))
               (else *RESP-OK*)))))

        ((cmd-eq? cmd "RENAMENX")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'renamenx'")
           (let ((r (store-rename! *redis-db* (arg-at args 1) (arg-at args 2) #t)))
             (cond
               ((string=? r "missing")
                (resp-encode-error "ERR no such key"))
               ((string=? r "busy") *RESP-ZERO*)
               ((string=? r "same") *RESP-ONE*)
               (else *RESP-ONE*)))))

        ((cmd-eq? cmd "FLUSHDB")
         ; O(1): drop the whole table instead of per-key remove (O(n) or worse)
         (set! *redis-db* (store-new))
         *RESP-OK*)

        ((cmd-eq? cmd "TYPE")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'type'")
           (resp-encode-simple (store-type *redis-db* (arg-at args 1)))))

        ((cmd-eq? cmd "TTL")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'ttl'")
           (resp-encode-int (store-ttl *redis-db* (arg-at args 1)))))

        ((cmd-eq? cmd "EXPIRE")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'expire'")
           (let ((sec (string->number (arg-at args 2))))
             (if (not (number? sec))
               (resp-encode-error "ERR value is not an integer or out of range")
               (resp-encode-int (store-expire! *redis-db* (arg-at args 1) sec))))))

        ((cmd-eq? cmd "LPUSH")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'lpush'")
           (let ((n (store-list-push! *redis-db* (arg-at args 1) (arg-at args 2) #t)))
             (if (number? n) (resp-encode-int n)
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ((cmd-eq? cmd "RPUSH")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'rpush'")
           (let ((n (store-list-push! *redis-db* (arg-at args 1) (arg-at args 2) #f)))
             (if (number? n) (resp-encode-int n)
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ((cmd-eq? cmd "LPOP")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'lpop'")
           (resp-encode (wire-bulk-or-null (store-list-pop! *redis-db* (arg-at args 1) #t)))))

        ((cmd-eq? cmd "RPOP")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'rpop'")
           (resp-encode (wire-bulk-or-null (store-list-pop! *redis-db* (arg-at args 1) #f)))))

        ((cmd-eq? cmd "LLEN")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'llen'")
           (resp-encode-int (store-list-len *redis-db* (arg-at args 1)))))

        ((cmd-eq? cmd "HSET")
         (if (< nargs 4)
           (resp-encode-error "ERR wrong number of arguments for 'hset'")
           (let ((n (store-hash-set! *redis-db* (arg-at args 1) (arg-at args 2) (arg-at args 3))))
             (if (number? n) (resp-encode-int n)
               (resp-encode-error "WRONGTYPE Operation against a key holding the wrong kind of value")))))

        ((cmd-eq? cmd "HGET")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'hget'")
           (resp-encode (wire-bulk-or-null (store-hash-get *redis-db* (arg-at args 1) (arg-at args 2))))))

        ((cmd-eq? cmd "HDEL")
         (if (< nargs 3)
           (resp-encode-error "ERR wrong number of arguments for 'hdel'")
           (resp-encode-int (store-hash-del! *redis-db* (arg-at args 1) (args-from args 2)))))

        ((cmd-eq? cmd "HGETALL")
         (if (< nargs 2)
           (resp-encode-error "ERR wrong number of arguments for 'hgetall'")
           (let ((pairs (store-hash-getall *redis-db* (arg-at args 1)))
                 (items (list)))
             (while (lambda () (pair? pairs))
               (lambda ()
                 (set! items (cons (list "bulk" (car pairs)) items))
                 (set! pairs (cdr pairs))))
             (resp-encode-array (reverse items)))))

        (else
         (resp-encode-error (string-append "ERR unknown command '" (car args) "'")))))))
